<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <%- include('partials/head') %>
</head>

<body class="bg-background-light dark:bg-background-dark min-h-screen">
    <div class="layout-container flex h-full grow flex-col">
        <%- include('partials/header') %>
            <main class="flex flex-1 justify-center py-12 px-4 md:px-10">
                <div class="layout-content-container flex flex-col max-w-[800px] flex-1">
                    <div class="bg-white/5 border border-white/10 p-8 rounded-sm shadow-xl relative overflow-hidden">
                        <span
                            class="material-symbols-outlined text-8xl absolute -right-4 -bottom-4 text-amber-yellow/10 pointer-events-none">palette</span>

                        <div class="text-center mb-8">
                            <h1 class="text-3xl lg:text-4xl font-black font-mono-header text-amber-yellow mb-2">Become
                                an Artist</h1>
                            <p class="text-white/60 font-mono">Join our community and share your cultural heritage with
                                the world.</p>
                        </div>

                        <form action="/become-artist" method="POST" class="space-y-6 relative z-10">
                            <!-- CSRF Token -->
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                            <div class="space-y-2">
                                <label class="text-white font-bold font-mono tracking-wide text-sm">Artist / Brand Name
                                    (Optional)</label>
                                <input name="name" type="text"
                                    placeholder="Display name (Defaults to your account name)"
                                    class="w-full h-12 bg-black/20 border border-white/20 rounded px-4 text-white placeholder-white/40 focus:outline-none focus:border-amber-yellow focus:ring-1 focus:ring-amber-yellow transition-colors font-mono" />
                            </div>

                            <div class="space-y-2">
                                <label class="text-white font-bold font-mono tracking-wide text-sm">Biography *</label>
                                <textarea name="bio" required rows="4"
                                    placeholder="Tell us about yourself and your background..."
                                    class="w-full bg-black/20 border border-white/20 rounded p-4 text-white placeholder-white/40 focus:outline-none focus:border-amber-yellow focus:ring-1 focus:ring-amber-yellow transition-colors font-mono resize-none"></textarea>
                            </div>

                            <div class="space-y-2">
                                <label class="text-white font-bold font-mono tracking-wide text-sm">Inspiration Behind
                                    Your Art *</label>
                                <textarea name="inspiration" required rows="3"
                                    placeholder="What drives you to create? What cultural elements inspire you?"
                                    class="w-full bg-black/20 border border-white/20 rounded p-4 text-white placeholder-white/40 focus:outline-none focus:border-amber-yellow focus:ring-1 focus:ring-amber-yellow transition-colors font-mono resize-none"></textarea>
                            </div>

                            <div class="space-y-2">
                                <label class="text-white font-bold font-mono tracking-wide text-sm">Life Story
                                    (Optional)</label>
                                <textarea name="lifeStory" rows="4"
                                    placeholder="Share any personal journey that shaped your art..."
                                    class="w-full bg-black/20 border border-white/20 rounded p-4 text-white placeholder-white/40 focus:outline-none focus:border-amber-yellow focus:ring-1 focus:ring-amber-yellow transition-colors font-mono resize-none"></textarea>
                            </div>

                            <div class="space-y-2">
                                <label class="text-white font-bold font-mono tracking-wide text-sm">Portfolio or Sample
                                    Work Link *</label>
                                <input name="portfolioUrl" required type="url"
                                    placeholder="https://yourportfolio.com or social media link"
                                    class="w-full h-12 bg-black/20 border border-white/20 rounded px-4 text-white placeholder-white/40 focus:outline-none focus:border-amber-yellow focus:ring-1 focus:ring-amber-yellow transition-colors font-mono" />
                            </div>

                            <button type="submit"
                                class="w-full h-14 bg-amber-yellow text-background-dark font-mono-header uppercase font-bold tracking-[0.15em] hover:bg-white text-lg rounded-sm shadow-[0_0_20px_rgba(242,185,13,0.3)] transition-all">
                                Submit Application
                            </button>
                        </form>
                    </div>
                </div>
            </main>
    </div>
</body>

</html>