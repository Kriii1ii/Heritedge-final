<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <%- include('partials/head') %>
    <title>Join as an Artist — HeritEdge</title>
    <style>
        .ba-input {
            width: 100%; background: white; border: 1px solid #e2dfdb;
            border-radius: 4px; padding: 0 1rem; height: 3rem;
            color: #2a241f; font-size: 14px;
            transition: border-color 0.15s, box-shadow 0.15s;
        }
        .ba-input:focus { outline: none; border-color: #4e0f11; box-shadow: 0 0 0 2px rgba(78,15,17,0.12); }
        .ba-textarea {
            width: 100%; background: white; border: 1px solid #e2dfdb;
            border-radius: 4px; padding: 0.875rem 1rem; resize: none;
            color: #2a241f; font-size: 14px; line-height: 1.65;
            transition: border-color 0.15s, box-shadow 0.15s;
        }
        .ba-textarea:focus { outline: none; border-color: #4e0f11; box-shadow: 0 0 0 2px rgba(78,15,17,0.12); }
        .ba-label { color: #3c3731; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 6px; display: block; }
        .ba-checkbox-label { display: flex; align-items: center; gap: 10px; cursor: pointer; padding: 8px 12px; border-radius: 6px; border: 1px solid #e2dfdb; font-size: 13px; color: #2a241f; font-weight: 600; transition: background 0.12s, border-color 0.12s; }
        .ba-checkbox-label:has(input:checked) { background: rgba(78,15,17,0.06); border-color: #4e0f11; color: #4e0f11; }
        .ba-checkbox-label input { accent-color: #4e0f11; width: 15px; height: 15px; }
        .char-counter { font-size: 11px; color: #9ca3af; text-align: right; margin-top: 4px; }
        .char-counter.warn { color: #d97706; }
        .char-counter.ok { color: #059669; }
        .custom-scrollbar::-webkit-scrollbar { width: 5px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(78,15,17,0.2); border-radius: 3px; }
    </style>
</head>

<body class="bg-white min-h-screen font-sans">
<div class="flex flex-col h-screen overflow-hidden">
    <%- include('partials/header') %>
    <main class="flex flex-row flex-1 overflow-hidden w-full">

        <!-- ── LEFT PANEL ── -->
        <section class="hidden md:flex flex-col relative w-5/12 lg:w-1/2 h-full justify-end p-12 lg:p-20 shadow-xl z-10"
                 style="background-image: linear-gradient(to right, rgba(80,20,10,0.5), rgba(40,10,5,0.75)), url('/images/front_page_bg_4.jpg'); background-size: cover; background-position: center; background-color: #61211b;">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></div>
            <div class="relative z-20 flex flex-col max-w-lg mb-8">
                <span class="material-symbols-outlined text-[#facc15] text-[52px] leading-none mb-5" style="font-variation-settings:'FILL' 1;">format_quote</span>
                <h1 class="text-white text-[3rem] lg:text-[3.6rem] font-bold leading-[1.05] tracking-tight mb-7 drop-shadow-lg">
                    Join the<br>Creator<br>Community
                </h1>
                <p class="text-white/90 text-[1.05rem] lg:text-[1.15rem] italic font-medium leading-[1.65] drop-shadow-md mb-8">
                    "HeritEdge gave me the platform to turn my passion into a livelihood, celebrating our roots through digital strokes."
                </p>
                <div>
                    <span class="text-[#facc15] font-bold text-[1.05rem] drop-shadow-md">Apsara Gurung</span>
                    <p class="text-white/70 text-[0.75rem] tracking-widest uppercase font-semibold mt-0.5 drop-shadow-md">Digital Illustrator · Kathmandu</p>
                </div>
            </div>
        </section>

        <!-- ── RIGHT PANEL ── -->
        <section class="flex flex-col w-full md:w-7/12 lg:w-1/2 h-full bg-[#fdfdfc] overflow-y-auto custom-scrollbar">
            <div class="flex flex-col w-full max-w-[600px] mx-auto px-8 py-10 lg:px-14 lg:py-16 relative">
                <div class="absolute top-0 right-0 w-28 h-28 bg-gray-100/50 hidden lg:block"></div>

                <%
                  const _appStatus = typeof applicationStatus !== 'undefined' ? applicationStatus : null;
                  const _hasApplied = typeof hasApplied !== 'undefined' ? hasApplied : false;
                  const _app = typeof application !== 'undefined' ? application : null;
                  const _formErr = typeof formError !== 'undefined' ? formError : null;
                  const _fd = typeof formData !== 'undefined' ? formData : null;
                  const _u = typeof user !== 'undefined' ? user : {};
                  const _selTypes = _fd ? (Array.isArray(_fd.artTypes) ? _fd.artTypes : (_fd.artTypes ? [_fd.artTypes] : [])) : [];
                %>

                <% if (_appStatus === 'APPROVED') { %>
                    <!-- ── APPROVED STATE ── -->
                    <div class="flex flex-col items-center justify-center flex-1 text-center gap-7 py-12 relative z-10">
                        <div class="w-24 h-24 rounded-full bg-green-50 border-2 border-green-200 flex items-center justify-center">
                            <span class="material-symbols-outlined text-green-600 text-[52px]" style="font-variation-settings:'FILL' 1;">verified</span>
                        </div>
                        <div>
                            <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-green-50 border border-green-200 rounded-full mb-4">
                                <span class="w-2 h-2 rounded-full bg-green-500"></span>
                                <span class="text-green-700 text-[11px] font-bold uppercase tracking-widest">Application Approved</span>
                            </div>
                            <h2 class="text-[#4e0f11] text-[1.8rem] font-bold mb-3 leading-tight">Welcome to HeritEdge!</h2>
                            <p class="text-gray-500 text-[15px] leading-relaxed max-w-[380px] mx-auto">
                                Congratulations — your application was approved. You're now a HeritEdge Creator. Start sharing your art with the world.
                            </p>
                        </div>
                        <div class="w-full max-w-[300px] flex flex-col gap-3">
                            <a href="/creator/home"
                               class="w-full h-[48px] flex items-center justify-center gap-2 bg-[#4e0f11] text-[#facc15] font-bold text-sm rounded-[4px] hover:bg-[#3d0b0c] transition-colors">
                                <span class="material-symbols-outlined text-[16px]">dashboard</span>
                                Go to Creator Dashboard
                            </a>
                            <a href="/marketplace"
                               class="w-full h-[48px] flex items-center justify-center gap-2 bg-white border border-[#e2dfdb] text-[#4e0f11] font-bold text-sm rounded-[4px] hover:bg-gray-50 transition-colors">
                                <span class="material-symbols-outlined text-[16px]">storefront</span>
                                Browse Marketplace
                            </a>
                        </div>
                    </div>

                <% } else if (_appStatus === 'PENDING') { %>
                    <!-- ── PENDING STATE ── -->
                    <div class="flex flex-col items-center justify-center flex-1 text-center gap-7 py-12 relative z-10">
                        <div class="w-24 h-24 rounded-full bg-amber-50 border-2 border-amber-200 flex items-center justify-center">
                            <span class="material-symbols-outlined text-amber-600 text-[52px]" style="font-variation-settings:'FILL' 1;">pending_actions</span>
                        </div>
                        <div>
                            <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-amber-50 border border-amber-200 rounded-full mb-4">
                                <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                                <span class="text-amber-700 text-[11px] font-bold uppercase tracking-widest">Under Review</span>
                            </div>
                            <h2 class="text-[#4e0f11] text-[1.8rem] font-bold mb-3 leading-tight">Application Submitted!</h2>
                            <p class="text-gray-500 text-[15px] leading-relaxed max-w-[380px] mx-auto">
                                Our team is reviewing your application. We'll notify you once a decision is made — usually within 1–3 business days.
                            </p>
                            <% if (_app && _app.createdAt) { %>
                                <p class="text-gray-400 text-[12px] mt-3">
                                    Submitted on <%= new Date(_app.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>
                                </p>
                            <% } %>
                        </div>
                        <div class="w-full max-w-[300px] flex flex-col gap-3">
                            <a href="/profile"
                               class="w-full h-[48px] flex items-center justify-center gap-2 bg-[#4e0f11] text-[#facc15] font-bold text-sm rounded-[4px] hover:bg-[#3d0b0c] transition-colors">
                                <span class="material-symbols-outlined text-[16px]">person</span>
                                View Profile
                            </a>
                            <a href="/marketplace"
                               class="w-full h-[48px] flex items-center justify-center gap-2 bg-white border border-[#e2dfdb] text-[#4e0f11] font-bold text-sm rounded-[4px] hover:bg-gray-50 transition-colors">
                                <span class="material-symbols-outlined text-[16px]">storefront</span>
                                Browse Marketplace
                            </a>
                        </div>
                        <p class="text-gray-400 text-xs max-w-[320px]">
                            Questions? Reach us at <a href="mailto:hello@heritedge.com" class="text-[#4e0f11] font-semibold underline underline-offset-2">hello@heritedge.com</a>
                        </p>
                    </div>

                <% } else { %>
                    <!-- ── APPLICATION FORM ── -->
                    <div class="relative z-10">

                        <!-- Rejection notice -->
                        <% if (_appStatus === 'REJECTED') { %>
                            <div class="flex gap-3 p-4 bg-red-50 border border-red-200 rounded-lg mb-7">
                                <span class="material-symbols-outlined text-red-500 text-[20px] flex-shrink-0 mt-0.5" style="font-variation-settings:'FILL' 1;">cancel</span>
                                <div>
                                    <p class="text-red-700 font-bold text-sm mb-0.5">Previous application not approved</p>
                                    <% if (_app && _app.adminNote) { %>
                                        <p class="text-red-600/80 text-xs leading-relaxed">Admin note: "<%= _app.adminNote %>"</p>
                                    <% } else { %>
                                        <p class="text-red-600/80 text-xs leading-relaxed">You may reapply after reviewing our creator guidelines.</p>
                                    <% } %>
                                </div>
                            </div>
                        <% } %>

                        <!-- Form error -->
                        <% if (_formErr) { %>
                            <div class="flex gap-3 p-4 bg-red-50 border border-red-200 rounded-lg mb-7">
                                <span class="material-symbols-outlined text-red-500 text-[18px] flex-shrink-0 mt-0.5">error</span>
                                <p class="text-red-700 text-sm font-semibold"><%= _formErr %></p>
                            </div>
                        <% } %>

                        <!-- Heading -->
                        <div class="mb-8">
                            <h2 class="text-[#4e0f11] text-[1.9rem] font-bold mb-2 leading-tight">Artist Application</h2>
                            <p class="text-gray-500 text-[14px] leading-relaxed">
                                Tell us about your craft. All fields marked <span class="text-red-500 font-bold">*</span> are required.
                            </p>
                        </div>

                        <!-- Form -->
                        <form id="ba-form" action="/become-artist" method="POST" enctype="multipart/form-data" class="flex flex-col gap-6" onsubmit="return validateBAForm()">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                            <!-- Name + Email row -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="ba-label">Full Name <span class="text-red-500">*</span></label>
                                    <input name="name" type="text" class="ba-input" placeholder="Your full name" required
                                           value="<%= _fd ? (_fd.name || '') : (_u.name || '') %>">
                                </div>
                                <div>
                                    <label class="ba-label">Email <span class="text-red-500">*</span></label>
                                    <input name="email" type="email" class="ba-input" placeholder="your@email.com" required
                                           value="<%= _fd ? (_fd.email || '') : (_u.email || '') %>">
                                </div>
                            </div>

                            <!-- Age -->
                            <div class="max-w-[180px]">
                                <label class="ba-label">Age <span class="text-red-500">*</span></label>
                                <input name="age" type="number" min="16" max="100" class="ba-input" placeholder="e.g. 27" required
                                       value="<%= _fd ? (_fd.age || '') : '' %>">
                                <p class="text-gray-400 text-[11px] mt-1.5">Must be 16 or older</p>
                            </div>

                            <!-- Art Types -->
                            <div>
                                <label class="ba-label">Types of Art <span class="text-red-500">*</span> <span class="text-gray-400 font-normal normal-case">(select all that apply)</span></label>
                                <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 mt-1" id="arttype-grid">
                                    <%
                                      const _artTypeOptions = ['Thangka','Digital','Traditional','Abstract','Sculpture','Pottery','Photography','Textile','Other'];
                                    %>
                                    <% _artTypeOptions.forEach(function(t) { %>
                                        <label class="ba-checkbox-label">
                                            <input type="checkbox" name="artTypes" value="<%= t %>"
                                                <%= _selTypes.includes(t) ? 'checked' : '' %>>
                                            <%= t %>
                                        </label>
                                    <% }) %>
                                </div>
                                <p id="arttype-err" class="hidden text-red-500 text-xs mt-1.5">Please select at least one art type.</p>
                            </div>

                            <!-- About -->
                            <div>
                                <label class="ba-label">About You <span class="text-red-500">*</span></label>
                                <textarea name="about" id="about-ta" rows="4" class="ba-textarea" required
                                          placeholder="Describe your artistic background and connection to heritage art (min. 50 characters)..."
                                          oninput="updateCounter('about-ta','about-counter',50)"
                                ><%= _fd ? (_fd.about || '') : '' %></textarea>
                                <div class="flex justify-between items-center mt-1">
                                    <p class="text-gray-400 text-[11px]">Minimum 50 characters</p>
                                    <span id="about-counter" class="char-counter">0 / 50+</span>
                                </div>
                            </div>

                            <!-- Motivation -->
                            <div>
                                <label class="ba-label">Why do you want to join? <span class="text-red-500">*</span></label>
                                <textarea name="motivation" id="motivation-ta" rows="5" class="ba-textarea" required
                                          placeholder="Share your passion and what you hope to achieve as a HeritEdge creator (min. 100 characters)..."
                                          oninput="updateCounter('motivation-ta','motivation-counter',100)"
                                ><%= _fd ? (_fd.motivation || '') : '' %></textarea>
                                <div class="flex justify-between items-center mt-1">
                                    <p class="text-gray-400 text-[11px]">Minimum 100 characters</p>
                                    <span id="motivation-counter" class="char-counter">0 / 100+</span>
                                </div>
                            </div>

                            <!-- Portfolio URL (optional) -->
                            <div>
                                <label class="ba-label">Portfolio / Website <span class="text-gray-400 font-normal normal-case">(optional)</span></label>
                                <input name="portfolio" type="url" class="ba-input" placeholder="https://behance.net/yourname"
                                       value="<%= _fd ? (_fd.portfolio || '') : '' %>">
                            </div>

                            <!-- Social Links (optional) -->
                            <div>
                                <label class="ba-label">Social Links <span class="text-gray-400 font-normal normal-case">(optional)</span></label>
                                <textarea name="socialLinks" rows="2" class="ba-textarea"
                                          placeholder="Instagram, Facebook, etc. — one per line"><%= _fd ? (_fd.socialLinks || '') : '' %></textarea>
                                <p class="text-gray-400 text-[11px] mt-1.5">One URL per line, or comma-separated</p>
                            </div>

                            <!-- Profile Image (optional) -->
                            <div>
                                <label class="ba-label">Profile Photo <span class="text-gray-400 font-normal normal-case">(optional, max 5MB)</span></label>
                                <div class="flex items-center gap-4">
                                    <div id="img-preview-wrap" class="w-16 h-16 rounded-lg border-2 border-dashed border-[#e2dfdb] flex items-center justify-center bg-gray-50 overflow-hidden flex-shrink-0">
                                        <span class="material-symbols-outlined text-gray-300 text-[28px]" id="img-placeholder">photo_camera</span>
                                        <img id="img-preview" src="" class="hidden w-full h-full object-cover">
                                    </div>
                                    <div class="flex-1">
                                        <label class="cursor-pointer inline-flex items-center gap-2 px-4 py-2.5 bg-white border border-[#e2dfdb] rounded-[4px] text-[#4e0f11] text-sm font-bold hover:bg-gray-50 transition-colors">
                                            <span class="material-symbols-outlined text-[16px]">upload</span>
                                            Choose Photo
                                            <input type="file" name="profileImage" accept="image/*" class="hidden" onchange="previewBAImg(this)">
                                        </label>
                                        <p class="text-gray-400 text-[11px] mt-1.5">JPG, PNG, or WebP</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Submit -->
                            <div class="pt-2">
                                <button type="submit"
                                    class="w-full h-[52px] bg-[#4e0f11] text-[#facc15] font-bold text-[14px] tracking-[0.08em] rounded-[4px] shadow-sm hover:bg-[#3d0b0c] transition-colors flex items-center justify-center gap-2 group">
                                    SUBMIT APPLICATION
                                    <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">send</span>
                                </button>
                                <p class="text-center text-gray-400 text-[10px] mt-3">
                                    By applying, you agree to HeritEdge's
                                    <a href="#" class="underline underline-offset-2 decoration-gray-300">Artist Terms</a> &amp;
                                    <a href="#" class="underline underline-offset-2 decoration-gray-300">Creator Guidelines</a>.
                                </p>
                            </div>
                        </form>
                    </div>
                <% } %>

            </div>
        </section>
    </main>
    <%- include('partials/footer') %>
</div>

<script>
    function updateCounter(taId, counterId, min) {
        const ta = document.getElementById(taId);
        const counter = document.getElementById(counterId);
        if (!ta || !counter) return;
        const len = ta.value.trim().length;
        counter.textContent = len + ' / ' + min + '+';
        counter.className = 'char-counter' + (len >= min ? ' ok' : (len > min * 0.7 ? ' warn' : ''));
    }

    function previewBAImg(input) {
        if (!input.files || !input.files[0]) return;
        if (input.files[0].size > 5 * 1024 * 1024) {
            alert('Image must be under 5MB.');
            input.value = '';
            return;
        }
        const reader = new FileReader();
        reader.onload = e => {
            const placeholder = document.getElementById('img-placeholder');
            const preview = document.getElementById('img-preview');
            if (placeholder) placeholder.classList.add('hidden');
            if (preview) { preview.src = e.target.result; preview.classList.remove('hidden'); }
        };
        reader.readAsDataURL(input.files[0]);
    }

    function validateBAForm() {
        // Check at least one art type
        const checked = document.querySelectorAll('input[name="artTypes"]:checked');
        const errEl = document.getElementById('arttype-err');
        if (checked.length === 0) {
            if (errEl) errEl.classList.remove('hidden');
            document.getElementById('arttype-grid')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return false;
        }
        if (errEl) errEl.classList.add('hidden');

        // Check about min length
        const about = document.getElementById('about-ta');
        if (about && about.value.trim().length < 50) {
            about.focus();
            about.style.borderColor = '#ef4444';
            setTimeout(() => about.style.borderColor = '', 2000);
            return false;
        }

        // Check motivation min length
        const motiv = document.getElementById('motivation-ta');
        if (motiv && motiv.value.trim().length < 100) {
            motiv.focus();
            motiv.style.borderColor = '#ef4444';
            setTimeout(() => motiv.style.borderColor = '', 2000);
            return false;
        }

        return true;
    }

    // Initialize char counters
    document.addEventListener('DOMContentLoaded', () => {
        updateCounter('about-ta', 'about-counter', 50);
        updateCounter('motivation-ta', 'motivation-counter', 100);
    });
</script>
</body>
</html>
