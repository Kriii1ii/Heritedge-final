<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <%- include('partials/head') %>
</head>

<body class="bg-background-light dark:bg-background-dark min-h-screen">
    <div class="layout-container flex h-full grow flex-col">
        <%- include('partials/header') %>
            <main class="flex flex-1 justify-center py-12 px-4 md:px-10 items-center min-h-[60vh]">
                <div
                    class="layout-content-container flex flex-col items-center justify-center text-center max-w-[600px] flex-1 bg-white/5 border border-red-500/20 rounded-sm p-12 shadow-2xl relative overflow-hidden">
                    <span
                        class="material-symbols-outlined text-9xl absolute -right-4 -bottom-4 text-red-500/10 pointer-events-none">error</span>

                    <div class="h-24 w-24 rounded-full bg-red-500/10 grid place-items-center mb-6">
                        <span class="material-symbols-outlined text-5xl text-red-500 shadow-sm">warning</span>
                    </div>

                    <h1
                        class="text-white text-3xl md:text-5xl font-black leading-tight font-mono-header bg-gradient-to-r from-red-500 to-amber-yellow bg-clip-text text-transparent mb-4">
                        Oops!</h1>
                    <p class="text-white/80 text-lg mb-8 font-mono">
                        <%= message || 'Something went wrong.' %>
                    </p>

                    <div class="flex gap-4">
                        <a href="/"
                            class="bg-white/10 hover:bg-white/20 text-white font-bold py-3 px-8 rounded border border-white/10 transition-colors uppercase tracking-[0.1em] text-sm">Go
                            Home</a>
                        <button onclick="window.history.back()"
                            class="bg-amber-yellow text-background-dark hover:bg-white font-bold py-3 px-8 rounded transition-colors uppercase tracking-[0.1em] text-sm shadow">Go
                            Back</button>
                    </div>
                </div>
            </main>
                <%- include('partials/footer') %>
</div>
</body>

</html>