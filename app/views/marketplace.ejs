<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <%- include('partials/head') %>
</head>

<body class="bg-background-light dark:bg-background-dark text-white">
    <div class="relative flex h-auto min-h-screen w-full flex-col overflow-x-hidden">
        <%- include('partials/header') %>

            <main class="flex flex-col flex-1 px-4 md:px-20 py-12">
                <div class="max-w-[1200px] mx-auto w-full">
                    <h1 class="text-3xl font-bold font-mono-header border-l-4 border-amber-yellow pl-4 mb-2">Digital Art
                        Marketplace</h1>
                    <p class="text-white/60 text-sm mb-10 tracking-widest uppercase font-mono-header">Discover & Buy
                        Authentique Nepali Art</p>

                    <% if (artworks && artworks.length> 0) { %>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
                            <% artworks.forEach(art=> { %>
                                <div
                                    class="group flex flex-col gap-4 bg-deep-maroon/20 p-4 rounded-xl border border-rich-red/30 hover:border-amber-yellow transition-all shadow-lg hover:shadow-amber-yellow/10">
                                    <div
                                        class="w-full bg-center bg-no-repeat aspect-square bg-cover rounded-lg overflow-hidden border border-rich-red/50 relative">
                                        <img src="<%= art.image %>"
                                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                                            onerror="this.src='https://lh3.googleusercontent.com/aida-public/AB6AXuDy-KeotEQn3Frd-pR0hgkCVPMpmAs5GWvCTmujmyirYN9ICN4ZIRhir6aw4PRzYTDbKAkEkGaEPN6Xs6sH0Qq_l6WeY1Gt05Qy1XitTYmFUBKMbPPWusfdJ1Ho8GeYWHZDPB8o7ilwE90faR4-_apKoJ0aR00OYusEh004o7vK14MowAh1BSSTozH0P3PLKlbGGNnuINmRr_yktTXhx7Tof4mLGFre6Lild4Qtwq78TYjQy9HXoXlpVBNohyUevhtMw2fEYKmcqZs'" />
                                        <div
                                            class="absolute top-2 right-2 bg-black/60 backdrop-blur text-white text-[10px] font-bold px-2 py-1 rounded uppercase tracking-wider border border-white/20">
                                            <%= art.category || 'Art' %>
                                        </div>
                                    </div>
                                    <div class="space-y-2 flex-grow">
                                        <h3
                                            class="text-white text-lg font-bold font-mono-header leading-tight truncate">
                                            <%= art.title %>
                                        </h3>
                                        <p class="text-amber-yellow font-medium text-lg font-mono tracking-tight">रू <%=
                                                art.price %>
                                        </p>
                                        <a href="/artist/<%= art.artistId %>"
                                            class="text-dusty-rose text-xs font-bold uppercase tracking-wider hover:underline flex items-center gap-1 group/author">
                                            <span class="material-symbols-outlined text-[14px]">brush</span>
                                            <%= art.artistName %>
                                        </a>
                                        <p class="text-white/60 text-sm line-clamp-2 italic pt-2">
                                            <%= art.desc %>
                                        </p>
                                    </div>
                                    <button
                                        class="w-full py-3 bg-amber-yellow/10 hover:bg-amber-yellow text-amber-yellow hover:text-black mt-2 font-bold rounded-lg text-sm font-mono-header transition-all border border-amber-yellow/30 uppercase tracking-widest">Buy
                                        Now</button>
                                </div>
                                <% }); %>
                        </div>
                        <% } else { %>
                            <div
                                class="flex flex-col items-center justify-center p-20 border border-white/10 rounded-2xl bg-white/5 backdrop-blur-sm text-center">
                                <span class="material-symbols-outlined text-6xl text-white/20 mb-4">palette</span>
                                <h2 class="text-xl font-bold font-mono text-white/80">No Artworks Found</h2>
                                <p class="text-sm text-white/50 mt-2">Check back later or register as an artist to post
                                    your own creations.</p>
                            </div>
                            <% } %>
                </div>
            </main>
    </div>
</body>

</html>