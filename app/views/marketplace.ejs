<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <%- include('partials/head') %>
    <style>
        /* Dual range slider */
        .price-range {
            -webkit-appearance: none;
            appearance: none;
            position: absolute;
            width: 100%;
            height: 4px;
            top: 0;
            left: 0;
            background: transparent;
            pointer-events: none;
            outline: none;
            margin: 0;
            padding: 0;
        }
        .price-range::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #f2b90d;
            border: 3px solid #230f08;
            pointer-events: all;
            cursor: grab;
            box-shadow: 0 2px 8px rgba(0,0,0,0.5);
            transition: transform 0.15s, box-shadow 0.15s;
            position: relative;
            z-index: 3;
        }
        .price-range::-webkit-slider-thumb:hover {
            transform: scale(1.15);
            box-shadow: 0 2px 12px rgba(242,185,13,0.4);
        }
        .price-range::-webkit-slider-thumb:active {
            cursor: grabbing;
        }
        .price-range::-moz-range-thumb {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #f2b90d;
            border: 3px solid #230f08;
            pointer-events: all;
            cursor: grab;
            box-shadow: 0 2px 8px rgba(0,0,0,0.5);
        }

        /* Artwork card */
        .art-card {
            transition: transform 0.25s cubic-bezier(0.4,0,0.2,1), box-shadow 0.25s cubic-bezier(0.4,0,0.2,1), border-color 0.2s;
        }
        .art-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.4), 0 0 0 1px rgba(242,185,13,0.15);
        }

        /* Filter sidebar */
        #filter-sidebar {
            transition: transform 0.3s cubic-bezier(0.4,0,0.2,1);
        }

        @media (max-width: 1024px) {
            #filter-sidebar.open {
                transform: translateX(0);
            }
        }

        /* Category pill active */
        .cat-pill.active {
            background: #f2b90d;
            color: #230f08;
            border-color: #f2b90d;
        }
    </style>
</head>

<body class="bg-background-dark text-white min-h-screen">
    <div class="relative flex min-h-screen w-full flex-col overflow-x-hidden">
        <%- include('partials/header') %>

        <!-- Pass auth state to JS -->
        <script>
            const __currentUser = <%- JSON.stringify(user ? { role: user.role, id: user.id } : null) %>;
            function requireAuth(artworkId) {
                if (!__currentUser) {
                    window.location.href = '/login?redirect=' + encodeURIComponent('/artwork/' + artworkId);
                    return false;
                }
                if (__currentUser.role === 'CREATOR') {
                    showToast('Creators cannot purchase artworks');
                    return false;
                }
                return true;
            }
            function showToast(msg) {
                let t = document.getElementById('toast');
                if (!t) {
                    t = document.createElement('div');
                    t.id = 'toast';
                    t.className = 'fixed bottom-6 left-1/2 -translate-x-1/2 z-[300] bg-deep-maroon border border-amber-yellow/40 text-white text-sm font-semibold px-6 py-3 rounded-xl shadow-2xl transition-all duration-300 opacity-0 pointer-events-none';
                    document.body.appendChild(t);
                }
                t.textContent = msg;
                t.classList.remove('opacity-0');
                t.classList.add('opacity-100');
                setTimeout(() => { t.classList.remove('opacity-100'); t.classList.add('opacity-0'); }, 3000);
            }
        </script>

        <main class="flex flex-1 flex-col lg:flex-row gap-0 max-w-[1400px] mx-auto w-full px-0 lg:px-6 py-0 lg:py-8">

            <!-- ── FILTER SIDEBAR ── -->
            <aside id="filter-sidebar"
                class="w-full lg:w-[280px] xl:w-[300px] shrink-0 bg-background-dark lg:bg-transparent border-b lg:border-b-0 lg:border-r border-white/8 lg:sticky lg:top-[88px] lg:self-start lg:max-h-[calc(100vh-100px)] lg:overflow-y-auto px-5 lg:px-0 lg:pr-6 pb-6 pt-5 lg:pt-0">

                <form id="filter-form" action="/marketplace" method="GET">
                    <!-- Preserve search query -->
                    <% if (query.q) { %><input type="hidden" name="q" value="<%= query.q %>"><% } %>

                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-white font-bold text-lg font-mono-header">Filters</h2>
                        <% if (query.minPrice || query.maxPrice || query.category) { %>
                            <a href="/marketplace<%= query.q ? '?q=' + query.q : '' %>"
                                class="text-amber-yellow text-xs font-bold hover:underline uppercase tracking-wider">Clear All</a>
                        <% } %>
                    </div>

                    <!-- Sort -->
                    <div class="mb-7">
                        <label class="text-white/50 font-bold text-xs uppercase tracking-[0.12em] block mb-3">Sort By</label>
                        <div class="relative">
                            <select name="sort" onchange="document.getElementById('filter-form').submit()"
                                class="w-full bg-white/6 border border-white/15 rounded-lg px-4 py-2.5 text-white text-sm font-medium appearance-none focus:outline-none focus:border-amber-yellow transition-colors cursor-pointer">
                                <option value="" <%= !query.sort ? 'selected' : '' %>>Featured</option>
                                <option value="newest" <%= query.sort === 'newest' ? 'selected' : '' %>>Newest First</option>
                                <option value="price_asc" <%= query.sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
                                <option value="price_desc" <%= query.sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-white/40 text-[18px] pointer-events-none">expand_more</span>
                        </div>
                    </div>

                    <!-- Category -->
                    <div class="mb-7">
                        <label class="text-white/50 font-bold text-xs uppercase tracking-[0.12em] block mb-3">Category</label>
                        <div class="flex flex-wrap gap-2">
                            <% const categories = ['Thangka', 'Pottery', 'Textile', 'Painting', 'Sculpture', 'Jewelry', 'Woodcraft']; %>
                            <button type="button"
                                onclick="setCat('')"
                                class="cat-pill px-3 py-1.5 rounded-full text-xs font-bold border border-white/20 text-white/70 hover:border-amber-yellow hover:text-amber-yellow transition-all <%= !query.category ? 'active' : '' %>">
                                All
                            </button>
                            <% categories.forEach(cat => { %>
                                <button type="button"
                                    onclick="setCat('<%= cat %>')"
                                    class="cat-pill px-3 py-1.5 rounded-full text-xs font-bold border border-white/20 text-white/70 hover:border-amber-yellow hover:text-amber-yellow transition-all <%= query.category === cat ? 'active' : '' %>">
                                    <%= cat %>
                                </button>
                            <% }) %>
                            <input type="hidden" id="category-input" name="category" value="<%= query.category || '' %>">
                        </div>
                    </div>

                    <!-- Price Range -->
                    <div class="mb-7">
                        <div class="flex items-center justify-between mb-3">
                            <label class="text-white/50 font-bold text-xs uppercase tracking-[0.12em]">Price Range</label>
                            <span id="range-display" class="text-amber-yellow text-xs font-bold">
                                रू <span id="range-min-label"><%= query.minPrice || '0' %></span> – <span id="range-max-label"><%= query.maxPrice || 'Any' %></span>
                            </span>
                        </div>

                        <!-- Slider track -->
                        <div class="relative h-1 bg-white/15 rounded-full mt-5 mb-5 mx-2.5">
                            <div id="range-track-fill" class="absolute h-full bg-amber-yellow rounded-full pointer-events-none"></div>
                            <input type="range" id="slider-min" class="price-range" min="0" max="20000" step="100"
                                value="<%= query.minPrice || 0 %>">
                            <input type="range" id="slider-max" class="price-range" min="0" max="20000" step="100"
                                value="<%= query.maxPrice || 20000 %>">
                        </div>

                        <!-- Manual inputs -->
                        <div class="flex gap-3 mt-5">
                            <div class="flex-1">
                                <label class="text-white/40 text-[10px] uppercase tracking-wider block mb-1">Min रू</label>
                                <input type="number" id="input-min" name="minPrice" min="0" max="20000"
                                    value="<%= query.minPrice || '' %>"
                                    placeholder="0"
                                    class="w-full bg-white/6 border border-white/15 rounded-md px-3 py-2 text-white text-sm font-medium placeholder-white/25 focus:outline-none focus:border-amber-yellow transition-colors">
                            </div>
                            <div class="flex items-end pb-2 text-white/30 text-sm">—</div>
                            <div class="flex-1">
                                <label class="text-white/40 text-[10px] uppercase tracking-wider block mb-1">Max रू</label>
                                <input type="number" id="input-max" name="maxPrice" min="0" max="20000"
                                    value="<%= query.maxPrice || '' %>"
                                    placeholder="Any"
                                    class="w-full bg-white/6 border border-white/15 rounded-md px-3 py-2 text-white text-sm font-medium placeholder-white/25 focus:outline-none focus:border-amber-yellow transition-colors">
                            </div>
                        </div>
                    </div>

                    <!-- Apply button -->
                    <button type="submit"
                        class="w-full py-3 bg-amber-yellow text-background-dark font-bold rounded-lg hover:bg-amber-yellow/90 transition-all text-sm uppercase tracking-wider shadow-lg shadow-amber-yellow/10">
                        Apply Filters
                    </button>
                </form>
            </aside>

            <!-- ── MAIN CONTENT ── -->
            <div class="flex-1 min-w-0 px-4 lg:px-0 lg:pl-8 py-5 lg:py-0">

                <!-- Header row -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
                    <div>
                        <h1 class="text-2xl md:text-3xl font-bold font-mono-header tracking-tight">Art Marketplace</h1>
                        <p class="text-white/40 text-sm mt-1 font-mono-header tracking-widest uppercase">
                            Discover · Collect · Support Nepali Artists
                        </p>
                    </div>
                    <!-- Mobile filter toggle -->
                    <button onclick="toggleMobileFilters()" class="lg:hidden flex items-center gap-2 px-4 py-2 bg-white/8 border border-white/15 rounded-lg text-sm font-semibold text-white hover:border-amber-yellow transition-colors">
                        <span class="material-symbols-outlined text-[18px]">tune</span>
                        Filters
                        <% if (query.minPrice || query.maxPrice || query.category) { %>
                            <span class="w-2 h-2 rounded-full bg-amber-yellow"></span>
                        <% } %>
                    </button>
                </div>

                <!-- Active filter pills -->
                <% if (query.category || query.minPrice || query.maxPrice) { %>
                    <div class="flex flex-wrap gap-2 mb-6">
                        <% if (query.category) { %>
                            <% const base = new URLSearchParams(query); base.delete('category'); %>
                            <a href="/marketplace?<%= base.toString() %>" class="flex items-center gap-1.5 px-3 py-1.5 bg-amber-yellow/15 border border-amber-yellow/30 text-amber-yellow rounded-full text-xs font-bold hover:bg-amber-yellow/25 transition-colors">
                                <%= query.category %>
                                <span class="material-symbols-outlined text-[13px]">close</span>
                            </a>
                        <% } %>
                        <% if (query.minPrice || query.maxPrice) { %>
                            <% const base2 = new URLSearchParams(query); base2.delete('minPrice'); base2.delete('maxPrice'); %>
                            <a href="/marketplace?<%= base2.toString() %>" class="flex items-center gap-1.5 px-3 py-1.5 bg-amber-yellow/15 border border-amber-yellow/30 text-amber-yellow rounded-full text-xs font-bold hover:bg-amber-yellow/25 transition-colors">
                                Price: रू <%= query.minPrice || '0' %> – <%= query.maxPrice || 'Any' %>
                                <span class="material-symbols-outlined text-[13px]">close</span>
                            </a>
                        <% } %>
                    </div>
                <% } %>

                <!-- Featured Artworks Section -->
                <section class="mb-12">
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-xl font-bold font-mono-header">Featured Artworks</h2>
                    </div>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
                        <!-- Artwork 1 -->
                        <div class="group">
                            <div class="relative overflow-hidden rounded-sm border border-white/10 aspect-square mb-3">
                                <div class="w-full h-full bg-center bg-cover transition-transform duration-500 group-hover:scale-110"
                                    style='background-image: url("/images/mokha_pantiles.png");'></div>
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
                                    <button onclick="window.location.href='/marketplace'"
                                        class="w-full py-2 bg-amber-yellow text-background-dark font-bold rounded-md text-xs font-mono-header">Quick View</button>
                                </div>
                            </div>
                            <h3 class="text-white font-bold font-mono-header text-sm">Mokha Panels and Tiles</h3>
                            <div class="flex items-center gap-2 mt-1">
                                <span class="text-amber-yellow font-bold text-lg">Rs 120.00</span>
                                <button onclick="HE.cart.add({ id: 'feat-1', title: 'Mokha Panels and Tiles', price: '120', image: '/images/mokha_pantiles.png', creatorName: 'HeritEdge' })" title="Add to Cart" class="flex items-center justify-center text-white/50 hover:text-amber-yellow transition-colors"><span class="material-symbols-outlined text-[20px]">shopping_cart</span></button>
                                <button onclick="HE.col.toggle({ id: 'feat-1', title: 'Mokha Panels and Tiles', price: '120', image: '/images/mokha_pantiles.png', creatorName: 'HeritEdge' }, this)" title="Save to Collection" class="save-col-btn flex items-center justify-center text-white/50 hover:text-red-400 transition-colors" data-art-id="feat-1"><span class="material-symbols-outlined save-icon text-[20px]">favorite</span></button>
                            </div>
                        </div>
                        <!-- Artwork 2 -->
                        <div class="group">
                            <div class="relative overflow-hidden rounded-sm border border-white/10 aspect-square mb-3">
                                <div class="w-full h-full bg-center bg-cover transition-transform duration-500 group-hover:scale-110"
                                    style='background-image: url("/images/radipakhi.png");'></div>
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
                                    <button onclick="window.location.href='/marketplace'"
                                        class="w-full py-2 bg-amber-yellow text-background-dark font-bold rounded-md text-xs font-mono-header">Quick View</button>
                                </div>
                            </div>
                            <h3 class="text-white font-bold font-mono-header text-sm">Sheep Wool Radi Pakhi</h3>
                            <div class="flex items-center gap-2 mt-1">
                                <span class="text-amber-yellow font-bold text-lg">Rs 85.00</span>
                                <button onclick="HE.cart.add({ id: 'feat-2', title: 'Sheep Wool Radi Pakhi', price: '85', image: '/images/radipakhi.png', creatorName: 'HeritEdge' })" title="Add to Cart" class="flex items-center justify-center text-white/50 hover:text-amber-yellow transition-colors"><span class="material-symbols-outlined text-[20px]">shopping_cart</span></button>
                                <button onclick="HE.col.toggle({ id: 'feat-2', title: 'Sheep Wool Radi Pakhi', price: '85', image: '/images/radipakhi.png', creatorName: 'HeritEdge' }, this)" title="Save to Collection" class="save-col-btn flex items-center justify-center text-white/50 hover:text-red-400 transition-colors" data-art-id="feat-2"><span class="material-symbols-outlined save-icon text-[20px]">favorite</span></button>
                            </div>
                        </div>
                        <!-- Artwork 3 -->
                        <div class="group">
                            <div class="relative overflow-hidden rounded-sm border border-white/10 aspect-square mb-3">
                                <div class="w-full h-full bg-center bg-cover transition-transform duration-500 group-hover:scale-110"
                                    style='background-image: url("/images/sikkicoast.jpg");'></div>
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
                                    <button onclick="window.location.href='/marketplace'"
                                        class="w-full py-2 bg-amber-yellow text-background-dark font-bold rounded-md text-xs font-mono-header">Quick View</button>
                                </div>
                            </div>
                            <h3 class="text-white font-bold font-mono-header text-sm">Sikki/Moonj Grass Coasters</h3>
                            <div class="flex items-center gap-2 mt-1">
                                <span class="text-amber-yellow font-bold text-lg">Rs 25.00</span>
                                <button onclick="HE.cart.add({ id: 'feat-3', title: 'Sikki/Moonj Grass Coasters', price: '25', image: '/images/sikkicoast.jpg', creatorName: 'HeritEdge' })" title="Add to Cart" class="flex items-center justify-center text-white/50 hover:text-amber-yellow transition-colors"><span class="material-symbols-outlined text-[20px]">shopping_cart</span></button>
                                <button onclick="HE.col.toggle({ id: 'feat-3', title: 'Sikki/Moonj Grass Coasters', price: '25', image: '/images/sikkicoast.jpg', creatorName: 'HeritEdge' }, this)" title="Save to Collection" class="save-col-btn flex items-center justify-center text-white/50 hover:text-red-400 transition-colors" data-art-id="feat-3"><span class="material-symbols-outlined save-icon text-[20px]">favorite</span></button>
                            </div>
                        </div>
                        <!-- Artwork 4 -->
                        <div class="group">
                            <div class="relative overflow-hidden rounded-sm border border-white/10 aspect-square mb-3">
                                <div class="w-full h-full bg-center bg-cover transition-transform duration-500 group-hover:scale-110"
                                    style='background-image: url("/images/gundrichakati.png");'></div>
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
                                    <button onclick="window.location.href='/marketplace'"
                                        class="w-full py-2 bg-amber-yellow text-background-dark font-bold rounded-md text-xs font-mono-header">Quick View</button>
                                </div>
                            </div>
                            <h3 class="text-white font-bold font-mono-header text-sm">Straw Gundri/Chakati</h3>
                            <div class="flex items-center gap-2 mt-1">
                                <span class="text-amber-yellow font-bold text-lg">Rs 45.00</span>
                                <button onclick="HE.cart.add({ id: 'feat-4', title: 'Straw Gundri/Chakati', price: '45', image: '/images/gundrichakati.png', creatorName: 'HeritEdge' })" title="Add to Cart" class="flex items-center justify-center text-white/50 hover:text-amber-yellow transition-colors"><span class="material-symbols-outlined text-[20px]">shopping_cart</span></button>
                                <button onclick="HE.col.toggle({ id: 'feat-4', title: 'Straw Gundri/Chakati', price: '45', image: '/images/gundrichakati.png', creatorName: 'HeritEdge' }, this)" title="Save to Collection" class="save-col-btn flex items-center justify-center text-white/50 hover:text-red-400 transition-colors" data-art-id="feat-4"><span class="material-symbols-outlined save-icon text-[20px]">favorite</span></button>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 mt-8 mb-2">
                        <div class="flex-1 h-px bg-white/10"></div>
                    </div>
                </section>

                <!-- Recommended Section -->
                <% if (typeof recommendedArtworks !== 'undefined' && recommendedArtworks.length > 0) { %>
                    <section class="mb-12">
                        <div class="flex items-center gap-3 mb-6">
                            <span class="material-symbols-outlined text-amber-yellow text-[22px]">auto_awesome</span>
                            <h2 class="text-xl font-bold font-mono-header">Recommended for You</h2>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">
                            <% recommendedArtworks.forEach(art => { %>
                                <div class="art-card group flex flex-col bg-deep-maroon/25 rounded-xl border border-amber-yellow/20 overflow-hidden shadow-lg">
                                    <div class="relative w-full aspect-square overflow-hidden bg-black/30">
                                        <a href="/artwork/<%= art.id %>">
                                            <img src="<%= art.image %>" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" onerror="this.src='/images/placeholder.jpg'" />
                                        </a>
                                        <div class="absolute top-3 left-3">
                                            <span class="bg-amber-yellow/90 text-background-dark text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider">Recommended</span>
                                        </div>
                                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4 gap-2">
                                            <a href="/artwork/<%= art.id %>" class="flex-1 py-2 bg-amber-yellow text-background-dark text-xs font-bold rounded-lg text-center hover:bg-white transition-colors uppercase tracking-wider">View</a>
                                        </div>
                                    </div>
                                    <div class="flex flex-col flex-1 p-4 gap-2">
                                        <a href="/artwork/<%= art.id %>"><h3 class="text-white text-sm font-bold font-mono-header hover:text-amber-yellow transition-colors line-clamp-1"><%= art.title %></h3></a>
                                        <a href="/artist/<%= art.creatorId %>" class="flex items-center gap-1 text-dusty-rose text-xs font-semibold hover:text-amber-yellow transition-colors">
                                            <span class="material-symbols-outlined text-[13px]">brush</span><%= art.creatorName %>
                                        </a>
                                        <div class="flex items-center justify-between pt-2 border-t border-white/8 mt-auto">
                                            <span class="text-amber-yellow font-bold text-base">रू <%= art.price %></span>
                                            <div class="flex gap-1.5 items-center">
                                                <button
                                                    onclick="HE.cart.add({ id: '<%= art.id %>', title: `<%= art.title.replace(/`/g, '\\`') %>`, price: '<%= art.price %>', image: '<%= art.image %>', creatorName: `<%= (art.creatorName || '').replace(/`/g, '\\`') %>` })"
                                                    title="Add to Cart"
                                                    class="w-7 h-7 rounded-lg bg-white/6 border border-white/15 flex items-center justify-center text-white/50 hover:text-amber-yellow hover:border-amber-yellow/40 transition-all">
                                                    <span class="material-symbols-outlined text-[20px]">shopping_cart</span>
                                                </button>
                                                <button
                                                    onclick="HE.col.toggle({ id: '<%= art.id %>', title: `<%= art.title.replace(/`/g, '\\`') %>`, price: '<%= art.price %>', image: '<%= art.image %>', creatorName: `<%= (art.creatorName || '').replace(/`/g, '\\`') %>` }, this)"
                                                    title="Save to Collection"
                                                    class="save-col-btn w-7 h-7 rounded-lg bg-white/6 border border-white/15 flex items-center justify-center text-white/50 hover:text-red-400 hover:border-red-400/30 transition-all"
                                                    data-art-id="<%= art.id %>">
                                                    <span class="material-symbols-outlined save-icon text-[20px]">favorite</span>
                                                </button>
                                                <a href="/artwork/<%= art.id %>" class="px-3 h-7 rounded-lg bg-amber-yellow/10 border border-amber-yellow/25 flex items-center text-amber-yellow text-xs font-bold hover:bg-amber-yellow hover:text-background-dark transition-all uppercase">View</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </section>
                    <div class="flex items-center gap-4 mb-6">
                        <h2 class="text-xl font-bold font-mono-header">Explore All</h2>
                        <div class="flex-1 h-px bg-white/10"></div>
                    </div>
                <% } %>

                <!-- Artworks Grid -->
                <% if (artworks && artworks.length > 0) { %>
                    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5 md:gap-6">
                        <% artworks.forEach(art => { %>
                            <div class="art-card group flex flex-col bg-deep-maroon/25 rounded-xl border border-white/8 hover:border-amber-yellow/40 overflow-hidden shadow-lg">
                                <!-- Image -->
                                <div class="relative w-full aspect-square overflow-hidden bg-black/30">
                                    <a href="/artwork/<%= art.id %>">
                                        <img src="<%= art.image %>"
                                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                            loading="lazy"
                                            onerror="this.src='/images/placeholder.jpg'" />
                                    </a>
                                    <!-- Category badge -->
                                    <div class="absolute top-3 left-3">
                                        <span class="bg-black/60 backdrop-blur text-white text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider border border-white/15">
                                            <%= art.category || 'Art' %>
                                        </span>
                                    </div>
                                    <!-- Hover overlay -->
                                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4 gap-2">
                                        <a href="/artwork/<%= art.id %>"
                                            class="flex-1 py-2 bg-white text-background-dark text-xs font-bold rounded-lg text-center hover:bg-amber-yellow transition-colors uppercase tracking-wider">
                                            View
                                        </a>
                                        <button
                                            onclick="HE.cart.add({ id: '<%= art.id %>', title: `<%= art.title.replace(/`/g, '\\`') %>`, price: '<%= art.price %>', image: '<%= art.image %>', creatorName: `<%= (art.creatorName || '').replace(/`/g, '\\`') %>` })"
                                            class="flex-1 py-2 bg-amber-yellow text-background-dark text-xs font-bold rounded-lg text-center hover:bg-white transition-colors uppercase tracking-wider">
                                            Add to Cart
                                        </button>
                                    </div>
                                </div>

                                <!-- Card info -->
                                <div class="flex flex-col flex-1 p-4 gap-3">
                                    <div class="flex-1">
                                        <a href="/artwork/<%= art.id %>">
                                            <h3 class="text-white text-base font-bold font-mono-header leading-snug hover:text-amber-yellow transition-colors line-clamp-1">
                                                <%= art.title %>
                                            </h3>
                                        </a>
                                        <a href="/artist/<%= art.creatorId %>"
                                            class="flex items-center gap-1 mt-1 text-dusty-rose text-xs font-semibold hover:text-amber-yellow transition-colors group/auth">
                                            <span class="material-symbols-outlined text-[13px]">brush</span>
                                            <%= art.creatorName %>
                                        </a>
                                    </div>

                                    <div class="flex items-center justify-between pt-2 border-t border-white/8">
                                        <span class="text-amber-yellow font-bold text-lg font-mono">रू <%= art.price %></span>
                                        <div class="flex gap-2">
                                            <button
                                                onclick="HE.cart.add({ id: '<%= art.id %>', title: `<%= art.title.replace(/`/g, '\\`') %>`, price: '<%= art.price %>', image: '<%= art.image %>', creatorName: `<%= (art.creatorName || '').replace(/`/g, '\\`') %>` })"
                                                title="Add to Cart"
                                                class="w-8 h-8 rounded-lg bg-white/6 border border-white/15 flex items-center justify-center text-white/50 hover:text-amber-yellow hover:border-amber-yellow/40 transition-all">
                                                <span class="material-symbols-outlined text-[20px]">shopping_cart</span>
                                            </button>
                                            <button
                                                onclick="HE.col.toggle({ id: '<%= art.id %>', title: `<%= art.title.replace(/`/g, '\\`') %>`, price: '<%= art.price %>', image: '<%= art.image %>', creatorName: `<%= (art.creatorName || '').replace(/`/g, '\\`') %>` }, this)"
                                                title="Save to Collection"
                                                class="save-col-btn w-8 h-8 rounded-lg bg-white/6 border border-white/15 flex items-center justify-center text-white/50 hover:text-red-400 hover:border-red-400/30 transition-all"
                                                data-art-id="<%= art.id %>">
                                                <span class="material-symbols-outlined save-icon text-[20px]">favorite</span>
                                            </button>
                                            <a href="/artwork/<%= art.id %>"
                                                class="px-3 h-8 rounded-lg bg-amber-yellow/10 border border-amber-yellow/25 flex items-center text-amber-yellow text-xs font-bold hover:bg-amber-yellow hover:text-background-dark transition-all uppercase tracking-wide">
                                                View
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <!-- Pagination -->
                    <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
                        <div class="flex justify-center items-center gap-2 mt-14">
                            <% if (pagination.currentPage > 1) { %>
                                <% const prevQ = new URLSearchParams(query); prevQ.set('page', pagination.currentPage - 1); %>
                                <a href="/marketplace?<%= prevQ.toString() %>"
                                    class="flex items-center gap-1.5 px-5 py-2.5 border border-white/20 bg-white/5 text-white rounded-lg hover:bg-white/10 transition-colors font-mono uppercase text-xs font-bold tracking-widest">
                                    <span class="material-symbols-outlined text-[16px]">arrow_back</span> Prev
                                </a>
                            <% } %>

                            <div class="flex gap-1">
                                <% for (let p = Math.max(1, pagination.currentPage - 2); p <= Math.min(pagination.totalPages, pagination.currentPage + 2); p++) { %>
                                    <% const pageQ = new URLSearchParams(query); pageQ.set('page', p); %>
                                    <a href="/marketplace?<%= pageQ.toString() %>"
                                        class="w-9 h-9 flex items-center justify-center rounded-lg text-sm font-bold transition-colors <%= p === pagination.currentPage ? 'bg-amber-yellow text-background-dark' : 'border border-white/15 text-white/60 hover:border-amber-yellow/50 hover:text-white' %>">
                                        <%= p %>
                                    </a>
                                <% } %>
                            </div>

                            <% if (pagination.currentPage < pagination.totalPages) { %>
                                <% const nextQ = new URLSearchParams(query); nextQ.set('page', pagination.currentPage + 1); %>
                                <a href="/marketplace?<%= nextQ.toString() %>"
                                    class="flex items-center gap-1.5 px-5 py-2.5 border border-white/20 bg-white/10 text-white rounded-lg hover:bg-amber-yellow hover:text-black transition-colors font-mono uppercase text-xs font-bold tracking-widest">
                                    Next <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                                </a>
                            <% } %>
                        </div>
                    <% } %>

                <% } else { %>
                    <div class="flex flex-col items-center justify-center py-24 text-center">
                        <div class="w-20 h-20 rounded-full bg-white/5 border border-white/10 flex items-center justify-center mb-6">
                            <span class="material-symbols-outlined text-5xl text-white/20">palette</span>
                        </div>
                        <h2 class="text-xl font-bold font-mono text-white/80 mb-2">No Artworks Found</h2>
                        <p class="text-sm text-white/40 max-w-xs">Try adjusting your filters or check back later as artists add new pieces.</p>
                        <a href="/marketplace" class="mt-6 px-6 py-2.5 bg-amber-yellow/10 border border-amber-yellow/30 text-amber-yellow font-bold rounded-lg text-sm hover:bg-amber-yellow hover:text-background-dark transition-all">
                            Clear Filters
                        </a>
                    </div>
                <% } %>
            </div>
        </main>

        <%- include('partials/footer') %>
    </div>

    <script>
        const PRICE_MAX = 20000;
        const sliderMin = document.getElementById('slider-min');
        const sliderMax = document.getElementById('slider-max');
        const inputMin = document.getElementById('input-min');
        const inputMax = document.getElementById('input-max');
        const trackFill = document.getElementById('range-track-fill');
        const labelMin = document.getElementById('range-min-label');
        const labelMax = document.getElementById('range-max-label');

        function formatPrice(n) {
            return n >= 1000 ? (n / 1000).toFixed(n % 1000 === 0 ? 0 : 1) + 'k' : String(n);
        }

        function updateTrack() {
            const minVal = parseInt(sliderMin.value);
            const maxVal = parseInt(sliderMax.value);
            const leftPct = (minVal / PRICE_MAX) * 100;
            const rightPct = 100 - (maxVal / PRICE_MAX) * 100;
            trackFill.style.left = leftPct + '%';
            trackFill.style.right = rightPct + '%';
            labelMin.textContent = minVal > 0 ? formatPrice(minVal) : '0';
            labelMax.textContent = maxVal < PRICE_MAX ? formatPrice(maxVal) : 'Any';
        }

        // Slider → inputs
        sliderMin?.addEventListener('input', function () {
            let minV = parseInt(this.value);
            let maxV = parseInt(sliderMax.value);
            if (minV >= maxV) { minV = maxV - 500; this.value = minV; }
            inputMin.value = minV > 0 ? minV : '';
            updateTrack();
        });

        sliderMax?.addEventListener('input', function () {
            let maxV = parseInt(this.value);
            let minV = parseInt(sliderMin.value);
            if (maxV <= minV) { maxV = minV + 500; this.value = maxV; }
            inputMax.value = maxV < PRICE_MAX ? maxV : '';
            updateTrack();
        });

        // Inputs → slider (with debounce + auto-submit)
        let debounceTimer;
        function onPriceInputChange() {
            clearTimeout(debounceTimer);
            let minV = parseInt(inputMin.value) || 0;
            let maxV = parseInt(inputMax.value) || PRICE_MAX;

            // Validation
            if (minV < 0) { minV = 0; inputMin.value = ''; }
            if (maxV < 0) { maxV = 0; inputMax.value = 0; }
            if (minV > maxV) { maxV = minV; inputMax.value = maxV < PRICE_MAX ? maxV : ''; }

            sliderMin.value = minV;
            sliderMax.value = maxV;
            updateTrack();

            debounceTimer = setTimeout(() => {
                document.getElementById('filter-form').submit();
            }, 800);
        }

        inputMin?.addEventListener('input', onPriceInputChange);
        inputMax?.addEventListener('input', onPriceInputChange);

        // Initialize track on load
        updateTrack();

        // Category pills
        function setCat(cat) {
            document.getElementById('category-input').value = cat;
            document.querySelectorAll('.cat-pill').forEach(p => p.classList.remove('active'));
            event.currentTarget.classList.add('active');
            document.getElementById('filter-form').submit();
        }

        // Mobile filter toggle
        function toggleMobileFilters() {
            const sidebar = document.getElementById('filter-sidebar');
            sidebar.classList.toggle('hidden');
        }

        // Restore saved-collection fill state on load
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.save-col-btn').forEach(btn => {
                const id = btn.dataset.artId;
                if (id && HE.col.isSaved(id)) {
                    btn.title = 'Remove from Collection';
                    btn.classList.add('text-amber-yellow', 'border-amber-yellow/40');
                    btn.classList.remove('text-white/50');
                    const icon = btn.querySelector('.save-icon');
                    if (icon) icon.style.fontVariationSettings = "'FILL' 1";
                }
            });
        });
    </script>
</body>

</html>
