<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <%- include('partials/head') %>
</head>

<body class="bg-[#fcfaf7] min-h-screen font-sans overflow-x-hidden text-[#2c1d11]">
    <div class="flex flex-col h-full grow">
        <%- include('partials/header') %>
        
        <main class="flex flex-col w-full max-w-[1240px] mx-auto px-4 lg:px-10 pb-20">
            <!-- Cover Photo Area -->
            <div class="w-full h-[240px] md:h-[320px] rounded-b-[1.5rem] md:rounded-b-[2rem] overflow-hidden relative shadow-sm" style="background: repeating-linear-gradient(90deg, #4A1201 0px, #4A1201 60px, #B93814 60px, #B93814 120px, #86210A 120px, #86210A 180px, #D4541B 180px, #D4541B 240px, #5D1905 240px, #5D1905 300px);">
                <!-- Adds a slight inner shadow/gradient to the cover -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-black/10"></div>
            </div>

            <!-- Profile Header Section -->
            <div class="relative px-4 sm:px-8 mt-[-60px] md:mt-[-80px] flex flex-col md:flex-row items-end md:items-center justify-between z-10 gap-6">
                <!-- Left: Avatar & Info -->
                <div class="flex flex-col md:flex-row items-center md:items-end gap-6 w-full md:w-auto">
                    <div class="w-32 h-32 md:w-[170px] md:h-[170px] rounded-full overflow-hidden border-[6px] border-[#fcfaf7] shadow-lg flex-shrink-0 bg-gray-200">
                        <img src="<%= artist?.avatar || 'https://lh3.googleusercontent.com/aida-public/AB6AXuDFnIxnWb9AzaIzvWrYMJX_D3tKYwNJAqsz7ynWqtZFM_f8IUT0mOWiipjLeMR4iYYAzOPIClPUgpC99-gthpbSfWVeviaLEUoNOoUeGLJypwiFOr2X2i-u5vkQmgBu973yjjsvrpzvZvW91bnVbTpO7oaOJxrs96Q642WMDlodB_khNexQsuUcw5Q8USKfHkf3CnNqb1jU8FpP5NCGNrtOZgw70iJHCV6yBVCW44dSLnD6XGcrAHXNlULt1fqHLSKLDPll__tayLg' %>" alt="Artist Avatar" class="w-full h-full object-cover" />
                    </div>
                    
                    <div class="flex flex-col md:mb-4 text-center md:text-left">
                        <h1 class="text-3xl md:text-[32px] font-bold text-[#1a110a] leading-tight font-sans"><%= artist?.name || 'Anjali Tamang' %></h1>
                        <p class="text-[#b91c3b] font-bold text-[15px] mt-0.5 font-sans"><%= artist?.tagline || 'Master Thangka Painter | Empowering Marginalized Voices' %></p>
                        
                        <div class="flex items-center justify-center md:justify-start gap-4 mt-2 text-[14px] font-medium">
                            <div class="flex items-center gap-1.5 text-gray-500">
                                <span class="material-symbols-outlined text-[16px]">location_on</span>
                                <span><%= artist?.location || 'Kathmandu, Nepal' %></span>
                            </div>
                            <span class="text-gray-300">•</span>
                            <div class="text-[#eab308] font-bold">
                                5.2k Followers
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right: Action Buttons -->
                <div class="flex items-center gap-3 w-full md:w-auto justify-center md:mb-4">
                    <button class="px-8 py-2.5 bg-[#f3ebeb] text-[#332218] font-bold text-[14px] rounded-md transition-colors hover:bg-[#e8dddd]">Follow</button>
                    <button class="px-8 py-2.5 bg-[#b91c3b] text-white font-bold text-[14px] rounded-md shadow-md transition-colors hover:bg-[#9f1531]">Message</button>
                </div>
            </div>

            <!-- Navigation Tabs -->
            <div class="w-full border-b border-[#ebdcd0] mt-10 flex gap-8 px-4 sm:px-8">
                <a href="#" class="pb-3 text-[#b91c3b] font-bold text-[14px] border-b-[3px] border-[#b91c3b]">Feed</a>
                <a href="#" class="pb-3 text-gray-500 hover:text-[#523d2e] font-bold text-[14px] transition-colors border-b-[3px] border-transparent">Artworks</a>
                <a href="#" class="pb-3 text-gray-500 hover:text-[#523d2e] font-bold text-[14px] transition-colors border-b-[3px] border-transparent">About</a>
                <a href="#" class="pb-3 text-gray-500 hover:text-[#523d2e] font-bold text-[14px] transition-colors border-b-[3px] border-transparent">Journey</a>
            </div>

            <!-- Main Content Grid -->
            <div class="flex flex-col lg:flex-row mt-8 gap-8 px-0 sm:px-4">
                
                <!-- Left Sidebar -->
                <aside class="w-full lg:w-[320px] flex flex-col gap-6 shrink-0">
                    <!-- Bio / Journey Block -->
                    <div class="bg-white rounded-xl p-6 shadow-[0_2px_10px_rgba(0,0,0,0.03)] border border-[#f3efe9]">
                        <h3 class="flex items-center gap-2 text-[#2c1d11] font-bold text-[16px] mb-4">
                            <span class="material-symbols-outlined text-[#b91c3b]">auto_awesome</span> Artist Journey
                        </h3>
                        <p class="text-[#7a6454] text-[14px] leading-relaxed">
                            <%= artist?.bio || 'Born in the foothills of the Himalayas, my art is a testament to the resilience of Tamang women. I blend traditional Buddhist iconography with contemporary social themes to give a voice to the voiceless.' %>
                        </p>
                    </div>

                    <!-- Cultural Background -->
                    <div class="bg-white rounded-xl p-6 shadow-[0_2px_10px_rgba(0,0,0,0.03)] border border-[#f3efe9]">
                        <h3 class="flex items-center gap-2 text-[#2c1d11] font-bold text-[16px] mb-4">
                            <span class="material-symbols-outlined text-[#b91c3b]">menu_book</span> Cultural Background
                        </h3>
                        <ul class="flex flex-col gap-3">
                            <li class="flex items-start gap-3">
                                <span class="material-symbols-outlined text-[#eab308] text-[18px] mt-0.5">verified</span>
                                <span class="text-[#7a6454] text-[14px]">Heritage: Tamang-Buddhist</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="material-symbols-outlined text-[#eab308] text-[18px] mt-0.5">verified</span>
                                <span class="text-[#7a6454] text-[14px]">Traditional Training: 15+ years under Master Karma Lama</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Skills & Mediums -->
                    <div class="bg-white rounded-xl p-6 shadow-[0_2px_10px_rgba(0,0,0,0.03)] border border-[#f3efe9]">
                        <h3 class="flex items-center gap-2 text-[#2c1d11] font-bold text-[16px] mb-4">
                            <span class="material-symbols-outlined text-[#b91c3b]">palette</span> Skills & Mediums
                        </h3>
                        <div class="flex flex-wrap gap-2">
                            <span class="px-3 py-1 bg-[#fdf2f2] text-[#b91c3b] text-[12px] font-bold rounded-full">Natural Pigments</span>
                            <span class="px-3 py-1 bg-[#fdf2f2] text-[#b91c3b] text-[12px] font-bold rounded-full">Gold Leaf</span>
                            <span class="px-3 py-1 bg-[#fdf2f2] text-[#b91c3b] text-[12px] font-bold rounded-full">Silk Canvas</span>
                            <span class="px-3 py-1 bg-[#fdf2f2] text-[#b91c3b] text-[12px] font-bold rounded-full">Gouache</span>
                            <span class="px-3 py-1 bg-[#fdf2f2] text-[#b91c3b] text-[12px] font-bold rounded-full">Hand-drawn Sketches</span>
                        </div>
                    </div>
                </aside>

                <!-- Right Main Column -->
                <div class="flex-1 min-w-0 flex flex-col gap-10">
                    
                    <!-- Journey Highlights -->
                    <div class="flex flex-col">
                        <h2 class="text-[#2c1d11] font-bold text-[16px] mb-4">Journey Highlights</h2>
                        <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
                            <!-- Highlight Card 1 -->
                            <div class="flex flex-col items-center gap-2 group cursor-pointer">
                                <div class="w-full aspect-[3/4] rounded-[14px] overflow-hidden shadow-sm border border-black/5 relative">
                                    <div class="absolute inset-x-0 top-0 h-1 bg-[#b91c3b] z-10"></div>
                                    <img src="https://images.unsplash.com/photo-1513364776144-60967b0f800f?q=80&w=400" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Studio Day">
                                </div>
                                <span class="text-[11px] font-bold text-[#2c1d11]">Studio Day</span>
                            </div>
                            <!-- Highlight Card 2 -->
                            <div class="flex flex-col items-center gap-2 group cursor-pointer">
                                <div class="w-full aspect-[3/4] rounded-[14px] overflow-hidden shadow-sm border border-black/5 relative">
                                    <div class="absolute inset-x-0 top-0 h-1 bg-[#b91c3b] z-10"></div>
                                    <img src="https://images.unsplash.com/photo-1550684848-fac1c5b4e853?q=80&w=400" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Pigments">
                                </div>
                                <span class="text-[11px] font-bold text-[#2c1d11]">Pigments</span>
                            </div>
                            <!-- Highlight Card 3 -->
                            <div class="flex flex-col items-center gap-2 group cursor-pointer">
                                <div class="w-full aspect-[3/4] rounded-[14px] overflow-hidden shadow-sm border border-black/5 relative">
                                    <div class="absolute inset-x-0 top-0 h-1 bg-[#b91c3b] z-10"></div>
                                    <div class="w-full h-full bg-[#e5e5e5] flex items-center justify-center p-4">
                                        <span class="material-symbols-outlined text-[48px] text-gray-400 font-light">edit_document</span>
                                    </div>
                                </div>
                                <span class="text-[11px] font-bold text-[#2c1d11]">Sketching</span>
                            </div>
                            <!-- Highlight Card 4 -->
                            <div class="flex flex-col items-center gap-2 group cursor-pointer">
                                <div class="w-full aspect-[3/4] rounded-[14px] overflow-hidden shadow-sm border border-black/5 relative">
                                    <div class="absolute inset-x-0 top-0 h-1 bg-[#b91c3b] z-10"></div>
                                    <div class="w-full h-full bg-[#d6d3c9] flex items-end justify-center pb-6">
                                        <div class="w-1/2 h-2/3 bg-white rounded-t-sm shadow-md"></div>
                                    </div>
                                </div>
                                <span class="text-[11px] font-bold text-[#2c1d11]">Exhibition</span>
                            </div>
                            <!-- Highlight Card 5 -->
                            <div class="flex flex-col items-center gap-2 group cursor-pointer hidden md:flex">
                                <div class="w-full aspect-[3/4] rounded-[14px] overflow-hidden shadow-sm border border-black/5 relative bg-[#1f303a] p-4 flex flex-col justify-center text-center">
                                    <div class="absolute inset-x-0 top-0 h-1 bg-[#b91c3b] z-10"></div>
                                    <h4 class="text-white text-[10px] tracking-widest uppercase mb-2">New Collection</h4>
                                    <div class="w-6 h-px bg-white/30 mx-auto my-2"></div>
                                    <p class="text-white/60 text-[8px] leading-relaxed">Exclusive preview of the upcoming series celebrating ancient designs.</p>
                                </div>
                                <span class="text-[11px] font-bold text-[#2c1d11]">New Drop</span>
                            </div>
                        </div>
                    </div>

                    <!-- Feed Post -->
                    <div class="bg-white rounded-[20px] p-6 shadow-[0_2px_15px_rgba(0,0,0,0.04)] border border-[#f3efe9] flex flex-col gap-4">
                        <div class="flex items-start justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 rounded-full bg-[#fdf2f2] flex items-center justify-center shrink-0">
                                    <span class="material-symbols-outlined text-[#b91c3b]">campaign</span>
                                </div>
                                <div class="flex flex-col">
                                    <span class="font-bold text-[#2c1d11] text-[15px]">New Post</span>
                                    <span class="text-gray-400 text-[12px] font-medium">2 hours ago</span>
                                </div>
                            </div>
                            <div class="bg-[#fef9c3] text-[#ca8a04] px-3 py-1 rounded text-[9px] font-black uppercase tracking-wider">
                                Announcement
                            </div>
                        </div>
                        
                        <p class="text-[#4a3b30] text-[13px] leading-relaxed mt-1">
                            Excited to announce my upcoming workshop in Patan! We will be exploring the sacred geometry of Mandalas and how it relates to our inner peace. Limited seats available for local women artists.
                        </p>
                        
                        <div class="w-full h-[220px] rounded-[14px] overflow-hidden mt-2">
                            <img src="https://images.unsplash.com/photo-1563214532-6a68bd8dbd3f?q=80&w=1000" class="w-full h-full object-cover" alt="Workshop preview">
                        </div>

                        <div class="flex items-center gap-6 mt-2 pt-4 border-t border-gray-100">
                            <button class="flex items-center gap-2 text-[#b91c3b] transition-colors">
                                <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">favorite</span>
                                <span class="text-[13px] font-bold text-gray-600">342</span>
                            </button>
                            <button class="flex items-center gap-2 text-[#b91c3b] transition-colors">
                                <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">chat_bubble</span>
                                <span class="text-[13px] font-bold text-gray-600">28</span>
                            </button>
                            <button class="flex items-center gap-2 text-[#b91c3b] transition-colors ml-auto">
                                <span class="material-symbols-outlined text-[18px]">share</span>
                            </button>
                        </div>
                    </div>

                    <!-- Featured Artworks -->
                    <div class="flex flex-col gap-4">
                        <div class="flex items-center justify-between">
                            <h2 class="text-[#2c1d11] font-bold text-[16px]">Featured Artworks</h2>
                            <a href="#" class="text-[#b91c3b] font-bold text-[13px] hover:underline">View All</a>
                        </div>
                        
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <% if (artworks && artworks.length > 0) { %>
                                <% artworks.slice(0, 2).forEach(art => { %>
                                    <div class="bg-white rounded-[20px] p-4 shadow-[0_2px_15px_rgba(0,0,0,0.04)] border border-[#f3efe9] flex flex-col gap-4">
                                        <div class="w-full aspect-square rounded-[14px] overflow-hidden bg-gray-100">
                                            <img src="<%= art.image %>" class="w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1601004890684-d8cbf643f5f2?q=80&w=600'" />
                                        </div>
                                        <div class="flex flex-col gap-1 px-1">
                                            <div class="flex items-start justify-between gap-4">
                                                <h3 class="font-bold text-[#2c1d11] text-[15px] truncate"><%= art.title %></h3>
                                                <span class="text-[#b91c3b] font-bold text-[15px] whitespace-nowrap"><%= art.price %> ETH</span>
                                            </div>
                                            <p class="text-[#7a6454] text-[12px] truncate capitalize"><%= art.desc || 'Natural pigments on cotton' %></p>
                                        </div>
                                        <button class="w-full py-3 bg-[#b91c3b] hover:bg-[#9f1531] text-white text-[13px] font-bold rounded-lg transition-colors mt-1">Buy NFT / Print</button>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <!-- Placeholder 1 -->
                                <div class="bg-white rounded-[20px] p-4 shadow-[0_2px_15px_rgba(0,0,0,0.04)] border border-[#f3efe9] flex flex-col gap-4">
                                    <div class="w-full aspect-[4/5] rounded-[14px] overflow-hidden bg-black flex items-center justify-center">
                                        <!-- Simulated Thangka rendering -->
                                        <img src="https://images.unsplash.com/photo-1598425268383-f4ae5ea56b3e?q=80&w=600" class="w-full h-full object-cover opacity-90 mix-blend-luminosity" />
                                    </div>
                                    <div class="flex flex-col gap-1 px-1">
                                        <div class="flex items-start justify-between gap-4">
                                            <h3 class="font-bold text-[#2c1d11] text-[15px] truncate">The Compassionate Green Tara</h3>
                                            <span class="text-[#b91c3b] font-bold text-[15px] whitespace-nowrap">2.4 ETH</span>
                                        </div>
                                        <p class="text-[#7a6454] text-[12px] truncate">Natural pigments on cotton</p>
                                    </div>
                                    <button class="w-full py-3 bg-[#b91c3b] hover:bg-[#9f1531] text-white text-[13px] font-bold rounded-lg transition-colors mt-1">Buy NFT / Print</button>
                                </div>
                                
                                <!-- Placeholder 2 -->
                                <div class="bg-white rounded-[20px] p-4 shadow-[0_2px_15px_rgba(0,0,0,0.04)] border border-[#f3efe9] flex flex-col gap-4">
                                    <div class="w-full aspect-[4/5] rounded-[14px] overflow-hidden bg-[#e5e7eb] flex items-center justify-center p-6">
                                        <!-- Simulated Mandala rendering -->
                                        <div class="w-full h-full rounded-full border-4 border-[#3c4a3e] bg-[#536553] flex items-center justify-center relative overflow-hidden">
                                           <div class="absolute inset-0 bg-repeat opacity-20" style="background-image: url('data:image/svg+xml,%3Csvg width=\'20\' height=\'20\' viewBox=\'0 0 20 20\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'%23000000\' fill-opacity=\'1\' fill-rule=\'evenodd\'%3E%3Ccircle cx=\'3\' cy=\'3\' r=\'3\'/%3E%3Ccircle cx=\'13\' cy=\'13\' r=\'3\'/%3E%3C/g%3E%3C/svg%3E');"></div>
                                        </div>
                                    </div>
                                    <div class="flex flex-col gap-1 px-1">
                                        <div class="flex items-start justify-between gap-4">
                                            <h3 class="font-bold text-[#2c1d11] text-[15px] truncate">Mandala of Inner Peace</h3>
                                            <span class="text-[#b91c3b] font-bold text-[15px] whitespace-nowrap">1.8 ETH</span>
                                        </div>
                                        <p class="text-[#7a6454] text-[12px] truncate">Gold leaf and gouache</p>
                                    </div>
                                    <button class="w-full py-3 bg-[#b91c3b] hover:bg-[#9f1531] text-white text-[13px] font-bold rounded-lg transition-colors mt-1">Buy NFT / Print</button>
                                </div>
                            <% } %>
                        </div>
                    </div>

                </div>
            </div>
        </main>
    </div>
</body>

</html>