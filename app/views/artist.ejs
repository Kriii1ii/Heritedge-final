<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <%- include('partials/head') %>
    <title><%= artist?.name || 'Artist' %> — HeritEdge</title>
    <style>
        /* Hero */
        .hero-fade {
            background: linear-gradient(to bottom,
                rgba(15,6,4,0.1) 0%,
                rgba(15,6,4,0.55) 55%,
                #0f0604 100%);
        }

        /* Skill tags */
        .skill-tag {
            background: rgba(242,185,13,0.08);
            border: 1px solid rgba(242,185,13,0.22);
            color: #f2b90d;
            font-size: 11px;
            font-weight: 700;
            padding: 5px 12px;
            border-radius: 999px;
            letter-spacing: 0.04em;
        }

        /* Info row in sidebar */
        .detail-row {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 14px 0;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }
        .detail-row:last-child { border-bottom: none; padding-bottom: 0; }
        .detail-row:first-child { padding-top: 0; }

        /* Gallery card */
        .gallery-card {
            transition: transform 0.28s cubic-bezier(0.4,0,0.2,1),
                        box-shadow 0.28s cubic-bezier(0.4,0,0.2,1),
                        border-color 0.2s;
        }
        .gallery-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 24px 50px rgba(0,0,0,0.55);
        }

        /* Section heading amber line */
        .section-rule {
            width: 36px; height: 3px;
            background: #f2b90d;
            border-radius: 2px;
            display: inline-block;
        }

        /* Inspiration quote */
        .quote-block {
            border-left: 2px solid rgba(242,185,13,0.3);
            padding-left: 20px;
            position: relative;
        }
    </style>
</head>

<body class="bg-background-dark text-white min-h-screen overflow-x-hidden">
<div class="relative flex min-h-screen w-full flex-col">
    <%- include('partials/header') %>

    <!-- ══════════════════════════════════
         HERO
    ══════════════════════════════════ -->
    <section class="relative w-full min-h-[500px] md:min-h-[580px] flex flex-col justify-end">
        <%
            const coverBg = artworks && artworks.length > 0 && artworks[0].images && artworks[0].images[0]
                ? artworks[0].images[0]
                : '/images/front_page_bg_4.jpg';
        %>
        <div class="absolute inset-0 bg-cover bg-center"
            style="background-image:url('<%= coverBg %>'); filter:brightness(0.45) saturate(1.3);">
        </div>
        <div class="hero-fade absolute inset-0 pointer-events-none"></div>
        <div class="absolute inset-0 pointer-events-none"
            style="background:radial-gradient(ellipse at 30% 80%, rgba(63,16,26,0.4) 0%, transparent 60%)"></div>
        <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-amber-yellow/20 to-transparent pointer-events-none"></div>

        <div class="relative z-10 max-w-[1200px] mx-auto w-full px-6 md:px-12 pb-0">
            <div class="flex flex-col md:flex-row md:items-end gap-6 md:gap-8">

                <!-- Avatar -->
                <div class="shrink-0 -mb-14 md:-mb-16 relative">
                    <div class="w-32 h-32 md:w-40 md:h-40 rounded-2xl overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.7)] border-[3px] border-background-dark ring-2 ring-amber-yellow/25">
                        <img src="<%= artist?.avatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(artist?.name || 'A') + '&background=3f101a&color=f2b90d&size=240&font-size=0.45&bold=true' %>"
                            alt="<%= artist?.name %>"
                            class="w-full h-full object-cover" />
                    </div>
                    <% if (artist?.verificationStatus === 'VERIFIED') { %>
                        <div class="absolute -bottom-1.5 -right-1.5 w-8 h-8 bg-jade-green rounded-full border-2 border-background-dark flex items-center justify-center shadow-lg">
                            <span class="material-symbols-outlined text-white text-[15px]" style="font-variation-settings:'FILL' 1;">verified</span>
                        </div>
                    <% } %>
                </div>

                <!-- Name + meta -->
                <div class="pb-6 flex-1 min-w-0">
                    <div class="flex flex-wrap items-center gap-3 mb-2">
                        <h1 class="text-3xl md:text-[2.6rem] font-bold text-white font-mono-header tracking-tight leading-tight">
                            <%= artist?.name || 'Artist' %>
                        </h1>
                        <% if (artist?.verificationStatus === 'VERIFIED') { %>
                            <span class="text-[10px] font-black text-jade-green bg-jade-green/10 border border-jade-green/25 px-2.5 py-1 rounded-full uppercase tracking-wider shrink-0">Verified</span>
                        <% } %>
                    </div>
                    <% if (artist?.bio) { %>
                        <p class="text-white/65 text-sm md:text-base leading-relaxed max-w-xl line-clamp-2 mb-3">
                            <%= artist.bio %>
                        </p>
                    <% } %>
                    <div class="flex flex-wrap items-center gap-4 text-sm text-white/50">
                        <% if (artist?.region) { %>
                            <span class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-amber-yellow/55 text-[15px]">location_on</span>
                                <%= artist.region %>
                            </span>
                        <% } %>
                        <span class="flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-amber-yellow/55 text-[15px]">workspace_premium</span>
                            <span class="text-amber-yellow/80 font-semibold">HeritEdge Artist</span>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ══════════════════════════════════
         CONTENT
    ══════════════════════════════════ -->
    <main class="flex-1 max-w-[1200px] mx-auto w-full px-6 md:px-12 pt-20 md:pt-24 pb-24">

        <!-- Action bar -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-10 pb-8 border-b border-white/8">
            <div class="flex items-center gap-3 flex-wrap">
                <a href="/marketplace?artist=<%= artist?.id %>"
                    class="flex items-center gap-2 px-5 py-2.5 bg-amber-yellow text-background-dark font-bold text-sm rounded-xl hover:bg-amber-yellow/90 transition-all shadow-lg shadow-amber-yellow/10 font-mono-header">
                    <span class="material-symbols-outlined text-[16px]">storefront</span>
                    Shop Artworks
                </a>
                <button id="follow-btn"
                    onclick="HE.following.toggle(__artistData, this)"
                    class="flex items-center gap-2 px-5 py-2.5 bg-white/5 text-white border border-white/12 font-semibold text-sm rounded-xl hover:bg-white/10 hover:border-white/20 transition-all">
                    <span class="material-symbols-outlined text-[16px]">person_add</span>
                    Follow
                </button>
            </div>
            <a href="/marketplace"
                class="flex items-center gap-1.5 text-white/40 hover:text-amber-yellow text-sm font-medium transition-colors">
                <span class="material-symbols-outlined text-[15px]">arrow_back</span>
                Marketplace
            </a>
        </div>

        <script>
            const __artistData = {
                id: '<%= artist?.id %>',
                name: `<%= (artist?.name || '').replace(/`/g, '\\`') %>`,
                avatar: '<%= artist?.avatar || '' %>'
            };
            document.addEventListener('DOMContentLoaded', () => {
                const btn = document.getElementById('follow-btn');
                if (btn && HE.following.isFollowing(__artistData.id)) {
                    btn.innerHTML = '<span class="material-symbols-outlined text-[16px]">person_check</span> Following';
                    btn.classList.remove('bg-white/5','text-white','border-white/12');
                    btn.classList.add('bg-amber-yellow','text-background-dark','border-amber-yellow');
                }
            });
        </script>

        <!-- Two-column layout -->
        <div class="flex flex-col lg:flex-row gap-10 xl:gap-14">

            <!-- ── SIDEBAR ── -->
            <aside class="w-full lg:w-[280px] xl:w-[300px] shrink-0">

                <!-- Single unified info card -->
                <div class="rounded-2xl overflow-hidden border border-white/8 sticky top-24"
                    style="background:rgba(63,16,26,0.18);">

                    <!-- Bio section -->
                    <% if (artist?.bio) { %>
                        <div class="px-6 pt-6 pb-5 border-b border-white/7">
                            <p class="text-white/45 text-[10px] font-bold uppercase tracking-[0.14em] mb-2">About</p>
                            <p class="text-white/70 text-sm leading-[1.75]"><%= artist.bio %></p>
                        </div>
                    <% } %>

                    <!-- Detail rows -->
                    <div class="px-6 pt-5 pb-6">
                        <p class="text-white/45 text-[10px] font-bold uppercase tracking-[0.14em] mb-4">Artist Details</p>
                        <div class="flex flex-col">

                            <% if (artist?.region) { %>
                            <div class="detail-row">
                                <span class="material-symbols-outlined text-amber-yellow/60 text-[16px] mt-0.5 shrink-0">location_on</span>
                                <div>
                                    <div class="text-white/38 text-[10px] font-bold uppercase tracking-wider mb-0.5">Region</div>
                                    <div class="text-white/80 text-sm"><%= artist.region %></div>
                                </div>
                            </div>
                            <% } %>

                            <div class="detail-row">
                                <span class="material-symbols-outlined text-amber-yellow/60 text-[16px] mt-0.5 shrink-0">verified_user</span>
                                <div>
                                    <div class="text-white/38 text-[10px] font-bold uppercase tracking-wider mb-0.5">Status</div>
                                    <div class="text-sm <%= artist?.verificationStatus === 'VERIFIED' ? 'text-jade-green' : 'text-white/70' %>">
                                        <%= artist?.verificationStatus === 'VERIFIED' ? 'Verified Artist' : 'HeritEdge Member' %>
                                    </div>
                                </div>
                            </div>

                            <% if (artist?.portfolioUrl) { %>
                            <div class="detail-row">
                                <span class="material-symbols-outlined text-amber-yellow/60 text-[16px] mt-0.5 shrink-0">link</span>
                                <div>
                                    <div class="text-white/38 text-[10px] font-bold uppercase tracking-wider mb-0.5">Portfolio</div>
                                    <a href="<%= artist.portfolioUrl %>" target="_blank" rel="noopener"
                                        class="text-amber-yellow text-sm font-medium hover:underline underline-offset-2 truncate block max-w-[180px]">
                                        View Portfolio →
                                    </a>
                                </div>
                            </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Art Forms tags -->
                    <% if (artworks && artworks.length > 0) { %>
                        <% const cats = [...new Set(artworks.map(a => a.category).filter(Boolean))]; %>
                        <% if (cats.length > 0) { %>
                            <div class="px-6 pb-6 border-t border-white/7 pt-5">
                                <p class="text-white/45 text-[10px] font-bold uppercase tracking-[0.14em] mb-3">Art Forms</p>
                                <div class="flex flex-wrap gap-2">
                                    <% cats.forEach(cat => { %>
                                        <span class="skill-tag"><%= cat %></span>
                                    <% }) %>
                                </div>
                            </div>
                        <% } %>
                    <% } %>
                </div>
            </aside>

            <!-- ── MAIN CONTENT ── -->
            <div class="flex-1 min-w-0 flex flex-col gap-14">

                <!-- Inspiration & Vision -->
                <% if (artist?.inspiration) { %>
                    <div>
                        <div class="flex items-center gap-3 mb-5">
                            <span class="section-rule"></span>
                            <p class="text-white/45 text-[11px] font-bold uppercase tracking-[0.18em]">Inspiration & Vision</p>
                        </div>
                        <div class="quote-block">
                            <span class="material-symbols-outlined text-amber-yellow/15 absolute -top-3 -left-3 text-[52px] leading-none select-none"
                                style="font-variation-settings:'FILL' 1;">format_quote</span>
                            <p class="text-white/80 text-lg md:text-xl leading-[1.75] italic font-medium tracking-[0.005em]">
                                "<%= artist.inspiration %>"
                            </p>
                        </div>
                    </div>
                <% } %>

                <!-- Journey & Story -->
                <% if (artist?.lifeStory) { %>
                    <div>
                        <div class="flex items-center gap-3 mb-5">
                            <span class="section-rule"></span>
                            <p class="text-white/45 text-[11px] font-bold uppercase tracking-[0.18em]">Journey & Story</p>
                        </div>
                        <div class="rounded-2xl border border-white/7 px-7 py-6"
                            style="background:rgba(63,16,26,0.18);">
                            <p class="text-white/68 text-base leading-[1.85]">
                                <%= artist.lifeStory %>
                            </p>
                        </div>
                    </div>
                <% } %>

                <!-- No content fallback -->
                <% if (!artist?.bio && !artist?.inspiration && !artist?.lifeStory) { %>
                    <div class="rounded-2xl border border-white/7 p-10 text-center"
                        style="background:rgba(63,16,26,0.15);">
                        <span class="material-symbols-outlined text-5xl text-amber-yellow/15 mb-4 block">auto_stories</span>
                        <p class="text-white/40 text-sm">This artist hasn't shared their story yet.</p>
                    </div>
                <% } %>

                <!-- Artwork Gallery -->
                <div>
                    <div class="flex items-center justify-between gap-4 mb-6">
                        <div class="flex items-center gap-3">
                            <span class="section-rule"></span>
                            <p class="text-white/45 text-[11px] font-bold uppercase tracking-[0.18em]">Artworks</p>
                            <% if (artworks && artworks.length > 0) { %>
                                <span class="text-[11px] font-bold text-amber-yellow/60 bg-amber-yellow/8 border border-amber-yellow/15 px-2.5 py-0.5 rounded-full"><%= artworks.length %></span>
                            <% } %>
                        </div>
                        <% if (artworks && artworks.length > 0) { %>
                            <a href="/marketplace"
                                class="text-white/40 hover:text-amber-yellow text-xs font-bold uppercase tracking-wider transition-colors flex items-center gap-1 group">
                                All Artists
                                <span class="material-symbols-outlined text-[13px] group-hover:translate-x-0.5 transition-transform">arrow_forward</span>
                            </a>
                        <% } %>
                    </div>

                    <% if (artworks && artworks.length > 0) { %>
                        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
                            <% artworks.forEach(art => { %>
                                <div class="gallery-card group flex flex-col rounded-2xl overflow-hidden border border-white/8 hover:border-amber-yellow/30 bg-deep-maroon/20 shadow-lg">

                                    <!-- Image area -->
                                    <div class="relative aspect-square overflow-hidden bg-black/25">
                                        <a href="/artwork/<%= art.id %>">
                                            <img src="<%= art.images && art.images[0] ? art.images[0] : '/images/placeholder.jpg' %>"
                                                alt="<%= art.title %>"
                                                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                                loading="lazy"
                                                onerror="this.src='/images/placeholder.jpg'" />
                                        </a>
                                        <% if (art.category) { %>
                                            <span class="absolute top-3 left-3 bg-black/60 backdrop-blur-sm text-white text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider border border-white/12">
                                                <%= art.category %>
                                            </span>
                                        <% } %>
                                        <!-- Hover overlay with actions -->
                                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-4 gap-2">
                                            <div class="flex gap-2">
                                                <a href="/artwork/<%= art.id %>"
                                                    class="flex-1 py-2 bg-white text-background-dark text-xs font-bold rounded-lg text-center hover:bg-amber-yellow transition-colors uppercase tracking-wide">
                                                    View
                                                </a>
                                                <button
                                                    onclick="HE.cart.add({ id: '<%= art.id %>', title: `<%= art.title.replace(/`/g, '\\`') %>`, price: '<%= art.price %>', image: '<%= art.images && art.images[0] ? art.images[0] : '' %>', creatorName: `<%= (artist?.name || '').replace(/`/g, '\\`') %>` })"
                                                    class="flex-1 py-2 bg-amber-yellow text-background-dark text-xs font-bold rounded-lg text-center hover:bg-white transition-colors uppercase tracking-wide">
                                                    Add to Cart
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Card info -->
                                    <div class="p-4 flex flex-col gap-2.5">
                                        <a href="/artwork/<%= art.id %>">
                                            <h3 class="text-white text-sm font-bold font-mono-header hover:text-amber-yellow transition-colors line-clamp-1 leading-snug">
                                                <%= art.title %>
                                            </h3>
                                        </a>
                                        <% if (art.description) { %>
                                            <p class="text-white/45 text-xs leading-relaxed line-clamp-2"><%= art.description %></p>
                                        <% } %>
                                        <div class="flex items-center justify-between pt-2.5 border-t border-white/7 mt-0.5">
                                            <span class="text-amber-yellow font-bold text-base font-mono">रू <%= art.price %></span>
                                            <div class="flex items-center gap-2">
                                                <button
                                                    onclick="HE.col.toggle({ id: '<%= art.id %>', title: `<%= art.title.replace(/`/g, '\\`') %>`, price: '<%= art.price %>', image: '<%= art.images && art.images[0] ? art.images[0] : '' %>', creatorName: `<%= (artist?.name || '').replace(/`/g, '\\`') %>` }, this)"
                                                    title="Save to Collection"
                                                    class="save-col-btn w-7 h-7 rounded-lg bg-white/5 border border-white/12 flex items-center justify-center text-white/40 hover:text-amber-yellow hover:border-amber-yellow/35 transition-all"
                                                    data-art-id="<%= art.id %>">
                                                    <span class="material-symbols-outlined save-icon text-[14px]">bookmark_add</span>
                                                </button>
                                                <a href="/artwork/<%= art.id %>"
                                                    class="text-xs font-bold text-white/40 hover:text-amber-yellow transition-colors flex items-center gap-0.5">
                                                    Details <span class="material-symbols-outlined text-[13px]">arrow_forward</span>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>

                    <% } else { %>
                        <div class="flex flex-col items-center justify-center py-20 text-center rounded-2xl border border-white/7"
                            style="background:rgba(63,16,26,0.12);">
                            <span class="material-symbols-outlined text-[52px] text-amber-yellow/12 mb-4">palette</span>
                            <p class="text-white/40 text-sm font-medium">No artworks listed yet.</p>
                            <p class="text-white/22 text-xs mt-1">Check back soon.</p>
                        </div>
                    <% } %>
                </div>

            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.save-col-btn').forEach(btn => {
            const id = btn.dataset.artId;
            if (id && HE.col.isSaved(id)) {
                btn.title = 'Remove from Collection';
                btn.classList.add('text-amber-yellow', 'border-amber-yellow/35');
                btn.classList.remove('text-white/40');
                const icon = btn.querySelector('.save-icon');
                if (icon) icon.style.fontVariationSettings = "'FILL' 1";
            }
        });
    });
</script>
</body>

</html>
