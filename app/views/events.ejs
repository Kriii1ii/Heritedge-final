<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <%- include('partials/head') %>
</head>

<body class="bg-background-light dark:bg-background-dark text-white">
    <div class="relative flex h-auto min-h-screen w-full flex-col overflow-x-hidden">
        <%- include('partials/header') %>
            <main class="flex flex-1 w-full max-w-[1440px] mx-auto px-4 lg:px-10 py-8 gap-8">
                <!-- Left Sidebar (30% width) -->
                <aside class="hidden lg:flex flex-col w-[30%] gap-6">
                    <div class="flex flex-col gap-1">
                        <h1 class="text-[#1b170d] dark:text-[#fcfaf8] text-2xl font-bold">Upcoming Events</h1>
                        <p class="text-[#9a804c] text-sm font-normal">Celebrate the vibrant tapestry of Nepal</p>
                    </div>
                    <div class="flex flex-col gap-4 overflow-y-auto pr-2 custom-scrollbar">
                        <!-- Event List Items -->
                        <% if (events && events.length> 0) { %>
                            <% events.forEach((ev, idx)=> { %>
                                <div class="flex items-center gap-4 <%= idx === 0 ? 'bg-[#f3efe7]/50 dark:bg-[#3a3224]/30 border-primary/30' : 'bg-transparent border-transparent hover:bg-[#f3efe7]/50 dark:hover:bg-[#3a3224]/30' %> p-3 rounded-sm border transition-all cursor-pointer"
                                    onclick="window.location.href='/events#event-<%= ev.id %>'">
                                    <div class="bg-center bg-no-repeat aspect-square bg-cover rounded-md size-16 shrink-0 shadow-sm"
                                        style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBNnz6Irt8vT0gbNiaOoxCnp0vdP7vgKvNJfbr7rJtMg6WMnJ7gGVqAHLMDjK55q_52NuLcx_FgL3sNDmOeA59BNm-MEhhJIIj0UpAHaUCFwSqhTg2ZPvbRA0p3GGv8EIOWN42XvU5ndGILRC_VcRanjWBqjhmYMzC4N-_DD4x6RY89FJ3H3erTAw4rGvOYAs-JEgtGIU9rxEJs7heDGeItaPQL0SZWTDLWGUmx6_JPj2c30LMT24qJ-N7HuFHUKS8ojngBUUFVir8");'>
                                    </div>
                                    <div class="flex flex-col justify-center overflow-hidden">
                                        <p
                                            class="text-[#1b170d] dark:text-[#fcfaf8] text-base font-semibold leading-tight truncate">
                                            <%= ev.name %>
                                        </p>
                                        <p class="text-[#9a804c] text-sm font-medium mt-1">
                                            <%= new Date(ev.eventDate).toLocaleDateString() %>
                                        </p>
                                    </div>
                                    <div class="ml-auto">
                                        <span
                                            class="material-symbols-outlined text-[#1b170d] dark:text-[#fcfaf8]">chevron_right</span>
                                    </div>
                                </div>
                                <% }) %>
                                    <% } else { %>
                                        <p class="text-white/50 text-sm">No upcoming events.</p>
                                        <% } %>
                    </div>
                </aside>

                <!-- Main Showcase (70% width) -->
                <section class="flex flex-col w-full lg:w-[70%] gap-12">
                    <% if (events && events.length> 0) { %>
                        <% events.forEach(ev=> { %>
                            <div id="event-<%= ev.id %>"
                                class="relative w-full min-h-[500px] rounded-sm overflow-hidden shadow-2xl group border border-white/10">
                                <!-- Background Image Mock -->
                                <div class="absolute inset-0 bg-center bg-cover scale-100 group-hover:scale-105 transition-transform duration-700"
                                    style='background-image: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.6) 50%, rgba(0,0,0,0.3) 100%), url("https://lh3.googleusercontent.com/aida-public/AB6AXuC2bC9dPoky41mnRsTXWLWxFr0E0RCoBJ5ioz8_eIQdxKy3U2gOg7pcgboBJiGjPckrb9Q9Dsm5QKpH9Lk8-6iC3E7qxt1Ma_Y8joh419zpjVlDHx4EG__MSBn_fggdwcbvJLXndbVJVDuTsjUj6_m2pC6A3qU1HdDN7nNZySWO5Cfx6i04Z-c68olswyr5La32lSwooMtI8eDlbAM5NLm2lGia8Otw8t-wzptRQFCV0hRWli0evY_91CIL3z76vIOU3gdvfJaePFU");'>
                                </div>
                                <!-- Content Overlay -->
                                <div class="relative h-full flex flex-col justify-end p-8 lg:p-12">
                                    <div class="flex flex-col gap-4 max-w-2xl">
                                        <h2 class="text-[#fcfaf8] text-3xl lg:text-5xl font-mono leading-tight pt-mono">
                                            <%= ev.name %>
                                        </h2>
                                        <div class="flex flex-wrap gap-4 text-[#fcfaf8]/90 font-mono text-sm">
                                            <div class="flex items-center gap-2">
                                                <span
                                                    class="material-symbols-outlined text-primary text-lg">calendar_today</span>
                                                <span>
                                                    <%= new Date(ev.eventDate).toLocaleDateString() %> at <%= new
                                                            Date(ev.eventDate).toLocaleTimeString() %>
                                                </span>
                                            </div>
                                            <div class="flex items-center gap-2">
                                                <span
                                                    class="material-symbols-outlined text-primary text-lg">location_on</span>
                                                <span>
                                                    <%= ev.location %>
                                                </span>
                                            </div>
                                            <div class="flex items-center gap-2">
                                                <span
                                                    class="material-symbols-outlined text-primary text-lg">groups</span>
                                                <span>Artists: <%= ev.artists.join(', ') %></span>
                                        </div>
                                    </div>
                                    <p class="text-[#fcfaf8]/80 text-base leading-relaxed mt-2 border-l-2 border-primary pl-4">
                                        <%= ev.description %>
                                    </p>
                                    
                                    <div class="flex gap-4 pt-6">
                                        <% if (locals.user) { %>
                                            <form action="/api/events/<%= ev.id %>/register" method="POST">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit"
                                                    class="px-8 py-3 bg-amber-yellow text-background-dark font-mono-header uppercase font-bold tracking-widest rounded-sm text-sm hover:bg-white transition-colors shadow">
                                                    Register Now
                                                </button>
                                            </form>
                                        <% } else { %>
                                            <a href="/login"
                                                class="px-8 py-3 bg-white/10 text-white border border-white/20 font-mono-header uppercase font-bold tracking-widest rounded-sm text-sm hover:bg-white/20 transition-colors text-center inline-block">
                                                Login to Register
                                            </a>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    <% } %>
                </section>
            </main>
    </div>
</body>

</html>