<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <%- include('../partials/head') %>
  <title><%= user.name %> — Creator Dashboard</title>
</head>
<body class="min-h-screen text-white" style="background:#0a0401;">
<div class="flex min-h-screen">

  <%- include('../partials/creator-nav', { currentPage: 'home' }) %>

  <!-- Main -->
  <div class="flex-1 min-h-screen flex flex-col" style="margin-left:0;">
    <div class="lg:ml-[220px]">
      <main class="px-5 py-6 pt-20 lg:pt-8 lg:px-8 max-w-[1060px]">

        <!-- Page heading -->
        <div class="mb-8">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] mb-1.5 font-mono-header" style="color:rgba(242,185,13,0.55);">Creator Dashboard</p>
          <h1 class="text-2xl md:text-[1.9rem] font-bold text-white font-mono-header leading-tight">
            Welcome back, <%= user.name.split(' ')[0] %>.
          </h1>
          <p class="text-white/40 text-sm mt-1">Here's a snapshot of your creator activity.</p>
        </div>

        <!-- Stat cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
          <div class="rounded-xl p-5 flex flex-col gap-1" style="background:rgba(63,16,26,0.25); border:1px solid rgba(255,255,255,0.07);">
            <div class="flex items-center justify-between mb-2">
              <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-white/35 font-mono-header">Artworks Listed</span>
              <span class="material-symbols-outlined text-[20px]" style="color:rgba(242,185,13,0.55);">palette</span>
            </div>
            <p class="text-3xl font-bold text-white font-mono"><%= totalArtworks %></p>
            <p class="text-white/30 text-xs mt-0.5 font-mono-header">Total pieces</p>
          </div>
          <div class="rounded-xl p-5 flex flex-col gap-1" style="background:rgba(63,16,26,0.25); border:1px solid rgba(255,255,255,0.07);">
            <div class="flex items-center justify-between mb-2">
              <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-white/35 font-mono-header">Total Sales</span>
              <span class="material-symbols-outlined text-[20px]" style="color:rgba(0,168,107,0.65);">shopping_bag</span>
            </div>
            <p class="text-3xl font-bold text-white font-mono"><%= totalSales %></p>
            <p class="text-white/30 text-xs mt-0.5 font-mono-header">Completed orders</p>
          </div>
          <div class="rounded-xl p-5 flex flex-col gap-1" style="background:rgba(63,16,26,0.25); border:1px solid rgba(255,255,255,0.07);">
            <div class="flex items-center justify-between mb-2">
              <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-white/35 font-mono-header">Total Revenue</span>
              <span class="material-symbols-outlined text-[20px]" style="color:rgba(242,185,13,0.55);">payments</span>
            </div>
            <p class="text-3xl font-bold text-white font-mono">रू <%= (revenueSum || 0).toLocaleString() %></p>
            <p class="text-white/30 text-xs mt-0.5 font-mono-header">From completed sales</p>
          </div>
        </div>

        <!-- Quick actions -->
        <div class="flex flex-wrap gap-3 mb-10">
          <a href="/creator/upload"
             class="flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold text-background-dark transition-all hover:opacity-90 shadow-lg"
             style="background:#f2b90d;">
            <span class="material-symbols-outlined text-[16px]">add_photo_alternate</span>
            Add Artwork
          </a>
          <a href="/creator/analytics"
             class="flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold text-white/80 transition-all hover:text-white hover:bg-white/8"
             style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1);">
            <span class="material-symbols-outlined text-[16px]">bar_chart</span>
            View Analytics
          </a>
          <a href="/creator/profile-edit"
             class="flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold text-white/80 transition-all hover:text-white hover:bg-white/8"
             style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1);">
            <span class="material-symbols-outlined text-[16px]">manage_accounts</span>
            Edit Profile
          </a>
        </div>

        <!-- Recent artworks -->
        <div>
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-base font-bold text-white font-mono-header uppercase tracking-wider">Recent Artworks</h2>
            <a href="/creator/artworks" class="text-amber-yellow text-xs font-bold hover:underline flex items-center gap-1 font-mono-header">
              View all <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
            </a>
          </div>

          <% if (artworks && artworks.length > 0) { %>
            <div class="rounded-xl overflow-hidden" style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.07);">
              <div class="divide-y" style="divide-color:rgba(255,255,255,0.05);">
                <% artworks.forEach(art => { %>
                  <div class="flex items-center gap-5 px-5 py-4 hover:bg-white/3 transition-colors">
                    <div class="w-14 h-14 rounded-lg overflow-hidden flex-shrink-0" style="border:1px solid rgba(255,255,255,0.1);">
                      <img src="<%= art.images && art.images[0] ? art.images[0] : '/images/placeholder.jpg' %>"
                           class="w-full h-full object-cover" alt="">
                    </div>
                    <div class="flex-1 min-w-0">
                      <p class="text-white font-bold text-sm font-mono-header truncate mb-1"><%= art.title %></p>
                      <div class="flex items-center gap-2">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-white/35 border border-white/10 px-2 py-0.5 rounded-full"><%= art.category %></span>
                        <span class="text-[10px] font-bold uppercase tracking-wider <%= art.status === 'PUBLISHED' ? 'text-jade-green' : 'text-white/35' %>">
                          <% if (art.status === 'PUBLISHED') { %><span class="inline-block w-1.5 h-1.5 bg-jade-green rounded-full mr-1 -mb-0.5"></span><% } %>
                          <%= art.status %>
                        </span>
                      </div>
                    </div>
                    <div class="text-right flex-shrink-0">
                      <p class="text-amber-yellow font-bold font-mono text-base">रू <%= parseFloat(art.price || 0).toLocaleString() %></p>
                      <p class="text-white/25 text-[10px] font-mono-header"><%= new Date(art.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></p>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } else { %>
            <div class="rounded-xl flex flex-col items-center justify-center py-16 text-center"
                 style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);">
              <span class="material-symbols-outlined mb-4 text-white/10" style="font-size:52px;">art_track</span>
              <p class="text-white/35 text-sm font-semibold mb-1">Your gallery is empty</p>
              <p class="text-white/25 text-xs mb-6">List your first artwork to start selling.</p>
              <a href="/creator/upload"
                 class="px-6 py-2.5 rounded-xl text-sm font-bold text-background-dark"
                 style="background:#f2b90d;">
                Add your first artwork
              </a>
            </div>
          <% } %>
        </div>

      </main>
    </div>
  </div>
</div>
</body>
</html>
