<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <%- include('../partials/head') %>
</head>

<body class="bg-background-light dark:bg-background-dark text-white min-h-screen">
    <div class="relative flex h-auto min-h-screen w-full flex-col overflow-x-hidden">
        <%- include('../partials/header') %>
            <main class="flex flex-1 justify-center py-8 px-4 md:px-10">
                <div class="layout-content-container flex flex-col max-w-[1200px] flex-1">
                    <div class="flex flex-wrap justify-between gap-3 mb-8">
                        <div class="flex min-w-72 flex-col gap-1">
                            <p
                                class="text-white text-4xl font-black leading-tight font-mono-header bg-gradient-to-r from-amber-yellow to-dusty-rose bg-clip-text text-transparent">
                                Creator Dashboard</p>
                            <p class="text-white/60 text-base font-mono">Welcome back, <%= user.name %>! Track your
                                    journey and sales.</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-10">
                        <div class="flex flex-col gap-2 rounded-sm p-6 border border-white/10 bg-deep-maroon shadow-sm shadow-black/20">
                            <div class="flex items-center justify-between mb-2">
                                <p class="text-white/60 text-xs font-bold uppercase tracking-widest font-mono-header">Artworks Listed</p>
                                <span class="material-symbols-outlined text-amber-yellow text-2xl">palette</span>
                            </div>
                            <p class="text-white tracking-light text-3xl font-bold font-mono">
                                <%= totalArtworks %>
                            </p>
                        </div>
                        <div class="flex flex-col gap-2 rounded-sm p-6 border border-white/10 bg-deep-maroon shadow-sm shadow-black/20">
                            <div class="flex items-center justify-between mb-2">
                                <p class="text-white/60 text-xs font-bold uppercase tracking-widest font-mono-header">Total Sales</p>
                                <span class="material-symbols-outlined text-amber-yellow text-2xl">shopping_cart</span>
                            </div>
                            <p class="text-white tracking-light text-3xl font-bold font-mono">
                                <%= totalSales %>
                            </p>
                        </div>
                        <div class="flex flex-col gap-2 rounded-sm p-6 border border-white/10 bg-deep-maroon shadow-sm shadow-black/20">
                            <div class="flex items-center justify-between mb-2">
                                <p class="text-white/60 text-xs font-bold uppercase tracking-widest font-mono-header">Total Revenue</p>
                                <span class="material-symbols-outlined text-amber-yellow text-2xl">account_balance</span>
                            </div>
                            <p class="text-white tracking-light text-3xl font-bold font-mono">रू <%= (revenueSum || 0).toLocaleString() %>
                            </p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
                        <div class="lg:col-span-1 flex flex-col">
                            <div class="px-2 pb-4 border-b border-white/10 mb-4">
                                <h2 class="text-white text-[20px] font-bold tracking-tight font-mono-header uppercase">Creator Identity</h2>
                            </div>
                            <form action="/creator/onboarding" method="POST"
                                class="bg-white/5 p-8 rounded-sm border border-white/10 shadow-lg">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                
                                <div class="space-y-6">
                                    <div>
                                        <label class="text-[10px] text-white/40 uppercase tracking-[0.2em] mb-2 block font-bold font-mono-header">Your Heritage Story</label>
                                        <textarea name="story" rows="6"
                                            class="w-full bg-black/30 text-white border border-white/10 p-4 rounded-sm focus:border-amber-yellow focus:ring-1 focus:ring-amber-yellow outline-none placeholder:text-white/10 text-sm font-mono leading-relaxed"
                                            placeholder="Tell potential buyers about your journey..."><%= user.bio %></textarea>
                                    </div>

                                    <div>
                                        <label class="text-[10px] text-white/40 uppercase tracking-[0.2em] mb-2 block font-bold font-mono-header">Primary Region</label>
                                        <input type="text" name="region" value="<%= user.region || '' %>"
                                            class="w-full bg-black/30 text-white border border-white/10 p-4 rounded-sm focus:border-amber-yellow outline-none text-sm font-mono"
                                            placeholder="e.g. Bhaktapur, Nepal">
                                    </div>

                                    <button type="submit"
                                        class="mt-4 px-6 py-4 bg-amber-yellow text-background-dark font-bold font-mono-header uppercase tracking-widest text-xs hover:bg-white rounded-none transition-all w-full shadow-lg hover:translate-y-[-2px] active:translate-y-0">
                                        Update Creator Profile
                                    </button>
                                </div>
                            </form>
                        </div>

                        <div class="lg:col-span-2 flex flex-col">
                            <div class="flex items-center justify-between px-2 pb-4 border-b border-white/10 mb-4">
                                <h2 class="text-white text-[20px] font-bold tracking-tight font-mono-header uppercase">Recent Collections</h2>
                                <a href="/creator/upload" class="text-amber-yellow hover:text-white text-xs font-bold font-mono-header uppercase tracking-widest transition-colors flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">add</span> Add New
                                </a>
                            </div>
                            <div class="bg-white/5 rounded-sm border border-white/10 shadow-lg overflow-hidden">
                                <% if (artworks && artworks.length > 0) { %>
                                    <div class="divide-y divide-white/5">
                                        <% artworks.forEach(art => { %>
                                            <div class="flex items-center gap-6 p-5 hover:bg-white/5 transition-colors">
                                                <div class="h-16 w-16 rounded bg-black/50 overflow-hidden shrink-0 border border-white/10">
                                                    <img src="<%= art.images && art.images[0] ? art.images[0] : '/images/placeholder.jpg' %>" class="w-full h-full object-cover">
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <p class="text-white font-bold font-mono-header text-base mb-1 truncate">
                                                        <%= art.title %>
                                                    </p>
                                                    <div class="flex items-center gap-2">
                                                        <span class="text-[10px] uppercase font-bold tracking-[0.1em] text-white/40 border border-white/10 px-2 py-0.5 rounded-none"><%= art.category %></span>
                                                        <span class="text-[10px] uppercase font-bold tracking-[0.1em] <%= art.status === 'PUBLISHED' ? 'text- jade-green' : 'text-dusty-rose' %>"><%= art.status %></span>
                                                    </div>
                                                </div>
                                                <div class="text-right">
                                                    <p class="text-amber-yellow font-bold font-mono text-lg">रू <%= (art.price || 0).toLocaleString() %></p>
                                                    <p class="text-[9px] uppercase tracking-tighter text-white/30 font-mono-header">
                                                        Listed on <%= new Date(art.createdAt).toLocaleDateString() %>
                                                    </p>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>
                                <% } else { %>
                                    <div class="flex flex-col items-center justify-center p-16 text-center">
                                        <span class="material-symbols-outlined text-white/10 text-6xl mb-4">art_track</span>
                                        <p class="text-white/30 italic font-mono-header mb-6">Your gallery is currently empty.</p>
                                        <a href="/creator/upload" class="px-8 py-3 border border-amber-yellow text-amber-yellow hover:bg-amber-yellow hover:text-background-dark transition-all font-mono-header text-xs font-bold uppercase tracking-widest">
                                            List your first artwork
                                        </a>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
                <%- include('../partials/footer') %>
</div>
</body>

</html>