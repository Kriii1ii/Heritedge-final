<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <%- include('../partials/head') %>
  <title>Add Artwork — Creator Dashboard</title>
  <style>
    .upload-input {
      width: 100%;
      background: rgba(0,0,0,0.25);
      color: #fff;
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 0.75rem;
      padding: 12px 16px;
      font-size: 0.9rem;
      outline: none;
      transition: border-color 0.15s;
      -webkit-text-fill-color: #fff;
    }
    .upload-input:focus { border-color: #f2b90d; }
    .upload-input::placeholder { color: rgba(255,255,255,0.2); }
    .upload-input option { background: #1a0b06; color: #fff; }
    .upload-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.4);
      margin-bottom: 7px;
    }
    #preview-strip { gap: 10px; }
    .preview-thumb { position: relative; width: 90px; height: 90px; border-radius: 10px; overflow: hidden; flex-shrink: 0; border: 1px solid rgba(255,255,255,0.12); }
    .preview-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .preview-thumb .rm-btn {
      position: absolute; top: 3px; right: 3px;
      width: 20px; height: 20px; border-radius: 50%;
      background: rgba(0,0,0,0.7); color: #f87171;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; font-size: 12px; font-weight: 900;
      border: none; outline: none;
    }
  </style>
</head>
<body class="min-h-screen text-white" style="background:#0a0401;">
<div class="flex min-h-screen">

  <%- include('../partials/creator-nav', { currentPage: 'upload' }) %>

  <div class="flex-1 min-h-screen">
    <div class="lg:ml-[220px]">
      <main class="px-5 py-6 pt-20 lg:pt-8 lg:px-8 max-w-[800px]">

        <!-- Header -->
        <div class="mb-8">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] mb-1.5 font-mono-header" style="color:rgba(242,185,13,0.55);">Creator Dashboard</p>
          <h1 class="text-2xl font-bold text-white font-mono-header">Add Artwork</h1>
          <p class="text-white/40 text-sm mt-1">Fill in the details and upload images to list your piece.</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="flex items-start gap-3 p-4 rounded-xl mb-6 text-sm"
               style="background:rgba(248,113,113,0.1); border:1px solid rgba(248,113,113,0.2);">
            <span class="material-symbols-outlined text-red-400 text-[18px] flex-shrink-0 mt-0.5">error</span>
            <p class="text-red-300"><%= error %></p>
          </div>
        <% } %>

        <form action="/creator/upload?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data"
              class="space-y-6" id="upload-form">

          <!-- Title + Price -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="upload-label">Artwork Title *</label>
              <input type="text" name="title" required placeholder="e.g. Dancing Kumari" class="upload-input">
            </div>
            <div>
              <label class="upload-label">Price (रू) *</label>
              <input type="number" name="price" required min="1" step="1" placeholder="e.g. 12000" class="upload-input"
                     oninput="if(this.value < 0) this.value = ''">
            </div>
          </div>

          <!-- Category + Region -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="upload-label">Category *</label>
              <select name="category" required class="upload-input">
                <option value="Thangka">Thangka Painting</option>
                <option value="Digital Painting">Digital Painting</option>
                <option value="Traditional Painting">Traditional Painting</option>
                <option value="Abstract">Abstract</option>
                <option value="Sculpture">Sculpture</option>
                <option value="Pottery">Pottery</option>
                <option value="Photography">Photography</option>
                <option value="Textile">Textile / Weaving</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div>
              <label class="upload-label">Region Inspiration *</label>
              <input type="text" name="region" required placeholder="e.g. Bhaktapur, Nepal" class="upload-input">
            </div>
          </div>

          <!-- Image upload -->
          <div>
            <label class="upload-label">Artwork Images * <span class="normal-case text-white/25 tracking-normal">(1–5 files, max 5 MB each)</span></label>
            <div class="relative rounded-xl overflow-hidden cursor-pointer group"
                 style="background:rgba(0,0,0,0.2); border:1.5px dashed rgba(255,255,255,0.14);"
                 onclick="document.getElementById('img-input').click()">
              <div class="py-8 flex flex-col items-center gap-2 group-hover:bg-white/3 transition-colors">
                <span class="material-symbols-outlined text-white/20 group-hover:text-amber-yellow/40 transition-colors"
                      style="font-size:38px;">add_photo_alternate</span>
                <p class="text-white/40 text-sm font-semibold group-hover:text-white/60 transition-colors">Click to select images</p>
                <p class="text-white/25 text-xs">JPEG, PNG, WebP accepted</p>
              </div>
              <input type="file" id="img-input" name="images" accept="image/jpeg,image/png,image/webp" multiple required
                     class="hidden" onchange="previewImages(this)">
            </div>
            <!-- Preview strip -->
            <div id="preview-strip" class="flex flex-wrap mt-3 hidden"></div>
          </div>

          <!-- Description -->
          <div>
            <label class="upload-label">Description & Meaning *</label>
            <textarea name="description" rows="4" required placeholder="Describe the artwork's symbolism, technique, and cultural significance..."
                      class="upload-input" style="resize:vertical;"></textarea>
          </div>

          <!-- Creative Story (optional) -->
          <div>
            <label class="upload-label">Creative Story <span class="normal-case text-white/20 tracking-normal">(optional)</span></label>
            <textarea name="story" rows="3" placeholder="Share your process, inspiration, or the story behind this piece..."
                      class="upload-input" style="resize:vertical;"></textarea>
          </div>

          <!-- Submit -->
          <div class="flex items-center justify-end gap-4 pt-4" style="border-top:1px solid rgba(255,255,255,0.07);">
            <a href="/creator/artworks" class="text-white/40 hover:text-white text-sm font-semibold transition-colors">Cancel</a>
            <button type="submit"
              class="flex items-center gap-2 px-7 py-3 rounded-xl text-sm font-bold text-background-dark transition-all hover:opacity-90 shadow-lg"
              style="background:#f2b90d;">
              <span class="material-symbols-outlined text-[16px]">publish</span>
              List for Sale
            </button>
          </div>
        </form>

      </main>
    </div>
  </div>
</div>

<script>
function previewImages(input) {
  const strip = document.getElementById('preview-strip');
  strip.innerHTML = '';
  if (!input.files || !input.files.length) { strip.classList.add('hidden'); return; }
  strip.classList.remove('hidden');
  Array.from(input.files).slice(0, 5).forEach((file, i) => {
    const reader = new FileReader();
    reader.onload = e => {
      const thumb = document.createElement('div');
      thumb.className = 'preview-thumb';
      thumb.innerHTML = `<img src="${e.target.result}" alt="preview ${i+1}">`;
      strip.appendChild(thumb);
    };
    reader.readAsDataURL(file);
  });
}
</script>
</body>
</html>
