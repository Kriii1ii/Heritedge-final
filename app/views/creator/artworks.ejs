<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <%- include('../partials/head') %>
  <title>My Artworks — Creator Dashboard</title>
  <style>
    .art-card { transition: transform 0.22s cubic-bezier(.4,0,.2,1), box-shadow 0.22s; }
    .art-card:hover { transform: translateY(-3px); box-shadow: 0 20px 45px rgba(0,0,0,0.5); }
  </style>
</head>
<body class="min-h-screen text-white" style="background:#0a0401;">
<div class="flex min-h-screen">

  <%- include('../partials/creator-nav', { currentPage: 'artworks' }) %>

  <div class="flex-1 min-h-screen">
    <div class="lg:ml-[220px]">
      <main class="px-5 py-6 pt-20 lg:pt-8 lg:px-8 max-w-[1060px]">

        <!-- Header -->
        <div class="flex items-start justify-between mb-8 gap-4 flex-wrap">
          <div>
            <p class="text-[10px] font-bold uppercase tracking-[0.2em] mb-1.5 font-mono-header" style="color:rgba(242,185,13,0.55);">Creator Dashboard</p>
            <h1 class="text-2xl font-bold text-white font-mono-header">My Artworks</h1>
            <p class="text-white/40 text-sm mt-1">
              <% const pub = artworks ? artworks.filter(a => a.status === 'PUBLISHED').length : 0; %>
              <% const dft = artworks ? artworks.filter(a => a.status === 'DRAFT').length : 0; %>
              <span class="text-jade-green font-semibold"><%= pub %> published</span>
              <span class="text-white/25 mx-1.5">·</span>
              <span class="text-white/40"><%= dft %> draft</span>
            </p>
          </div>
          <a href="/creator/upload"
             class="flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold text-background-dark flex-shrink-0"
             style="background:#f2b90d;">
            <span class="material-symbols-outlined text-[16px]">add</span>
            New Artwork
          </a>
        </div>

        <% if (artworks && artworks.length > 0) { %>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            <% artworks.forEach(art => { %>
              <div class="art-card rounded-xl overflow-hidden flex flex-col" style="background:rgba(63,16,26,0.22); border:1px solid rgba(255,255,255,0.08);">

                <!-- Image -->
                <div class="relative h-[190px] bg-black/30 overflow-hidden">
                  <img src="<%= art.images && art.images[0] ? art.images[0] : '/images/placeholder.jpg' %>"
                       class="w-full h-full object-cover" alt="<%= art.title %>">
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                  <!-- Status badge -->
                  <div class="absolute top-3 right-3">
                    <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full
                      <%= art.status === 'PUBLISHED' ? 'text-jade-green bg-jade-green/15 border border-jade-green/25' : 'text-white/50 bg-white/8 border border-white/12' %>">
                      <%= art.status === 'PUBLISHED' ? '● Published' : '○ Draft' %>
                    </span>
                  </div>
                </div>

                <!-- Info -->
                <div class="p-4 flex flex-col flex-1">
                  <h3 class="text-white font-bold text-sm font-mono-header truncate mb-1"><%= art.title %></h3>
                  <p class="text-white/35 text-[11px] font-bold uppercase tracking-wider mb-3"><%= art.category %></p>
                  <p class="text-amber-yellow font-bold font-mono text-lg mt-auto mb-4">रू <%= parseFloat(art.price || 0).toLocaleString() %></p>

                  <!-- Actions -->
                  <div class="flex items-center gap-2 pt-3" style="border-top:1px solid rgba(255,255,255,0.07);">
                    <form action="/creator/artworks/<%= art.id %>/status" method="POST" class="flex-1">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="status" value="<%= art.status === 'PUBLISHED' ? 'DRAFT' : 'PUBLISHED' %>">
                      <button type="submit"
                        class="w-full text-xs font-bold py-2 rounded-lg transition-colors text-center
                          <%= art.status === 'PUBLISHED'
                            ? 'text-white/60 hover:text-white hover:bg-white/8 border border-white/10'
                            : 'text-jade-green hover:bg-jade-green/10 border border-jade-green/20' %>"
                        style="background:transparent;">
                        <%= art.status === 'PUBLISHED' ? 'Unpublish' : 'Publish' %>
                      </button>
                    </form>
                    <form action="/creator/artworks/<%= art.id %>/delete" method="POST" class="flex-shrink-0"
                          onsubmit="return confirm('Delete \'<%= art.title.replace(/'/g, "\\'") %>\'? This cannot be undone.');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit"
                        class="p-2 rounded-lg transition-colors text-red-500/60 hover:text-red-400 hover:bg-red-500/10 border border-red-500/15">
                        <span class="material-symbols-outlined text-[16px]">delete</span>
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="rounded-xl flex flex-col items-center justify-center py-20 text-center"
               style="background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);">
            <span class="material-symbols-outlined mb-4 text-white/10" style="font-size:56px;">image</span>
            <p class="text-white/40 text-base font-semibold mb-1">No artworks yet</p>
            <p class="text-white/25 text-sm mb-6">Upload your first piece to start your gallery.</p>
            <a href="/creator/upload"
               class="px-7 py-2.5 rounded-xl text-sm font-bold text-background-dark"
               style="background:#f2b90d;">
              Upload Artwork
            </a>
          </div>
        <% } %>

      </main>
    </div>
  </div>
</div>
</body>
</html>
