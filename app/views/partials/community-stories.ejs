<!-- ── STORY MODAL ── -->
<style>
    #story-modal-content {
        will-change: transform, opacity;
    }
    #story-modal-image::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(to right, transparent 60%, #0f0604 100%);
    }
    @media (max-width: 768px) {
        #story-modal-image::after {
            background: linear-gradient(to bottom, transparent 60%, #0f0604 100%);
        }
    }
    @keyframes modalIn {
        from { opacity: 0; transform: scale(0.94) translateY(12px); }
        to   { opacity: 1; transform: scale(1) translateY(0); }
    }
    @keyframes backdropIn {
        from { opacity: 0; }
        to   { opacity: 1; }
    }
    #story-modal.open #story-modal-backdrop { animation: backdropIn 0.3s ease forwards; }
    #story-modal.open #story-modal-content  { animation: modalIn 0.35s cubic-bezier(0.34, 1.2, 0.64, 1) forwards; }
</style>

<div id="story-modal" class="fixed inset-0 z-[200] hidden items-center justify-center p-4 md:p-8"
    role="dialog" aria-modal="true" aria-labelledby="story-modal-name">

    <!-- Backdrop -->
    <div id="story-modal-backdrop"
        class="absolute inset-0 bg-black/85 backdrop-blur-[6px] cursor-pointer"
        onclick="closeStoryModal()"></div>

    <!-- Modal -->
    <div id="story-modal-content"
        class="relative z-10 w-full max-w-[880px] flex flex-col md:flex-row overflow-hidden rounded-3xl shadow-[0_40px_100px_rgba(0,0,0,0.8)] border border-white/8 max-h-[92vh]"
        style="background: #0f0604;">

        <!-- Close -->
        <button onclick="closeStoryModal()" aria-label="Close"
            class="absolute top-4 right-4 z-30 w-10 h-10 rounded-full bg-white/10 hover:bg-amber-yellow hover:text-background-dark text-white/60 flex items-center justify-center transition-all duration-200 hover:scale-110 border border-white/15 backdrop-blur-sm">
            <span class="material-symbols-outlined text-[18px]">close</span>
        </button>

        <!-- Left: Full image -->
        <div id="story-modal-image"
            class="w-full md:w-[42%] min-h-[240px] md:min-h-full shrink-0 bg-cover bg-center relative">
        </div>

        <!-- Right: Story content -->
        <div class="flex-1 flex flex-col justify-between p-7 md:p-10 lg:p-12 overflow-y-auto">

            <!-- Decorative quote mark -->
            <div class="flex flex-col gap-5 flex-1">
                <div class="flex items-start gap-1">
                    <span class="material-symbols-outlined text-amber-yellow/20 text-[56px] leading-none select-none -mt-2 -ml-1 shrink-0" style="font-variation-settings:'FILL' 1;">format_quote</span>
                </div>

                <p id="story-modal-text"
                    class="text-white text-[17px] md:text-[18px] italic font-normal leading-[1.8] tracking-[0.005em] flex-1 border-l-[2px] border-amber-yellow/30 pl-5">
                </p>
            </div>

            <!-- Artist signature -->
            <div class="mt-8 pt-6 border-t border-white/10">
                <div class="flex items-center gap-4">
                    <div id="story-modal-avatar"
                        class="w-14 h-14 rounded-full bg-cover bg-center shrink-0 border-2 border-amber-yellow/30 shadow-lg">
                    </div>
                    <div>
                        <p id="story-modal-name" class="text-amber-yellow text-xl font-bold font-mono-header leading-tight tracking-tight"></p>
                        <p id="story-modal-role" class="text-white/60 text-[11px] font-bold uppercase tracking-[0.14em] mt-1"></p>
                    </div>
                    <div class="ml-auto">
                        <span class="material-symbols-outlined text-amber-yellow/20 text-[32px]" style="font-variation-settings:'FILL' 1;">verified</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function openStoryModal(name, role, imageUrl, fullText) {
        const modal = document.getElementById('story-modal');
        document.getElementById('story-modal-name').textContent = name;
        document.getElementById('story-modal-role').textContent = role;
        document.getElementById('story-modal-text').textContent = '“' + fullText + '”';
        document.getElementById('story-modal-image').style.backgroundImage = `url('${imageUrl}')`;
        document.getElementById('story-modal-avatar').style.backgroundImage = `url('${imageUrl}')`;

        modal.classList.remove('hidden');
        modal.classList.add('flex', 'open');
        document.body.style.overflow = 'hidden';
    }

    function closeStoryModal() {
        const modal = document.getElementById('story-modal');
        const content = document.getElementById('story-modal-content');

        content.style.animation = 'none';
        content.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
        content.style.opacity = '0';
        content.style.transform = 'scale(0.96) translateY(8px)';

        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex', 'open');
            content.style.animation = '';
            content.style.transition = '';
            content.style.opacity = '';
            content.style.transform = '';
            document.body.style.overflow = '';
        }, 220);
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !document.getElementById('story-modal').classList.contains('hidden')) {
            closeStoryModal();
        }
    });
    document.getElementById('story-modal-content')?.addEventListener('click', (e) => e.stopPropagation());
</script>
