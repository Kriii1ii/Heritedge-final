<!-- Community Stories Section -->
<div class="flex items-center justify-between px-4 md:px-0 pb-6">
    <h2 class="text-white text-3xl font-bold font-mono-header">
        Community Stories</h2>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 px-4 md:px-0">
    <!-- Artist 1 -->
    <div onclick="openStoryModal('Sita Thapa', 'TRADITIONAL POTTER • BHAKTAPUR', '/images/sitathapa.jpg', 'Each piece of clay carries the weight of generations. Through HeritEdge, my craft now reaches hands across the ocean. Growing up in Bhaktapur, the potter\'s wheel was the center of our household. Each piece of clay I shape carries the wisdom of generations before me. Through HeritEdge, my craft reaches hands globally, ensuring that our ancestral techniques survive and provide a sustainable future for my family.')"
        class="flex flex-col gap-4 group cursor-pointer bg-deep-maroon/20 p-4 rounded-sm border border-rich-red/30 hover:border-amber-yellow transition-all shadow-lg hover:shadow-amber-yellow/10">
        <div class="w-full bg-center bg-no-repeat aspect-[4/5] bg-cover rounded-md overflow-hidden border-2 border-rich-red"
            style='background-image: url("/images/sitathapa.jpg");'>
            <div class="w-full h-full bg-black/20 group-hover:bg-transparent transition-all"></div>
        </div>
        <div class="space-y-1">
            <p class="text-white text-xl font-bold font-mono-header group-hover:text-amber-yellow transition-colors">Sita Thapa</p>
            <p class="text-dusty-rose text-sm font-medium uppercase tracking-wider">Traditional Potter • Bhaktapur</p>
            <p class="text-white/70 text-sm line-clamp-2 mt-2 italic flex-grow">"Each piece of clay carries the weight of generations. Through HeritEdge, my craft now reaches hands across the ocean..."</p>
        </div>
    </div>
    <!-- Artist 2 -->
    <div onclick="openStoryModal('Maya Devi', 'THANGKA ARTIST • PATAN', '/images/mayadevi.jpeg', 'Painting is my meditation. I paint the stories of the Buddha to preserve our spiritual identity. For many years, Thangka painting was a male-dominated field, but I insisted on learning. Now, I run my own workshop in Patan, teaching other young women the sacred geometry and intense focus required to master this art form. HeritEdge has given us a voice and financial independence.')"
        class="flex flex-col gap-4 group cursor-pointer bg-deep-maroon/20 p-4 rounded-sm border border-rich-red/30 hover:border-amber-yellow transition-all shadow-lg hover:shadow-amber-yellow/10">
        <div class="w-full bg-center bg-no-repeat aspect-[4/5] bg-cover rounded-md overflow-hidden border-2 border-rich-red"
            style='background-image: url("/images/mayadevi.jpeg");'>
            <div class="w-full h-full bg-black/20 group-hover:bg-transparent transition-all"></div>
        </div>
        <div class="space-y-1">
            <p class="text-white text-xl font-bold font-mono-header group-hover:text-amber-yellow transition-colors">Maya Devi</p>
            <p class="text-dusty-rose text-sm font-medium uppercase tracking-wider">Thangka Artist • Patan</p>
            <p class="text-white/70 text-sm line-clamp-2 mt-2 italic flex-grow">"Painting is my meditation. I paint the stories of the Buddha to preserve our spiritual identity..."</p>
        </div>
    </div>
    <!-- Artist 3 -->
    <div onclick="openStoryModal('Anjali Rai', 'CONTEMPORARY PAINTER • KATHMANDU', '/images/anjalirai.jpg', 'I blend traditional motifs with modern struggles to give voice to the unspoken stories of Himalayan women. As a contemporary artist, I want to challenge the boundaries of what Nepali art looks like, while still honoring our rich aesthetic past. Through my canvases, I paint the resilience, the silence, and the quiet power of the women who raised me. Joining HeritEdge connected me with collectors who truly understand my vision.')"
        class="flex flex-col gap-4 group cursor-pointer bg-deep-maroon/20 p-4 rounded-sm border border-rich-red/30 hover:border-amber-yellow transition-all shadow-lg hover:shadow-amber-yellow/10">
        <div class="w-full bg-center bg-no-repeat aspect-[4/5] bg-cover rounded-md overflow-hidden border-2 border-rich-red"
            style='background-image: url("/images/anjalirai.jpg");'>
            <div class="w-full h-full bg-black/20 group-hover:bg-transparent transition-all"></div>
        </div>
        <div class="space-y-1">
            <p class="text-white text-xl font-bold font-mono-header group-hover:text-amber-yellow transition-colors">Anjali Rai</p>
            <p class="text-dusty-rose text-sm font-medium uppercase tracking-wider">Contemporary Painter • Kathmandu</p>
            <p class="text-white/70 text-sm line-clamp-2 mt-2 italic flex-grow">"I blend traditional motifs with modern struggles to give voice to the unspoken stories of Himalayan women..."</p>
        </div>
    </div>
</div>

<!-- Modal Container -->
<div id="story-modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4">
    <div id="story-modal-backdrop" class="absolute inset-0 bg-black/70 backdrop-blur-md cursor-pointer transition-opacity duration-300 opacity-0" onclick="closeStoryModal()"></div>
    
    <div id="story-modal-content" class="relative z-10 w-full md:w-1/2 max-w-4xl bg-deep-maroon border border-amber-yellow/50 rounded-md shadow-2xl scale-95 opacity-0 transition-all duration-300 flex flex-col md:flex-row overflow-hidden max-h-[90vh]">
        <!-- Close button inside modal -->
        <button onclick="closeStoryModal()" class="absolute top-3 right-3 text-white/50 hover:text-amber-yellow hover:scale-110 transition-all bg-black/40 rounded-full w-8 h-8 flex items-center justify-center z-20 shadow-lg">
            <span class="material-symbols-outlined text-lg font-bold">close</span>
        </button>
        
        <!-- Left half: Image -->
        <div class="w-full md:w-2/5 aspect-square md:aspect-auto md:h-auto bg-cover bg-center shrink-0 border-b md:border-b-0 md:border-r border-amber-yellow/20" id="story-modal-image"></div>
        
        <!-- Right half: Content text -->
        <div class="w-full md:w-3/5 p-8 md:p-12 flex flex-col justify-center overflow-y-auto bg-background-dark/30">
            <span class="material-symbols-outlined text-amber-yellow/40 text-[48px] leading-none mb-6 -ml-2 drop-shadow" style="font-variation-settings: 'FILL' 1;">format_quote</span>
            
            <p id="story-modal-text" class="text-white/95 text-lg md:text-xl italic font-medium leading-relaxed mb-8 font-mono border-l-2 border-amber-yellow/50 pl-5">
                Full story goes here...
            </p>
            
            <div class="flex flex-col gap-1 mt-auto pt-6 border-t border-white/10">
                <p id="story-modal-name" class="text-amber-yellow text-2xl font-bold font-mono-header tracking-wide"></p>
                <p id="story-modal-role" class="text-white/60 text-sm font-bold uppercase tracking-widest mt-1"></p>
            </div>
        </div>
    </div>
</div>

<script>
    function openStoryModal(name, role, imageUrl, fullText) {
        const modal = document.getElementById('story-modal');
        const backdrop = document.getElementById('story-modal-backdrop');
        const content = document.getElementById('story-modal-content');
        
        // Populate modal data
        document.getElementById('story-modal-name').textContent = name;
        document.getElementById('story-modal-role').textContent = role;
        document.getElementById('story-modal-text').textContent = '"' + fullText + '"';
        document.getElementById('story-modal-image').style.backgroundImage = `url('${imageUrl}')`;
        
        // Show modal base container
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        
        // Let the browser paint the flex display, then trigger transitions
        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                backdrop.classList.remove('opacity-0');
                backdrop.classList.add('opacity-100');
                
                content.classList.remove('scale-95', 'opacity-0');
                content.classList.add('scale-100', 'opacity-100');
            });
        });
        
        // Prevent background scrolling
        document.body.style.overflow = 'hidden';
    }
    
    function closeStoryModal() {
        const modal = document.getElementById('story-modal');
        const backdrop = document.getElementById('story-modal-backdrop');
        const content = document.getElementById('story-modal-content');
        
        // Start hiding transitions
        backdrop.classList.remove('opacity-100');
        backdrop.classList.add('opacity-0');
        
        content.classList.remove('scale-100', 'opacity-100');
        content.classList.add('scale-95', 'opacity-0');
        
        // After transition duration, completely hide elements
        setTimeout(() => {
            modal.classList.remove('flex');
            modal.classList.add('hidden');
            document.body.style.overflow = '';
        }, 300); // 300ms matches Tailwind's duration-300
    }
    
    // Close modal on Escape key press
    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            const modal = document.getElementById('story-modal');
            if (!modal.classList.contains('hidden')) {
                closeStoryModal();
            }
        }
    });

    // Make sure click propagation inside the modal doesn't trigger a close
    document.getElementById('story-modal-content')?.addEventListener('click', function(e) {
        e.stopPropagation();
    });
</script>
