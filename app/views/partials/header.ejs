<!-- Inject auth state for client-side JS -->
<script>window.__heritUser = <%- JSON.stringify(locals.user ? { id: locals.user.id, role: locals.user.role, name: locals.user.name } : null) %>;window.__csrfToken='<%= locals.csrfToken || "" %>';</script>

<header class="flex items-center justify-between whitespace-nowrap border-b border-solid border-rich-red bg-deep-maroon px-4 lg:px-8 xl:px-12 py-1 sticky top-0 z-50 shadow-[0_2px_20px_rgba(0,0,0,0.4)]">
    <% const currentUser = locals.user || null; %>

    <% if (currentUser && currentUser.role === 'CREATOR') { %>
        <!-- ── CREATOR HEADER ── -->
        <div class="flex items-center gap-4">
            <a href="/" class="flex items-center text-white group">
                <div class="h-20 w-20 flex items-center justify-center">
                    <img src="/images/logo.png" alt="HeritEdge Logo"
                        class="w-full h-full object-contain scale-[1.4] group-hover:scale-[1.5] transition-transform duration-300"
                        onerror="this.onerror=null;this.parentElement.innerHTML='<span class=\'text-amber-yellow font-bold text-2xl border-2 border-amber-yellow px-2 py-1\'>HE</span>';" />
                </div>
            </a>
        </div>

        <nav class="hidden lg:flex justify-end flex-1 items-center gap-6 xl:gap-10 font-mono-header pr-8">
            <a class="nav-link text-[15px] xl:text-[16px] font-semibold tracking-wide transition-all duration-200 hover:scale-105 <%= path === '/marketplace' ? 'text-amber-yellow' : 'text-white' %> hover:text-amber-yellow" href="/marketplace">Art</a>
            <a class="nav-link text-[15px] xl:text-[16px] font-semibold tracking-wide transition-all duration-200 hover:scale-105 <%= path === '/events' ? 'text-amber-yellow' : 'text-white' %> hover:text-amber-yellow" href="/events">Events</a>
            <a class="nav-link text-[15px] xl:text-[16px] font-semibold tracking-wide transition-all duration-200 hover:scale-105 <%= path === '/creator/home' ? 'text-amber-yellow' : 'text-white' %> hover:text-amber-yellow" href="/creator/home">Dashboard</a>
            <a class="nav-link text-[15px] xl:text-[16px] font-semibold tracking-wide transition-all duration-200 hover:scale-105 <%= path === '/profile' ? 'text-amber-yellow' : 'text-white' %> hover:text-amber-yellow" href="/profile">Profile</a>
        </nav>

        <div class="flex-none flex justify-end gap-3 items-center">
            <a href="/creator/upload"
                class="hidden md:flex cursor-pointer items-center justify-center rounded-lg h-10 px-5 bg-rich-red text-white text-sm font-bold hover:bg-[#b52424] transition-all font-mono-header gap-2 shadow-sm">
                <span class="material-symbols-outlined text-[17px]">add_circle</span>
                Post Artwork
            </a>
            <!-- Notification Bell -->
            <div class="notif-wrapper relative hidden md:block">
                <button onclick="toggleNotif()" class="relative flex items-center justify-center w-10 h-10 rounded-lg bg-white/6 border border-white/12 text-white/70 hover:text-amber-yellow hover:border-amber-yellow/40 transition-all" title="Notifications">
                    <span class="material-symbols-outlined text-[20px]">notifications</span>
                    <% if (locals.notifCount > 0) { %>
                        <span class="notif-badge absolute -top-1.5 -right-1.5 w-5 h-5 bg-amber-yellow text-background-dark text-[10px] font-black rounded-full flex items-center justify-center leading-none"><%= locals.notifCount > 9 ? '9+' : locals.notifCount %></span>
                    <% } %>
                </button>
            </div>
            <a href="/profile" class="w-11 h-11 rounded-full overflow-hidden border-2 border-white/20 hover:border-amber-yellow transition-colors shrink-0">
                <img src="<%= currentUser.avatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(currentUser.name || 'U') + '&background=3f101a&color=f2b90d&size=80' %>" class="w-full h-full object-cover" alt="<%= currentUser.name %>">
            </a>
            <button id="mobile-menu-btn" class="lg:hidden flex items-center justify-center text-white p-2">
                <span class="material-symbols-outlined text-3xl">menu</span>
            </button>
        </div>

    <% } else { %>
        <!-- ── STANDARD / BUYER HEADER ── -->
        <div class="flex-1 flex justify-start">
            <a href="/" class="flex items-center text-white group">
                <div class="h-20 w-20 flex items-center justify-center">
                    <img src="/images/logo.png" alt="HeritEdge Logo"
                        class="w-full h-full object-contain scale-[1.4] group-hover:scale-[1.5] transition-transform duration-300"
                        onerror="this.onerror=null;this.parentElement.innerHTML='<span class=\'text-amber-yellow font-bold text-2xl border-2 border-amber-yellow px-2 py-1\'>HE</span>';" />
                </div>
            </a>
        </div>

        <!-- Center nav -->
        <nav class="hidden lg:flex flex-none justify-center items-center gap-5 xl:gap-8 font-mono-header z-10 px-2 xl:px-4">
            <a class="relative group text-white hover:text-amber-yellow text-[15px] xl:text-[16px] font-semibold tracking-wide transition-colors duration-200 whitespace-nowrap" href="/">
                Home
                <span class="absolute -bottom-0.5 left-0 w-0 h-0.5 bg-amber-yellow transition-all duration-200 group-hover:w-full rounded-full"></span>
            </a>
            <a class="relative group text-white hover:text-amber-yellow text-[15px] xl:text-[16px] font-semibold tracking-wide transition-colors duration-200 whitespace-nowrap" href="/about">
                About
                <span class="absolute -bottom-0.5 left-0 w-0 h-0.5 bg-amber-yellow transition-all duration-200 group-hover:w-full rounded-full"></span>
            </a>
            <a class="relative group text-white hover:text-amber-yellow text-[15px] xl:text-[16px] font-semibold tracking-wide transition-colors duration-200 whitespace-nowrap" href="/marketplace">
                Marketplace
                <span class="absolute -bottom-0.5 left-0 w-0 h-0.5 bg-amber-yellow transition-all duration-200 group-hover:w-full rounded-full"></span>
            </a>
            <a class="relative group text-white hover:text-amber-yellow text-[15px] xl:text-[16px] font-semibold tracking-wide transition-colors duration-200 whitespace-nowrap" href="/events">
                Events
                <span class="absolute -bottom-0.5 left-0 w-0 h-0.5 bg-amber-yellow transition-all duration-200 group-hover:w-full rounded-full"></span>
            </a>
            <% if (currentUser && currentUser.role === 'ADMIN' && typeof path !== 'undefined' && path.startsWith('/admin')) { %>
                <a class="relative group text-white hover:text-amber-yellow text-[15px] font-semibold tracking-wide transition-colors whitespace-nowrap" href="/admin">Admin Hub</a>
            <% } %>
        </nav>

        <!-- Right actions -->
        <div class="flex-1 flex justify-end gap-2 lg:gap-3 items-center">
            <!-- Search (hidden for admin; shown at xl only to prevent nav overflow at lg) -->
            <% if (!currentUser || currentUser.role !== 'ADMIN') { %>
                <label class="hidden xl:flex min-w-36 max-w-52 h-9">
                    <form action="/marketplace" method="GET"
                        class="flex w-full items-stretch rounded-lg h-full bg-black/25 border border-white/15 hover:border-white/30 transition-colors">
                        <button type="submit" class="text-white/50 flex items-center justify-center pl-3 hover:text-amber-yellow transition-colors">
                            <span class="material-symbols-outlined text-[19px]">search</span>
                        </button>
                        <input name="q" class="form-input flex w-full border-none bg-transparent focus:ring-0 text-white placeholder:text-white/35 px-3 text-sm outline-none" placeholder="Search art..." />
                    </form>
                </label>
                <!-- Compact search icon at lg (links to marketplace) -->
                <a href="/marketplace" class="hidden lg:flex xl:hidden items-center justify-center w-9 h-9 rounded-lg bg-black/25 border border-white/15 text-white/50 hover:text-amber-yellow hover:border-white/30 transition-all flex-shrink-0" title="Search art">
                    <span class="material-symbols-outlined text-[19px]">search</span>
                </a>
            <% } %>

            <% if (currentUser) { %>
                <!-- Cart icon (for BUYER) -->
                <% if (currentUser.role === 'BUYER') { %>
                    <a href="/profile?tab=cart" class="relative flex items-center justify-center w-10 h-10 rounded-lg bg-white/6 border border-white/12 text-white/70 hover:text-amber-yellow hover:border-amber-yellow/40 transition-all" title="My Cart">
                        <span class="material-symbols-outlined text-[20px]">shopping_cart</span>
                        <span class="he-cart-badge hidden absolute -top-1.5 -right-1.5 w-5 h-5 bg-amber-yellow text-background-dark text-[10px] font-black rounded-full items-center justify-center leading-none">0</span>
                    </a>

                    <% if (currentUser.artistApplicant) { %>
                        <span class="hidden xl:flex items-center gap-1.5 px-3 h-9 rounded-lg bg-white/5 border border-white/10 text-white/50 text-xs font-bold font-mono-header whitespace-nowrap cursor-default">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-yellow animate-pulse"></span>
                            Application Pending
                        </span>
                        <span class="hidden lg:flex xl:hidden items-center justify-center w-9 h-9 rounded-lg bg-white/5 border border-white/10 cursor-default flex-shrink-0" title="Application Pending">
                            <span class="w-2 h-2 rounded-full bg-amber-yellow animate-pulse"></span>
                        </span>
                    <% } %>
                <% } %>

                <!-- Notification Bell -->
                <div class="notif-wrapper relative hidden md:block">
                    <button onclick="toggleNotif()" class="relative flex items-center justify-center w-10 h-10 rounded-lg bg-white/6 border border-white/12 text-white/70 hover:text-amber-yellow hover:border-amber-yellow/40 transition-all" title="Notifications">
                        <span class="material-symbols-outlined text-[20px]">notifications</span>
                        <% if (locals.notifCount > 0) { %>
                            <span class="notif-badge absolute -top-1.5 -right-1.5 w-5 h-5 bg-amber-yellow text-background-dark text-[10px] font-black rounded-full flex items-center justify-center leading-none"><%= locals.notifCount > 9 ? '9+' : locals.notifCount %></span>
                        <% } %>
                    </button>
                </div>

                <!-- Profile + Logout -->
                <% if (currentUser.role !== 'ADMIN') { %>
                    <a href="/profile" class="hidden md:flex items-center justify-center h-9 px-4 rounded-lg bg-white/8 border border-white/12 text-white text-sm font-semibold hover:bg-white/15 transition-all">Profile</a>
                <% } %>
                <a href="/logout" class="hidden md:flex items-center justify-center h-9 px-4 rounded-lg bg-white/8 border border-white/12 text-white text-sm font-semibold hover:bg-white/15 transition-all">Logout</a>

            <% } else { %>
                <a href="/login"
                    class="hidden md:flex items-center justify-center rounded-lg h-9 px-5 bg-amber-yellow text-background-dark text-sm font-bold hover:brightness-110 transition-all font-mono-header shadow-lg">
                    Login / Sign Up
                </a>
            <% } %>

            <button id="mobile-menu-btn" class="lg:hidden flex items-center justify-center text-white p-2">
                <span class="material-symbols-outlined text-3xl">menu</span>
            </button>
        </div>
    <% } %>
</header>

<!-- Notification Panel (shared, fixed) -->
<div id="notif-panel" class="hidden fixed w-[360px] max-h-[460px] flex flex-col bg-[#140804] border border-white/12 rounded-2xl shadow-2xl overflow-hidden z-[200]" style="top:74px;right:16px;">
    <div class="flex items-center justify-between px-5 py-3.5 border-b border-white/10 flex-shrink-0">
        <span class="text-white font-bold text-sm">Notifications</span>
        <button onclick="closeNotif()" class="text-white/50 hover:text-white transition-colors">
            <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
    </div>
    <div id="notif-list" class="flex-1 overflow-y-auto px-3 py-3">
        <div class="flex items-center justify-center py-8 gap-2 text-white/30 text-sm">
            <span class="material-symbols-outlined text-[22px]">hourglass_top</span>
            Loading...
        </div>
    </div>
    <div class="px-5 py-3 border-t border-white/8 flex-shrink-0">
        <a href="/profile?tab=notifications" class="text-amber-yellow/70 hover:text-amber-yellow text-xs font-semibold transition-colors">View all in profile →</a>
    </div>
</div>

<!-- Mobile menu -->
<div id="mobile-menu" class="hidden lg:hidden bg-deep-maroon border-b border-rich-red/50 px-6 py-5 flex flex-col gap-3 font-mono-header shadow-xl z-40">
    <% if (!currentUser) { %>
        <a class="text-white hover:text-amber-yellow text-base font-medium py-1" href="/">Home</a>
        <a class="text-white hover:text-amber-yellow text-base font-medium py-1" href="/about">About</a>
        <a class="text-white hover:text-amber-yellow text-base font-medium py-1" href="/marketplace">Art Marketplace</a>
        <a class="text-white hover:text-amber-yellow text-base font-medium py-1" href="/events">Events</a>
        <hr class="border-white/10 my-1">
        <a href="/login" class="flex items-center justify-center w-full py-3 bg-amber-yellow text-background-dark font-bold rounded-lg text-sm">Login / Sign Up</a>
    <% } else if (currentUser.role === 'BUYER') { %>
        <a class="text-white hover:text-amber-yellow text-base font-medium py-1" href="/">Home</a>
        <a class="text-white hover:text-amber-yellow text-base font-medium py-1" href="/about">About</a>
        <a class="text-white hover:text-amber-yellow text-base font-medium py-1" href="/marketplace">Art Marketplace</a>
        <a class="text-white hover:text-amber-yellow text-base font-medium py-1" href="/events">Events</a>
        <a class="text-white hover:text-amber-yellow text-base font-medium py-1" href="/profile">Profile</a>
        <a class="text-white hover:text-amber-yellow text-base font-medium py-1" href="/profile?tab=cart" class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">shopping_cart</span> My Cart
        </a>
        <hr class="border-white/10 my-1">
        <% if (currentUser.artistApplicant) { %>
            <div class="flex items-center justify-center gap-2 w-full py-2.5 bg-white/5 border border-white/10 text-white/50 rounded-lg text-xs font-bold">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-yellow animate-pulse"></span> Application Pending
            </div>
        <% } %>
        <a href="/logout" class="text-white/60 hover:text-white text-sm font-medium py-1 mt-1">Logout</a>
    <% } else if (currentUser.role === 'CREATOR') { %>
        <a class="text-white hover:text-amber-yellow text-base font-medium py-1" href="/">Home</a>
        <a class="text-white hover:text-amber-yellow text-base font-medium py-1" href="/marketplace">Art Marketplace</a>
        <a class="text-white hover:text-amber-yellow text-base font-medium py-1" href="/events">Events</a>
        <a class="text-white hover:text-amber-yellow text-base font-medium py-1" href="/creator/home">Dashboard</a>
        <a class="text-white hover:text-amber-yellow text-base font-medium py-1" href="/profile">Profile</a>
        <hr class="border-white/10 my-1">
        <a href="/creator/upload" class="flex items-center justify-center gap-2 w-full py-3 bg-rich-red text-white font-bold rounded-lg text-sm">
            <span class="material-symbols-outlined text-[18px]">add_circle</span> Post Artwork
        </a>
        <a href="/logout" class="text-white/60 hover:text-white text-sm font-medium py-1 mt-1">Logout</a>
    <% } else if (currentUser.role === 'ADMIN') { %>
        <a class="text-white hover:text-amber-yellow text-base font-medium py-1" href="/admin">Admin Hub</a>
        <hr class="border-white/10 my-1">
        <a href="/logout" class="text-white/60 hover:text-white text-sm font-medium py-1">Logout</a>
    <% } %>
</div>

<script>
    document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
        document.getElementById('mobile-menu')?.classList.toggle('hidden');
    });

    let _notifLoaded = false;
    function toggleNotif() {
        const p = document.getElementById('notif-panel');
        if (!p) return;
        if (p.classList.contains('hidden')) {
            p.classList.remove('hidden');
            p.style.display = 'flex';
            p.style.flexDirection = 'column';
            if (!_notifLoaded) _loadNotifs();
        } else {
            p.classList.add('hidden');
        }
    }
    function closeNotif() {
        const p = document.getElementById('notif-panel');
        if (p) p.classList.add('hidden');
    }
    async function _loadNotifs() {
        _notifLoaded = true;
        try {
            const r = await fetch('/api/notifications');
            const d = await r.json();
            const list = document.getElementById('notif-list');
            const notes = d.notifications || [];
            if (!notes.length) {
                list.innerHTML = '<div class="flex flex-col items-center justify-center py-10 text-white/30"><span class="material-symbols-outlined text-4xl mb-2">notifications_off</span><span class="text-sm">No notifications yet</span></div>';
                return;
            }
            const _ic = { APPLICATION_APPROVED: ['check_circle','#00A86B'], APPLICATION_REJECTED: ['cancel','#f87171'] };
            list.innerHTML = notes.map(n => {
                const [ico, col] = _ic[n.type] || ['info','#f2b90d'];
                const dt = new Date(n.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric'});
                return `<div class="flex gap-3 px-3 py-3 rounded-xl hover:bg-white/5 transition-colors${n.read ? '' : ' bg-amber-yellow/5 border border-amber-yellow/10 mb-1'}">
                    <span class="material-symbols-outlined text-[20px] flex-shrink-0 mt-0.5" style="color:${col};font-variation-settings:'FILL' 1">${ico}</span>
                    <div class="flex-1 min-w-0"><p class="text-white/90 text-xs leading-relaxed">${n.message}</p><p class="text-white/35 text-[10px] mt-1">${dt}</p></div>
                </div>`;
            }).join('');
            fetch('/api/notifications/mark-read', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.__csrfToken || '' } }).catch(() => {});
            document.querySelectorAll('.notif-badge').forEach(el => el.remove());
        } catch(e) {
            const list = document.getElementById('notif-list');
            if (list) list.innerHTML = '<div class="text-center py-6 text-red-400/70 text-sm">Failed to load.</div>';
        }
    }
    document.addEventListener('click', e => {
        const p = document.getElementById('notif-panel');
        if (p && !p.classList.contains('hidden') && !e.target.closest('#notif-panel') && !e.target.closest('.notif-wrapper')) {
            p.classList.add('hidden');
        }
    });
</script>
