<header
    class="flex items-center justify-between whitespace-nowrap border-b border-solid border-rich-red bg-deep-maroon px-4 lg:px-8 xl:px-12 py-2 sticky top-0 z-50">
    <% const currentUser = locals.user || null; %>
    
    <% if (currentUser && currentUser.role === 'CREATOR') { %>
        <!-- CREATOR HEADER -->
        <div class="flex items-center gap-6">
            <a href="/" class="flex items-center text-white group pl-0 md:pl-2">
                <div class="h-16 w-16 flex items-center justify-center">
                    <img src="/images/logo.png" alt="HeritEdge Logo"
                        class="w-full h-full object-contain scale-[1.3] group-hover:scale-[1.4] transition-transform"
                        onerror="this.onerror=null; this.parentElement.innerHTML='<span class=\'text-amber-yellow font-bold text-xl font-mono border-2 border-amber-yellow p-1\'>HE</span>';" />
                </div>
            </a>
        </div>

        <nav class="hidden lg:flex justify-end flex-1 items-center gap-4 lg:gap-8 xl:gap-10 font-mono-header pr-8 lg:pr-12">
            <a class="inline-block <%= path === '/marketplace' ? 'text-amber-yellow border-b-2 border-amber-yellow pb-1' : 'text-white' %> hover:text-amber-yellow text-[15px] xl:text-[16px] font-bold tracking-wide transition-all duration-300 hover:scale-110" href="/marketplace">Art</a>
            <a class="inline-block <%= path === '/events' ? 'text-amber-yellow border-b-2 border-amber-yellow pb-1' : 'text-white' %> hover:text-amber-yellow text-[15px] xl:text-[16px] font-bold tracking-wide transition-all duration-300 hover:scale-110" href="/events">Events</a>
            <a class="inline-block <%= path === '/creator/home' ? 'text-amber-yellow border-b-2 border-amber-yellow pb-1' : 'text-white' %> hover:text-amber-yellow text-[15px] xl:text-[16px] font-bold tracking-wide transition-all duration-300 hover:scale-110" href="/creator/home">Dashboard</a>
            <a class="inline-block <%= path === '/profile' ? 'text-amber-yellow border-b-2 border-amber-yellow pb-1' : 'text-white' %> hover:text-amber-yellow text-[15px] xl:text-[16px] font-bold tracking-wide transition-all duration-300 hover:scale-110" href="/profile">Profile</a>
        </nav>

        <div class="flex-none flex justify-end gap-5 items-center">
            <a href="/creator/upload"
                class="hidden md:flex cursor-pointer items-center justify-center rounded-md h-10 px-5 bg-rich-red text-white text-sm font-bold hover:bg-[#b52424] transition-all font-mono-header border border-white/10 shadow-sm">
                Post New Artwork
            </a>
            <a href="/profile" class="w-10 h-10 rounded-full overflow-hidden border border-white/20 hover:border-amber-yellow transition-colors shrink-0">
                <img src="<%= currentUser.avatar || 'https://lh3.googleusercontent.com/aida-public/AB6AXuDFnIxnWb9AzaIzvWrYMJX_D3tKYwNJAqsz7ynWqtZFM_f8IUT0mOWiipjLeMR4iYYAzOPIClPUgpC99-gthpbSfWVeviaLEUoNOoUeGLJypwiFOr2X2i-u5vkQmgBu973yjjsvrpzvZvW91bnVbTpO7oaOJxrs96Q642WMDlodB_khNexQsuUcw5Q8USKfHkf3CnNqb1jU8FpP5NCGNrtOZgw70iJHCV6yBVCW44dSLnD6XGcrAHXNlULt1fqHLSKLDPll__tayLg' %>" class="w-full h-full object-cover">
            </a>
            <button id="mobile-menu-btn" class="md:hidden flex items-center justify-center text-white p-2 focus:outline-none">
                <span class="material-symbols-outlined text-3xl">menu</span>
            </button>
        </div>

    <% } else { %>
        <!-- STANDARD HEADER -->
        <div class="flex-1 flex justify-start">
            <a href="/" class="flex items-center text-white group pl-0 md:pl-2">
                <div class="h-16 w-16 md:h-16 md:w-16 flex items-center justify-center">
                    <img src="/images/logo.png" alt="HeritEdge Logo"
                        class="w-full h-full object-contain scale-[1.3] group-hover:scale-[1.4] transition-transform"
                        onerror="this.onerror=null; this.parentElement.innerHTML='<span class=\'text-amber-yellow font-bold text-xl font-mono border-2 border-amber-yellow p-1\'>HE</span>';" />
                </div>
            </a>
        </div>

        <!-- Center Nav -->
        <nav class="hidden lg:flex flex-none justify-center items-center gap-4 lg:gap-6 xl:gap-10 font-mono-header">
            <a class="inline-block text-white hover:text-amber-yellow text-[15px] xl:text-[16px] font-bold tracking-wide transition-all duration-300 hover:scale-110" href="/">Home</a>
            <a class="inline-block text-white hover:text-amber-yellow text-[15px] xl:text-[16px] font-bold tracking-wide transition-all duration-300 hover:scale-110" href="/about">About Us</a>
            <a class="inline-block text-white hover:text-amber-yellow text-[15px] xl:text-[16px] font-bold tracking-wide transition-all duration-300 hover:scale-110" href="/marketplace">Art Marketplace</a>
            <a class="inline-block text-white hover:text-amber-yellow text-[15px] xl:text-[16px] font-bold tracking-wide transition-all duration-300 hover:scale-110" href="/events">Events</a>

            <% if (currentUser && currentUser.role==='BUYER') { %>
                <a class="inline-block text-white hover:text-amber-yellow text-[15px] xl:text-[16px] font-bold tracking-wide transition-all duration-300 hover:scale-110" href="/become-artist">Become an Artist</a>
            <% } else if (currentUser && currentUser.role==='ADMIN' && typeof path !== 'undefined' && path.startsWith('/admin')) { %>
                <a class="inline-block text-white hover:text-amber-yellow text-[15px] xl:text-[16px] font-bold tracking-wide transition-all duration-300 hover:scale-110" href="/admin">Admin Hub</a>
            <% } %>
        </nav>

        <div class="flex-1 flex justify-end gap-4 lg:gap-6 items-center">
            <% if (!currentUser || currentUser.role !=='ADMIN' ) { %>
                <label class="hidden lg:flex flex-col min-w-40 h-10 max-w-64">
                    <form action="/marketplace" method="GET"
                        class="flex w-full flex-1 items-stretch rounded-md h-full bg-black/20 border border-white/10">
                        <button type="submit"
                            class="text-white/60 flex items-center justify-center pl-4 rounded-l-lg hover:text-amber-yellow">
                            <span class="material-symbols-outlined text-xl">search</span>
                        </button>
                        <input name="q"
                            class="form-input flex w-full min-w-0 flex-1 border-none bg-transparent focus:ring-0 text-white placeholder:text-white/40 px-3 text-sm font-mono-header outline-none"
                            placeholder="Search art..." value="" />
                    </form>
                </label>
            <% } %>
            <div class="flex gap-2">
                <% if (currentUser) { %>
                    <% if (currentUser.role !== 'ADMIN') { %>
                        <a href="/profile"
                            class="hidden md:flex min-w-[84px] cursor-pointer items-center justify-center rounded-md h-10 px-4 bg-white/10 text-white text-sm font-bold hover:bg-white/20 transition-all font-mono-header border border-white/10">Profile</a>
                    <% } %>
                    <a href="/logout"
                        class="hidden md:flex min-w-[84px] cursor-pointer items-center justify-center rounded-md h-10 px-4 bg-white/10 text-white text-sm font-bold hover:bg-white/20 transition-all font-mono-header border border-white/10">Logout</a>
                <% } else { %>
                    <a href="/login"
                        class="hidden md:flex min-w-[84px] cursor-pointer items-center justify-center rounded-md h-10 px-4 bg-amber-yellow text-background-dark text-sm font-bold tracking-tight hover:brightness-110 transition-all font-mono-header shadow">Login / Sign Up</a>
                <% } %>

                <!-- Mobile Menu Button -->
                <button id="mobile-menu-btn"
                    class="md:hidden flex items-center justify-center text-white p-2 focus:outline-none">
                    <span class="material-symbols-outlined text-3xl">menu</span>
                </button>
            </div>
        </div>
    <% } %>
</header>

<!-- Mobile Dropdown Menu -->
<div id="mobile-menu"
    class="hidden md:hidden bg-deep-maroon border-b border-rich-red px-6 py-4 flex flex-col gap-4 font-mono-header">
    <% if (!currentUser) { %>
        <a class="text-white/90 hover:text-amber-yellow text-lg font-medium transition-colors" href="/">Home</a>
        <a class="text-white/90 hover:text-amber-yellow text-lg font-medium transition-colors" href="/about">About
            Us</a>
        <a class="text-white/90 hover:text-amber-yellow text-lg font-medium transition-colors" href="/marketplace">Art
            Marketplace</a>
        <a class="text-white/90 hover:text-amber-yellow text-lg font-medium transition-colors" href="/events">Events</a>
        <hr class="border-white/10 my-2">
        <a href="/login" class="text-white/90 hover:text-amber-yellow text-lg font-medium transition-colors">Login / Sign Up</a>
        <% } else if (currentUser.role==='BUYER' ) { %>
            <a class="text-white/90 hover:text-amber-yellow text-lg font-medium transition-colors" href="/">Home</a>
            <a class="text-white/90 hover:text-amber-yellow text-lg font-medium transition-colors" href="/about">About
                Us</a>
            <a class="text-white/90 hover:text-amber-yellow text-lg font-medium transition-colors"
                href="/marketplace">Art Marketplace</a>
            <a class="text-white/90 hover:text-amber-yellow text-lg font-medium transition-colors"
                href="/events">Events</a>
            <a class="text-white/90 hover:text-amber-yellow text-lg font-medium transition-colors"
                href="/become-artist">Become an Artist</a>
            <a class="text-white/90 hover:text-amber-yellow text-lg font-medium transition-colors"
                href="/profile">Profile</a>
            <hr class="border-white/10 my-2">
            <a href="/logout"
                class="text-white/90 hover:text-amber-yellow text-lg font-medium transition-colors">Logout</a>
            <% } else if (currentUser.role==='CREATOR' ) { %>
                <a class="text-white/90 hover:text-amber-yellow text-lg font-medium transition-colors" href="/">Home</a>
                <a class="text-white/90 hover:text-amber-yellow text-lg font-medium transition-colors"
                    href="/about">About Us</a>
                <a class="text-white/90 hover:text-amber-yellow text-lg font-medium transition-colors"
                    href="/marketplace">Art Marketplace</a>
                <a class="text-white/90 hover:text-amber-yellow text-lg font-medium transition-colors"
                    href="/events">Events</a>
                <a class="text-white/90 hover:text-amber-yellow text-lg font-medium transition-colors"
                    href="/creator/home">Dashboard</a>
                <a class="text-white/90 hover:text-amber-yellow text-lg font-medium transition-colors"
                    href="/profile">Profile</a>
                <hr class="border-white/10 my-2">
                <a href="/logout"
                    class="text-white/90 hover:text-amber-yellow text-lg font-medium transition-colors">Logout</a>
                <% } else if (currentUser.role==='ADMIN' && typeof path !== 'undefined' && path.startsWith('/admin')) { %>
                    <a class="text-white/90 hover:text-amber-yellow text-lg font-medium transition-colors"
                        href="/admin">Admin Hub</a>
                    <hr class="border-white/10 my-2">
                    <a href="/logout"
                        class="text-white/90 hover:text-amber-yellow text-lg font-medium transition-colors">Logout</a>
                    <% } %>
</div>

<script>
    document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
        const menu = document.getElementById('mobile-menu');
        menu.classList.toggle('hidden');
    });
</script>