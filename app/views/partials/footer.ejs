<% const _fu = locals.user || null; %>
<footer class="bg-[#1a0b06] border-t border-rich-red/40 px-6 md:px-10 py-16 text-white w-full">
    <div class="max-w-[1200px] mx-auto">

        <!-- Main footer grid — 4 equal columns, all centered -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8 justify-items-center text-center">

            <!-- Brand -->
            <div class="flex flex-col items-center gap-4">
                <a href="/" class="flex flex-col items-center gap-2 group">
                    <div class="w-14 h-14 overflow-hidden rounded-xl group-hover:scale-105 transition-transform duration-300">
                        <img src="/images/logo.png" alt="HeritEdge Logo"
                            class="w-full h-full object-contain"
                            onerror="this.onerror=null;this.parentElement.innerHTML='<span class=\'text-amber-yellow font-bold text-xl border-2 border-amber-yellow px-2 py-1\'>HE</span>';" />
                    </div>
                    <span class="text-white font-bold text-lg tracking-tight">HeritEdge</span>
                </a>
                <p class="text-white/60 text-sm leading-relaxed max-w-[200px]">
                    Connecting Nepal's cultural heritage to the modern world.
                </p>
                <div class="flex gap-3 mt-1">
                    <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram"
                        class="w-9 h-9 rounded-full bg-white/8 border border-white/12 flex items-center justify-center text-white/50 hover:text-amber-yellow hover:border-amber-yellow/40 transition-all hover:scale-110">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                    </a>
                    <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook"
                        class="w-9 h-9 rounded-full bg-white/8 border border-white/12 flex items-center justify-center text-white/50 hover:text-amber-yellow hover:border-amber-yellow/40 transition-all hover:scale-110">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                    </a>
                    <a href="mailto:hello@heritedge.com" aria-label="Email"
                        class="w-9 h-9 rounded-full bg-white/8 border border-white/12 flex items-center justify-center text-white/50 hover:text-amber-yellow hover:border-amber-yellow/40 transition-all hover:scale-110">
                        <span class="material-symbols-outlined text-[15px]">mail</span>
                    </a>
                </div>
            </div>

            <!-- Explore links -->
            <div class="flex flex-col items-center gap-3">
                <h4 class="text-amber-yellow font-bold text-xs uppercase tracking-[0.15em] mb-1">Explore</h4>
                <a class="text-white/70 hover:text-amber-yellow text-sm transition-colors duration-200" href="/marketplace">Art Marketplace</a>
                <a class="text-white/70 hover:text-amber-yellow text-sm transition-colors duration-200" href="/marketplace">Artist Profiles</a>
                <a class="text-white/70 hover:text-amber-yellow text-sm transition-colors duration-200" href="/events">Upcoming Events</a>
                <a class="text-white/70 hover:text-amber-yellow text-sm transition-colors duration-200" href="/about">Our Mission</a>

                <%# Join as Artist — state-aware %>
                <% if (!_fu) { %>
                    <%# Not logged in: prompt to register first %>
                    <a class="text-white/70 hover:text-amber-yellow text-sm transition-colors duration-200" href="/register">Join as an Artist</a>
                <% } else if (_fu.role === 'BUYER' && !_fu.artistApplicant) { %>
                    <%# Logged-in buyer, no pending application %>
                    <a class="text-white/70 hover:text-amber-yellow text-sm transition-colors duration-200" href="/become-artist">Join as an Artist</a>
                <% } else if (_fu.role === 'BUYER' && _fu.artistApplicant) { %>
                    <%# Application submitted, awaiting admin review %>
                    <span class="flex items-center gap-1.5 text-white/35 text-sm cursor-default">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-yellow/60 animate-pulse"></span>
                        Application Pending
                    </span>
                <% } else if (_fu.role === 'CREATOR') { %>
                    <%# Already an artist — link to their dashboard %>
                    <a class="text-white/70 hover:text-amber-yellow text-sm transition-colors duration-200" href="/creator/home">Creator Dashboard</a>
                <% } %>
            </div>

            <!-- Support links -->
            <div class="flex flex-col items-center gap-3">
                <h4 class="text-amber-yellow font-bold text-xs uppercase tracking-[0.15em] mb-1">Support</h4>
                <a class="text-white/70 hover:text-amber-yellow text-sm transition-colors duration-200" href="/faq">Help Center</a>
                <a class="text-white/70 hover:text-amber-yellow text-sm transition-colors duration-200" href="/faq">FAQ</a>
                <a class="text-white/70 hover:text-amber-yellow text-sm transition-colors duration-200" href="/faq#shipping">Shipping &amp; Returns</a>
                <a class="text-white/70 hover:text-amber-yellow text-sm transition-colors duration-200" href="/about#terms">Terms of Service</a>
                <a class="text-white/70 hover:text-amber-yellow text-sm transition-colors duration-200" href="/about#privacy">Privacy Policy</a>
            </div>

            <!-- Newsletter -->
            <div class="flex flex-col items-center gap-4 w-full max-w-[240px]">
                <h4 class="text-amber-yellow font-bold text-xs uppercase tracking-[0.15em]">Stay Connected</h4>
                <p class="text-white/60 text-sm leading-relaxed text-center">
                    Stories, new arrivals & cultural events — in your inbox.
                </p>
                <form class="flex gap-2 w-full" onsubmit="handleNewsletter(event)">
                    <input
                        id="newsletter-email"
                        class="bg-white/8 border border-white/20 rounded-lg px-3 py-2.5 text-sm flex-1 min-w-0 focus:ring-1 focus:ring-amber-yellow focus:border-amber-yellow outline-none text-white placeholder-white/40 transition-colors"
                        placeholder="Your email" type="email" required />
                    <button type="submit" class="bg-amber-yellow text-[#1a0b06] px-3 py-2.5 rounded-lg hover:bg-amber-yellow/90 transition-colors shrink-0 font-bold">
                        <span class="material-symbols-outlined text-[18px] leading-none">send</span>
                    </button>
                </form>
                <p id="newsletter-msg" class="text-jade-green text-xs hidden text-center">Thank you for subscribing!</p>
            </div>
        </div>

        <!-- Bottom bar -->
        <div class="w-full mt-14 pt-8 border-t border-white/10 flex flex-col sm:flex-row justify-center items-center gap-4 sm:gap-10">
            <p class="text-white/40 text-xs text-center">© 2026 HeritEdge Nepal. All rights reserved.</p>
            <div class="flex gap-6 text-white/40 text-xs">
                <a href="/about#privacy" class="hover:text-amber-yellow transition-colors">Privacy</a>
                <a href="/about#terms" class="hover:text-amber-yellow transition-colors">Terms</a>
                <a href="/faq" class="hover:text-amber-yellow transition-colors">Support</a>
            </div>
        </div>
    </div>
</footer>

<script>
    function handleNewsletter(e) {
        e.preventDefault();
        const msg = document.getElementById('newsletter-msg');
        msg.classList.remove('hidden');
        document.getElementById('newsletter-email').value = '';
        setTimeout(() => msg.classList.add('hidden'), 5000);
    }
</script>
