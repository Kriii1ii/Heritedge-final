<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <%- include('partials/head') %>
</head>

<body class="bg-background-light dark:bg-background-dark min-h-screen text-white">
    <div class="layout-container flex h-full grow flex-col">
        <%- include('partials/header') %>
            <main class="flex flex-1 justify-center py-12 px-4 md:px-10">
                <div class="layout-content-container flex flex-col max-w-[1200px] flex-1">
                    <a href="/marketplace" class="flex items-center gap-2 text-white/60 hover:text-amber-yellow text-sm font-mono-header uppercase tracking-widest font-bold mb-8 w-fit transition-colors">
                        <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                        Back to Artworks
                    </a>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
                        <!-- Images -->
                        <div class="flex flex-col gap-4 relative">
                            <div class="rounded-sm overflow-hidden bg-black aspect-square shadow-2xl relative">
                                <img id="main-artwork-image"
                                    src="<%= artwork.images && artwork.images.length > 0 ? artwork.images[0] : '/images/placeholder.jpg' %>"
                                    class="w-full h-full object-cover">
                                <span
                                    class="absolute top-4 right-4 bg-amber-yellow text-black font-bold uppercase tracking-wider text-xs px-3 py-1 rounded shadow-lg">
                                    <%= artwork.category %>
                                </span>
                            </div>

                            <% if (artwork.images && artwork.images.length> 1) { %>
                                <div class="flex gap-2 overflow-x-auto pb-2 scrollbar-hide">
                                    <% artwork.images.forEach((img, idx)=> { %>
                                        <div class="w-20 h-20 shrink-0 rounded-md overflow-hidden border-2 <%= idx === 0 ? 'border-amber-yellow' : 'border-transparent' %> cursor-pointer hover:opacity-80 transition-all thumbnail-btn"
                                            onclick="document.getElementById('main-artwork-image').src='<%= img %>'; document.querySelectorAll('.thumbnail-btn').forEach(btn => btn.classList.replace('border-amber-yellow', 'border-transparent')); this.classList.replace('border-transparent', 'border-amber-yellow');">
                                            <img src="<%= img %>" class="w-full h-full object-cover">
                                        </div>
                                        <% }) %>
                                </div>
                                <% } %>
                        </div>

                        <!-- Details -->
                        <div class="flex flex-col relative text-white">
                            <h1 class="text-4xl lg:text-5xl font-black mb-4 font-mono-header leading-tight">
                                <%= artwork.title %>
                            </h1>

                            <div class="flex items-center gap-4 mb-6 relative">
                                <div class="h-12 w-12 rounded-full overflow-hidden bg-white/20">
                                    <span
                                        class="material-symbols-outlined absolute inset-0 text-white/40 grid place-items-center">account_circle</span>
                                </div>
                                <div>
                                    <h3 class="font-bold text-lg leading-tight">
                                        <%= artwork.creator.name %>
                                    </h3>
                                    <a href="/artist/<%= artwork.creator.id %>"
                                        class="text-amber-yellow text-sm font-semibold hover:underline border-b border-transparent hover:border-amber-yellow pb-0.5">View
                                        Artist Profile</a>
                                </div>
                            </div>

                            <p
                                class="text-white/70 text-base leading-relaxed mb-8 border-l border-white/20 pl-4 py-1 italic">
                                <%= artwork.description %>
                            </p>

                            <% if (artwork.story) { %>
                                <div class="mb-8 p-6 bg-white/5 border border-white/10 rounded-sm shadow-lg relative">
                                    <span
                                        class="material-symbols-outlined text-4xl text-amber-yellow/20 absolute -top-4 -left-3 bg-deep-maroon rounded-full">history_edu</span>
                                    <h4 class="text-lg font-bold font-mono-header text-amber-yellow mb-2 mt-2">The Story
                                        Behind the Art</h4>
                                    <p class="text-sm text-white/80 leading-relaxed font-mono">
                                        <%= artwork.story %>
                                    </p>
                                </div>
                                <% } %>

                                    <div class="mt-auto">
                                        <div class="flex items-end gap-4 mb-6">
                                            <p class="text-[42px] font-bold font-mono leading-none tracking-tight">रू
                                                <%= artwork.price %>
                                            </p>
                                        </div>

                                        <% if (user && user.role==='BUYER' ) { %>
                                            <form action="/api/order" method="POST" id="purchase-form">
                                                <input type="hidden" name="artworkId" value="<%= artwork.id %>">
                                                <button type="submit"
                                                    class="w-full h-16 bg-amber-yellow text-background-dark font-mono-header uppercase font-bold tracking-[0.15em] hover:bg-white text-lg rounded-sm shadow-[0_0_30px_rgba(242,185,13,0.3)] transition-all hover:scale-[1.02]">
                                                    Purchase via E-Sewa
                                                </button>
                                            </form>
                                            <div class="flex gap-3 mt-3">
                                                <button
                                                    onclick="HE.cart.add({ id: '<%= artwork.id %>', title: `<%= artwork.title.replace(/`/g, '\\`') %>`, price: '<%= artwork.price %>', image: '<%= artwork.images && artwork.images[0] ? artwork.images[0] : '/images/placeholder.jpg' %>', creatorName: `<%= artwork.creator.name.replace(/`/g, '\\`') %>` })"
                                                    class="flex-1 flex items-center justify-center gap-2 h-12 bg-white/6 border border-white/15 text-white font-bold text-sm rounded-sm hover:bg-white/10 hover:border-amber-yellow/40 transition-all font-mono-header uppercase tracking-wide">
                                                    <span class="material-symbols-outlined text-[18px]">shopping_cart</span>
                                                    Add to Cart
                                                </button>
                                                <button
                                                    id="artwork-save-btn"
                                                    onclick="HE.col.toggle({ id: '<%= artwork.id %>', title: `<%= artwork.title.replace(/`/g, '\\`') %>`, price: '<%= artwork.price %>', image: '<%= artwork.images && artwork.images[0] ? artwork.images[0] : '/images/placeholder.jpg' %>', creatorName: `<%= artwork.creator.name.replace(/`/g, '\\`') %>` }, this)"
                                                    title="Save to Collection"
                                                    class="flex items-center justify-center gap-2 h-12 px-5 bg-white/6 border border-white/15 text-white font-bold text-sm rounded-sm hover:bg-white/10 hover:border-red-400/30 hover:text-red-400 transition-all font-mono-header uppercase tracking-wide">
                                                    <span class="material-symbols-outlined save-icon text-[18px]">favorite</span>
                                                    Save
                                                </button>
                                            </div>
                                            <% } else if (user && user.role==='CREATOR' ) { %>
                                                <button
                                                    class="w-full h-16 bg-white/10 text-white/40 font-mono-header uppercase font-bold tracking-[0.15em] text-lg rounded-sm cursor-not-allowed border border-white/10"
                                                    disabled>
                                                    Creators Cannot Purchase
                                                </button>
                                                <% } else { %>
                                                    <a href="/login?redirect=<%= encodeURIComponent('/artwork/' + artwork.id) %>"
                                                        class="flex items-center justify-center w-full h-16 bg-amber-yellow text-background-dark font-mono-header uppercase font-bold tracking-[0.15em] hover:bg-white text-lg rounded-sm shadow-[0_0_30px_rgba(242,185,13,0.3)] transition-all hover:scale-[1.02]">
                                                        Login / Sign Up to Purchase
                                                    </a>
                                                    <div class="flex gap-3 mt-3">
                                                        <a href="/login?redirect=<%= encodeURIComponent('/artwork/' + artwork.id) %>"
                                                            class="flex-1 flex items-center justify-center gap-2 h-11 bg-white/6 border border-white/15 text-white/70 font-bold text-sm rounded-sm hover:bg-white/10 transition-all font-mono-header uppercase tracking-wide">
                                                            <span class="material-symbols-outlined text-[17px]">shopping_cart</span>
                                                            Login to Cart
                                                        </a>
                                                        <a href="/login?redirect=<%= encodeURIComponent('/artwork/' + artwork.id) %>"
                                                            class="flex items-center justify-center gap-2 h-11 px-5 bg-white/6 border border-white/15 text-white/70 font-bold text-sm rounded-sm hover:bg-white/10 transition-all font-mono-header uppercase tracking-wide">
                                                            <span class="material-symbols-outlined text-[17px]">favorite</span>
                                                            Save
                                                        </a>
                                                    </div>
                                                    <% } %>
                                    </div>
                        </div>
                    </div>
                </div>
            </main>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const saveBtn = document.getElementById('artwork-save-btn');
            if (saveBtn && HE.col.isSaved('<%= artwork.id %>')) {
                saveBtn.title = 'Remove from Collection';
                saveBtn.innerHTML = '<span class="material-symbols-outlined save-icon text-[18px]" style="font-variation-settings:\'FILL\' 1;">favorite</span> Saved';
                saveBtn.classList.add('text-red-400', 'border-red-400/30');
            }
        });

        document.getElementById('purchase-form')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = e.target.querySelector('button');
            btn.innerHTML = 'Processing...';
            btn.disabled = true;

            try {
                const res = await fetch('/api/order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ artworkId: '<%= artwork.id %>' })
                });

                if (res.ok) {
                    const data = await res.json();
                    if (data.esewaPayload) {
                        btn.innerHTML = 'Redirecting to E-Sewa...';
                        btn.className = 'w-full h-16 bg-jade-green text-background-dark font-mono-header uppercase font-bold tracking-[0.15em] text-lg rounded-sm shadow-[0_0_30px_rgba(242,185,13,0.3)] transition-all';

                        // Dynamically construct eSewa form and submit
                        const form = document.createElement('form');
                        form.method = 'POST';
                        form.action = 'https://rc-epay.esewa.com.np/api/epay/main/v2/form';

                        for (const key in data.esewaPayload) {
                            const input = document.createElement('input');
                            input.type = 'hidden';
                            input.name = key;
                            input.value = data.esewaPayload[key];
                            form.appendChild(input);
                        }

                        document.body.appendChild(form);
                        form.submit();
                    } else {
                        btn.innerHTML = 'Payment Gateway Generated';
                        btn.className = 'w-full h-16 bg-jade-green text-background-dark font-mono-header uppercase font-bold tracking-[0.15em] text-lg rounded-sm shadow-lg transition-all';
                        setTimeout(() => {
                            window.location.href = '/orders';
                        }, 1500);
                    }
                } else {
                    alert('Order creation failed. Please try again.');
                    btn.innerHTML = 'Purchase via E-Sewa';
                    btn.disabled = false;
                }
            } catch (err) {
                alert('Something went wrong.');
                btn.innerHTML = 'Purchase via E-Sewa';
                btn.disabled = false;
            }
        });
    </script>
</body>

</html>
            <%- include('partials/footer') %>
