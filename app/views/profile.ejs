<!DOCTYPE html>
<html class="dark" lang="en">
<head>
    <%- include('partials/head') %>
    <title><%= user.name %> — HeritEdge Profile</title>
    <style>
        .tab-btn.active { color: #f2b90d; border-bottom-color: #f2b90d; }
        .tab-btn { transition: color 0.2s, border-color 0.2s; }
        .art-mini-card { transition: transform 0.2s, box-shadow 0.2s; }
        .art-mini-card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(0,0,0,0.4); }
    </style>
    <script>
        function toggleEditProfile() {
            document.getElementById('profile-display').classList.toggle('hidden');
            document.getElementById('profile-edit').classList.toggle('hidden');
        }
        function handleAvatarClick() {
            if (<%= !!user.avatar %>) {
                document.getElementById('avatar-modal').classList.remove('hidden');
            } else {
                document.getElementById('quick-avatar-upload').click();
            }
        }
        function closeAvatarModal() { document.getElementById('avatar-modal').classList.add('hidden'); }
        function validateAvatarSize(input) {
            if (input.files?.[0]) {
                if (input.files[0].size > 5 * 1024 * 1024) { alert('File size must be under 5MB!'); input.value = ''; }
                else document.getElementById('quick-avatar-form').submit();
            }
        }
    </script>
</head>
<body class="bg-background-dark min-h-screen text-white">
    <div class="relative flex min-h-screen w-full flex-col overflow-x-hidden">
        <%- include('partials/header') %>

        <!-- Avatar modal -->
        <div id="avatar-modal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/80 backdrop-blur-sm p-4">
            <div class="bg-deep-maroon border border-rich-red/50 rounded-2xl p-7 shadow-2xl w-full max-w-[340px] flex flex-col gap-4 text-center">
                <h3 class="text-xl font-bold text-white mb-1">Profile Picture</h3>
                <button onclick="closeAvatarModal(); document.getElementById('quick-avatar-upload').click();"
                    class="w-full py-3 bg-white/8 hover:bg-white/15 text-white font-bold rounded-xl transition-colors border border-white/12 text-sm">
                    Change Picture
                </button>
                <form action="/profile/remove-avatar?_csrf=<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" method="POST">
                    <button type="submit" class="w-full py-3 bg-red-500/15 hover:bg-red-500/30 text-red-400 font-bold rounded-xl transition-colors border border-red-500/20 text-sm">
                        Remove Picture
                    </button>
                </form>
                <button onclick="closeAvatarModal()" class="text-white/50 hover:text-white text-sm font-semibold transition-colors mt-1">Cancel</button>
            </div>
        </div>

        <form id="quick-avatar-form" action="/profile?_csrf=<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" method="POST" enctype="multipart/form-data" class="hidden">
            <input type="hidden" name="name" value="<%= user.name %>">
            <input type="hidden" name="email" value="<%= user.email %>">
            <input type="file" id="quick-avatar-upload" name="avatar" accept="image/*" onchange="validateAvatarSize(this)">
        </form>

        <main class="flex-1 max-w-[1100px] mx-auto w-full px-4 md:px-8 py-10">

            <!-- Flash messages -->
            <% if (typeof message !== 'undefined' && message) { %>
                <div class="bg-jade-green/15 border border-jade-green/40 text-jade-green p-4 rounded-xl mb-6 text-sm font-semibold flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">check_circle</span>
                    <%= message.replace(/\+/g, ' ') %>
                </div>
            <% } %>
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="bg-red-500/15 border border-red-500/30 text-red-400 p-4 rounded-xl mb-6 text-sm font-semibold flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">error</span>
                    <%= error === 'email_exists' ? 'Email already in use.' : error %>
                </div>
            <% } %>

            <div class="grid grid-cols-1 lg:grid-cols-[320px_1fr] gap-8 xl:gap-12">

                <!-- ── LEFT SIDEBAR ── -->
                <div class="flex flex-col gap-6">

                    <!-- Avatar + name card -->
                    <div class="bg-deep-maroon/25 border border-white/8 rounded-2xl overflow-hidden">
                        <!-- Cover gradient -->
                        <div class="h-24 w-full" style="background: linear-gradient(135deg, #3f101a 0%, #8b0000 50%, #3f101a 100%);"></div>

                        <div class="px-6 pb-6 -mt-12">
                            <div class="w-20 h-20 rounded-2xl overflow-hidden border-4 border-background-dark shadow-xl cursor-pointer hover:scale-105 transition-transform relative group mb-4"
                                onclick="handleAvatarClick()">
                                <img src="<%= user.avatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name) + '&background=3f101a&color=f2b90d&size=160&bold=true' %>"
                                    class="w-full h-full object-cover" alt="<%= user.name %>">
                                <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                                    <span class="material-symbols-outlined text-white text-[22px]">photo_camera</span>
                                </div>
                            </div>

                            <h1 class="text-2xl font-bold text-white leading-tight mb-1"><%= user.name %></h1>
                            <p class="text-white/60 text-sm mb-4">@<%= user.email.split('@')[0] %></p>

                            <div class="flex flex-wrap gap-2 mb-5">
                                <span class="px-3 py-1 bg-amber-yellow/10 border border-amber-yellow/25 text-amber-yellow text-xs font-bold rounded-full">
                                    <%= user.role === 'BUYER' ? 'Collector' : user.role === 'CREATOR' ? 'Artist' : user.role %>
                                </span>
                                <% if (user.region) { %>
                                    <span class="px-3 py-1 bg-white/6 border border-white/12 text-white/70 text-xs font-semibold rounded-full flex items-center gap-1">
                                        <span class="material-symbols-outlined text-[12px]">location_on</span>
                                        <%= user.region %>
                                    </span>
                                <% } %>
                            </div>

                            <% if (user.bio) { %>
                                <p class="text-white/70 text-sm leading-relaxed mb-5"><%= user.bio %></p>
                            <% } else { %>
                                <p class="text-white/40 text-sm italic mb-5">No bio yet — add your story!</p>
                            <% } %>

                            <% if (user.portfolioUrl) { %>
                                <a href="<%= user.portfolioUrl %>" target="_blank" rel="noopener"
                                    class="flex items-center gap-2 text-amber-yellow text-sm font-semibold hover:underline mb-4">
                                    <span class="material-symbols-outlined text-[16px]">link</span>
                                    View Portfolio
                                </a>
                            <% } %>

                            <!-- Edit profile toggle -->
                            <div id="profile-display">
                                <button onclick="toggleEditProfile()"
                                    class="w-full flex items-center justify-center gap-2 py-2.5 bg-white/6 hover:bg-white/12 text-white font-semibold text-sm rounded-xl transition-colors border border-white/12">
                                    <span class="material-symbols-outlined text-[16px]">edit</span>
                                    Edit Profile
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Edit form (collapsed by default) -->
                    <div id="profile-edit" class="hidden bg-deep-maroon/30 border border-rich-red/30 rounded-2xl p-6">
                        <div class="flex items-center justify-between mb-5">
                            <h3 class="text-lg font-bold text-amber-yellow">Edit Details</h3>
                            <button onclick="toggleEditProfile()" class="text-white/40 hover:text-white transition-colors">
                                <span class="material-symbols-outlined">close</span>
                            </button>
                        </div>
                        <form action="/profile?_csrf=<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" method="POST" enctype="multipart/form-data" class="flex flex-col gap-4">
                            <div>
                                <label class="text-white/50 text-xs font-bold uppercase tracking-wider block mb-1.5">Full Name</label>
                                <input type="text" name="name" value="<%= user.name %>" required
                                    class="w-full bg-black/30 border border-white/20 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-amber-yellow transition-colors">
                            </div>
                            <div>
                                <label class="text-white/50 text-xs font-bold uppercase tracking-wider block mb-1.5">Email</label>
                                <input type="email" name="email" value="<%= user.email %>" required
                                    class="w-full bg-black/30 border border-white/20 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-amber-yellow transition-colors">
                            </div>
                            <div>
                                <label class="text-white/50 text-xs font-bold uppercase tracking-wider block mb-1.5">Bio</label>
                                <textarea name="bio" rows="3" class="w-full bg-black/30 border border-white/20 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-amber-yellow transition-colors resize-none"><%= user.bio || '' %></textarea>
                            </div>
                            <div>
                                <label class="text-white/50 text-xs font-bold uppercase tracking-wider block mb-1.5">Region</label>
                                <input type="text" name="region" value="<%= user.region || '' %>"
                                    class="w-full bg-black/30 border border-white/20 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-amber-yellow transition-colors">
                            </div>
                            <div>
                                <label class="text-white/50 text-xs font-bold uppercase tracking-wider block mb-1.5">Portfolio URL</label>
                                <input type="url" name="portfolioUrl" value="<%= user.portfolioUrl || '' %>" placeholder="https://"
                                    class="w-full bg-black/30 border border-white/20 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-amber-yellow transition-colors">
                            </div>
                            <div class="pt-3 border-t border-white/8">
                                <label class="text-white/50 text-xs font-bold uppercase tracking-wider block mb-1.5">Profile Image</label>
                                <input type="file" name="avatar" accept="image/*"
                                    class="w-full text-sm text-white/60 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-rich-red file:text-white hover:file:bg-deep-maroon cursor-pointer bg-black/20 border border-white/12 rounded-lg p-2">
                            </div>
                            <button type="submit" class="w-full py-3 bg-amber-yellow hover:bg-amber-yellow/90 text-background-dark font-bold text-sm rounded-xl transition-colors mt-1 shadow-lg">
                                Save Changes
                            </button>
                        </form>
                    </div>

                    <!-- Application status / quick links -->
                    <div class="flex flex-col gap-2 text-sm">
                        <% if (typeof application !== 'undefined' && application) { %>
                            <% if (application.status === 'PENDING') { %>
                                <div class="p-4 bg-amber-yellow/6 border border-amber-yellow/20 rounded-xl">
                                    <p class="text-white/50 text-[10px] font-bold uppercase tracking-wider mb-2.5">Artist Application</p>
                                    <div class="flex items-center gap-2 mb-1.5">
                                        <span class="w-2 h-2 rounded-full bg-amber-yellow animate-pulse flex-shrink-0"></span>
                                        <span class="text-amber-yellow font-bold text-sm">Under Review</span>
                                    </div>
                                    <p class="text-white/60 text-xs leading-relaxed">Our team is reviewing your application. We'll notify you soon.</p>
                                </div>
                            <% } else if (application.status === 'APPROVED') { %>
                                <div class="p-4 bg-jade-green/8 border border-jade-green/20 rounded-xl">
                                    <p class="text-white/50 text-[10px] font-bold uppercase tracking-wider mb-2.5">Artist Application</p>
                                    <div class="flex items-center gap-2 mb-1.5">
                                        <span class="material-symbols-outlined text-jade-green text-[16px] flex-shrink-0" style="font-variation-settings:'FILL' 1">check_circle</span>
                                        <span class="text-jade-green font-bold text-sm">Approved!</span>
                                    </div>
                                    <p class="text-white/60 text-xs mb-3">You're a HeritEdge Creator. Start sharing your work.</p>
                                    <a href="/creator/home" class="flex items-center justify-center gap-1 py-2 bg-amber-yellow text-background-dark font-bold text-xs rounded-lg hover:bg-amber-yellow/90 transition-colors">
                                        Go to Dashboard →
                                    </a>
                                </div>
                            <% } else if (application.status === 'REJECTED') { %>
                                <div class="p-4 bg-red-500/6 border border-red-500/20 rounded-xl">
                                    <p class="text-white/50 text-[10px] font-bold uppercase tracking-wider mb-2.5">Artist Application</p>
                                    <div class="flex items-center gap-2 mb-1.5">
                                        <span class="material-symbols-outlined text-red-400 text-[16px] flex-shrink-0" style="font-variation-settings:'FILL' 1">cancel</span>
                                        <span class="text-red-400 font-bold text-sm">Not Approved</span>
                                    </div>
                                    <p class="text-white/60 text-xs mb-3">You may reapply after reviewing our guidelines.</p>
                                    <a href="/become-artist" class="flex items-center justify-center gap-1 py-2 bg-white/8 border border-white/12 text-white font-bold text-xs rounded-lg hover:bg-white/12 transition-colors">
                                        Apply Again
                                    </a>
                                </div>
                            <% } %>
                        <% } else if (user.role === 'BUYER') { %>
                            <a href="/become-artist" class="flex items-center gap-2 px-4 py-3 bg-amber-yellow/8 border border-amber-yellow/25 text-amber-yellow font-semibold rounded-xl hover:bg-amber-yellow hover:text-background-dark transition-all">
                                <span class="material-symbols-outlined text-[18px]">palette</span>
                                Apply to become an Artist
                            </a>
                        <% } %>
                        <a href="/logout" class="flex items-center gap-2 px-4 py-3 bg-white/5 border border-white/10 text-white/60 hover:text-white font-semibold rounded-xl hover:bg-white/8 transition-all">
                            <span class="material-symbols-outlined text-[18px]">logout</span>
                            Sign Out
                        </a>
                    </div>
                </div>

                <!-- ── RIGHT MAIN ── -->
                <div class="flex flex-col gap-0">

                    <!-- Tabs -->
                    <div class="flex border-b border-white/10 mb-8 gap-0 overflow-x-auto">
                        <button id="tab-orders" onclick="showTab('orders')"
                            class="tab-btn active inline-flex items-center gap-1.5 px-4 py-3 text-sm font-bold border-b-2 border-amber-yellow text-amber-yellow whitespace-nowrap">
                            Recent Orders
                        </button>
                        <button id="tab-collection" onclick="showTab('collection')"
                            class="tab-btn inline-flex items-center gap-1.5 px-4 py-3 text-sm font-bold border-b-2 border-transparent text-white/60 hover:text-white whitespace-nowrap">
                            Saved Collection
                        </button>
                        <button id="tab-cart" onclick="showTab('cart')"
                            class="tab-btn inline-flex items-center gap-1.5 px-4 py-3 text-sm font-bold border-b-2 border-transparent text-white/60 hover:text-white whitespace-nowrap">
                            My Cart
                            <span class="he-cart-badge hidden w-[18px] h-[18px] bg-amber-yellow text-background-dark text-[10px] font-black rounded-full items-center justify-center leading-none flex-shrink-0">0</span>
                        </button>
                        <button id="tab-following" onclick="showTab('following')"
                            class="tab-btn inline-flex items-center gap-1.5 px-4 py-3 text-sm font-bold border-b-2 border-transparent text-white/60 hover:text-white whitespace-nowrap">
                            Following
                        </button>
                        <button id="tab-notifications" onclick="showTab('notifications')"
                            class="tab-btn inline-flex items-center gap-1.5 px-4 py-3 text-sm font-bold border-b-2 border-transparent text-white/60 hover:text-white whitespace-nowrap">
                            Notifications
                            <%
                              const _unread = (typeof notifications !== 'undefined' && notifications)
                                ? notifications.filter(function(n){ return !n.read; }).length
                                : 0;
                            %>
                            <% if (_unread > 0) { %>
                                <span class="inline-flex w-[18px] h-[18px] bg-amber-yellow text-background-dark text-[10px] font-black rounded-full items-center justify-center leading-none flex-shrink-0"><%= _unread > 9 ? '9+' : _unread %></span>
                            <% } %>
                        </button>
                    </div>

                    <!-- Orders panel -->
                    <div id="panel-orders" class="tab-panel">
                        <% if (typeof orders !== 'undefined' && orders.length > 0) { %>
                            <div class="flex flex-col gap-3">
                                <% orders.forEach(order => { %>
                                    <div class="flex gap-4 bg-white/4 border border-white/8 rounded-xl p-4 hover:border-white/15 transition-colors art-mini-card">
                                        <div class="w-14 h-14 rounded-xl overflow-hidden shrink-0 border border-white/12">
                                            <img src="<%= order.artwork.images?.[0] || '/images/placeholder.jpg' %>" class="w-full h-full object-cover">
                                        </div>
                                        <div class="flex-1 flex flex-col justify-center gap-1">
                                            <div class="flex items-center justify-between gap-4">
                                                <a href="/artwork/<%= order.artworkId %>" class="font-bold text-white text-sm hover:text-amber-yellow transition-colors line-clamp-1">
                                                    <%= order.artwork.title %>
                                                </a>
                                                <span class="text-amber-yellow font-bold text-sm shrink-0">रू <%= order.amount %></span>
                                            </div>
                                            <div class="flex items-center gap-3">
                                                <span class="text-xs text-white/60">
                                                    <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                                </span>
                                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full border
                                                    <%= order.orderStatus === 'DELIVERED' ? 'text-jade-green border-jade-green/30 bg-jade-green/10' :
                                                       order.orderStatus === 'CANCELLED' ? 'text-red-400 border-red-400/30 bg-red-400/10' :
                                                       'text-amber-yellow border-amber-yellow/30 bg-amber-yellow/10' %>">
                                                    <%= order.orderStatus %>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="flex flex-col items-center justify-center py-20 text-center border border-white/8 rounded-2xl bg-white/2">
                                <span class="material-symbols-outlined text-5xl text-white/15 mb-4">receipt_long</span>
                                <p class="text-white/50 text-base font-semibold mb-1">No orders yet</p>
                                <p class="text-white/35 text-sm mb-6">Find something you love on the marketplace.</p>
                                <a href="/marketplace" class="px-5 py-2.5 bg-amber-yellow text-background-dark font-bold text-sm rounded-xl hover:bg-amber-yellow/90 transition-colors">
                                    Browse Marketplace
                                </a>
                            </div>
                        <% } %>
                    </div>

                    <!-- Collection panel -->
                    <div id="panel-collection" class="tab-panel hidden">
                        <div id="collection-grid" class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-4">
                            <!-- Populated by JS -->
                        </div>
                        <div id="collection-empty" class="hidden flex-col items-center justify-center py-20 text-center border border-white/8 rounded-2xl bg-white/2">
                            <span class="material-symbols-outlined text-5xl text-white/15 mb-4">favorite</span>
                            <p class="text-white/50 text-base font-semibold mb-1">No saved artworks</p>
                            <p class="text-white/35 text-sm mb-6">Click the ♥ icon on any artwork to save it here.</p>
                            <a href="/marketplace" class="px-5 py-2.5 bg-amber-yellow text-background-dark font-bold text-sm rounded-xl hover:bg-amber-yellow/90 transition-colors">
                                Explore Art
                            </a>
                        </div>
                    </div>

                    <!-- Cart panel -->
                    <div id="panel-cart" class="tab-panel hidden">
                        <div id="cart-grid" class="flex flex-col gap-4"></div>
                        <div id="cart-empty" class="hidden flex-col items-center justify-center py-20 text-center border border-white/8 rounded-2xl bg-white/2">
                            <span class="material-symbols-outlined text-5xl text-white/15 mb-4">shopping_cart</span>
                            <p class="text-white/50 text-base font-semibold mb-1">Your cart is empty</p>
                            <p class="text-white/35 text-sm mb-6">Add artworks to your cart while browsing.</p>
                            <a href="/marketplace" class="px-5 py-2.5 bg-amber-yellow text-background-dark font-bold text-sm rounded-xl hover:bg-amber-yellow/90 transition-colors">
                                Browse Marketplace
                            </a>
                        </div>
                    </div>

                    <!-- Notifications panel -->
                    <div id="panel-notifications" class="tab-panel hidden">
                        <% if (typeof notifications !== 'undefined' && notifications && notifications.length > 0) { %>
                            <div class="flex flex-col gap-2">
                                <% notifications.forEach(function(notif) { %>
                                    <%
                                      const _ico = notif.type === 'APPLICATION_APPROVED' ? 'check_circle'
                                                 : notif.type === 'APPLICATION_REJECTED' ? 'cancel'
                                                 : 'notifications';
                                      const _col = notif.type === 'APPLICATION_APPROVED' ? 'text-jade-green'
                                                 : notif.type === 'APPLICATION_REJECTED' ? 'text-red-400'
                                                 : 'text-amber-yellow';
                                    %>
                                    <div class="flex gap-4 rounded-xl p-4 border transition-colors
                                                <%= notif.read ? 'bg-white/3 border-white/8' : 'bg-amber-yellow/5 border-amber-yellow/20' %>">
                                        <span class="material-symbols-outlined text-[22px] flex-shrink-0 mt-0.5 <%= _col %>"
                                              style="font-variation-settings:'FILL' 1"><%= _ico %></span>
                                        <div class="flex-1">
                                            <p class="text-white/90 text-sm leading-relaxed"><%= notif.message %></p>
                                            <p class="text-white/40 text-xs mt-1.5">
                                                <%= new Date(notif.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>
                                            </p>
                                        </div>
                                        <% if (!notif.read) { %>
                                            <span class="w-2 h-2 rounded-full bg-amber-yellow flex-shrink-0 mt-2"></span>
                                        <% } %>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="flex flex-col items-center justify-center py-20 text-center border border-white/8 rounded-2xl bg-white/2">
                                <span class="material-symbols-outlined text-5xl text-white/15 mb-4">notifications_off</span>
                                <p class="text-white/50 text-base font-semibold mb-1">No notifications</p>
                                <p class="text-white/35 text-sm">You're all caught up — nothing new here.</p>
                            </div>
                        <% } %>
                    </div>

                    <!-- Following panel -->
                    <div id="panel-following" class="tab-panel hidden">
                        <div id="following-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-4"></div>
                        <div id="following-empty" class="hidden flex-col items-center justify-center py-20 text-center border border-white/8 rounded-2xl bg-white/2">
                            <span class="material-symbols-outlined text-5xl text-white/15 mb-4">person_add</span>
                            <p class="text-white/50 text-base font-semibold mb-1">Not following anyone</p>
                            <p class="text-white/35 text-sm mb-6">Follow artists to see their updates here.</p>
                            <a href="/marketplace" class="px-5 py-2.5 bg-amber-yellow text-background-dark font-bold text-sm rounded-xl hover:bg-amber-yellow/90 transition-colors">
                                Discover Artists
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </main>

        <%- include('partials/footer') %>
    </div>

    <script>
        // Read initial tab from URL param
        const urlTab = new URLSearchParams(window.location.search).get('tab');
        if (urlTab) showTab(urlTab);

        function showTab(id) {
            document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(b => {
                b.classList.remove('active', 'text-amber-yellow', 'border-amber-yellow');
                b.classList.add('text-white/60', 'border-transparent');
            });
            const panel = document.getElementById('panel-' + id);
            const btn = document.getElementById('tab-' + id);
            if (panel) panel.classList.remove('hidden');
            if (btn) {
                btn.classList.add('active', 'text-amber-yellow', 'border-amber-yellow');
                btn.classList.remove('text-white/60', 'border-transparent');
            }
            if (id === 'collection') renderCollection();
            if (id === 'cart') renderCart();
            if (id === 'following') renderFollowing();
        }

        function artCard(item, removeCallback) {
            return `<div class="art-mini-card flex flex-col bg-deep-maroon/30 border border-white/8 rounded-xl overflow-hidden hover:border-amber-yellow/35 transition-all">
                <div class="aspect-square overflow-hidden bg-black/20 relative">
                    <img src="${item.image || '/images/placeholder.jpg'}" class="w-full h-full object-cover" onerror="this.src='/images/placeholder.jpg'">
                </div>
                <div class="p-3 flex flex-col gap-2">
                    <a href="/artwork/${item.id}" class="text-white text-xs font-bold line-clamp-1 hover:text-amber-yellow transition-colors">${item.title}</a>
                    <div class="flex items-center justify-between gap-2">
                        <span class="text-amber-yellow text-sm font-bold">रू ${item.price}</span>
                        <button onclick="${removeCallback}" class="text-white/40 hover:text-red-400 transition-colors text-[11px] font-bold flex items-center gap-1">
                            <span class="material-symbols-outlined text-[14px]">delete</span>
                        </button>
                    </div>
                </div>
            </div>`;
        }

        function renderCollection() {
            const items = HE.col.get();
            const grid = document.getElementById('collection-grid');
            const empty = document.getElementById('collection-empty');
            if (items.length === 0) {
                grid.innerHTML = '';
                empty.classList.remove('hidden');
                empty.classList.add('flex');
            } else {
                empty.classList.add('hidden');
                empty.classList.remove('flex');
                grid.innerHTML = items.map(item =>
                    artCard(item, `HE.col.toggle({id:'${item.id}'},null);renderCollection();`)
                ).join('');
            }
        }

        function renderCart() {
            const items = HE.cart.get();
            const grid = document.getElementById('cart-grid');
            const empty = document.getElementById('cart-empty');
            if (items.length === 0) {
                grid.innerHTML = '';
                empty.classList.remove('hidden');
                empty.classList.add('flex');
            } else {
                empty.classList.add('hidden');
                empty.classList.remove('flex');
                const total = items.reduce((s, i) => s + Number(i.price || 0), 0);
                grid.innerHTML = items.map(item => `
                    <div class="flex gap-4 bg-white/4 border border-white/8 rounded-xl p-4 hover:border-white/15 transition-colors">
                        <div class="w-16 h-16 rounded-xl overflow-hidden shrink-0 border border-white/12">
                            <img src="${item.image || '/images/placeholder.jpg'}" class="w-full h-full object-cover" onerror="this.src='/images/placeholder.jpg'">
                        </div>
                        <div class="flex-1 flex flex-col justify-center gap-1">
                            <a href="/artwork/${item.id}" class="font-bold text-white text-sm hover:text-amber-yellow transition-colors line-clamp-1">${item.title}</a>
                            <span class="text-amber-yellow font-bold text-sm">रू ${item.price}</span>
                        </div>
                        <div class="flex flex-col items-end justify-between">
                            <button onclick="HE.cart.remove('${item.id}');renderCart();"
                                class="text-white/40 hover:text-red-400 transition-colors">
                                <span class="material-symbols-outlined text-[18px]">close</span>
                            </button>
                            <a href="/artwork/${item.id}" class="text-xs text-amber-yellow font-bold hover:underline">Buy Now</a>
                        </div>
                    </div>
                `).join('') +
                `<div class="flex items-center justify-between px-4 py-3 bg-amber-yellow/8 border border-amber-yellow/20 rounded-xl mt-2">
                    <span class="text-white font-semibold text-sm">Total (${items.length} item${items.length !== 1 ? 's' : ''})</span>
                    <span class="text-amber-yellow font-bold text-lg">रू ${total.toLocaleString()}</span>
                </div>`;
            }
        }

        function renderFollowing() {
            const items = HE.following.get();
            const grid = document.getElementById('following-grid');
            const empty = document.getElementById('following-empty');
            if (items.length === 0) {
                grid.innerHTML = '';
                empty.classList.remove('hidden');
                empty.classList.add('flex');
            } else {
                empty.classList.add('hidden');
                empty.classList.remove('flex');
                grid.innerHTML = items.map(a => `
                    <div class="flex items-center gap-4 bg-white/4 border border-white/8 rounded-xl p-4 hover:border-amber-yellow/25 transition-colors">
                        <div class="w-12 h-12 rounded-xl overflow-hidden shrink-0 bg-deep-maroon/60 border border-white/12 flex items-center justify-center">
                            ${a.avatar ? `<img src="${a.avatar}" class="w-full h-full object-cover">` : `<span class="text-amber-yellow font-bold text-lg">${(a.name||'?')[0]}</span>`}
                        </div>
                        <div class="flex-1">
                            <a href="/artist/${a.id}" class="font-bold text-white text-sm hover:text-amber-yellow transition-colors">${a.name}</a>
                            ${a.region ? `<p class="text-white/50 text-xs mt-0.5">${a.region}</p>` : ''}
                        </div>
                        <button onclick="HE.following.toggle({id:'${a.id}',name:'${a.name}'},this);renderFollowing();"
                            class="text-[10px] font-bold px-3 py-1.5 bg-white/6 border border-white/12 text-white/60 rounded-lg hover:text-red-400 hover:border-red-400/30 transition-all">
                            Unfollow
                        </button>
                    </div>
                `).join('');
            }
        }

        // Initialize active tab panel on load
        document.addEventListener('DOMContentLoaded', () => {
            const activeTab = urlTab || 'orders';
            showTab(activeTab);
        });
    </script>
</body>
</html>
