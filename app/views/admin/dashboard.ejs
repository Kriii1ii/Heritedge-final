<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <%- include('../partials/head') %>
</head>

<body class="bg-background-light dark:bg-background-dark min-h-screen">
    <div class="layout-container flex h-full grow flex-col">
        <%- include('../partials/header') %>
            <main class="flex flex-1 justify-center py-8 px-4 md:px-10">
                <div class="layout-content-container flex flex-col max-w-[1200px] flex-1">

                    <div class="flex flex-wrap justify-between gap-3 mb-8">
                        <div class="flex flex-col gap-1">
                            <p class="text-white text-3xl font-black leading-tight font-mono-header">
                                Admin Dashboard
                            </p>
                            <p class="text-white/60 text-sm font-mono uppercase tracking-widest">
                                Platform Moderation & Overview
                            </p>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-6 mb-12">
                        <div
                            class="flex flex-col gap-2 rounded-sm p-4 lg:p-6 border border-white/10 bg-white/5 backdrop-blur shadow-lg">
                            <div class="flex items-center justify-between mb-2">
                                <p class="text-white/60 text-xs font-medium uppercase tracking-wider font-mono-header">
                                    Total Users</p>
                                <span class="material-symbols-outlined text-amber-yellow text-sm">group</span>
                            </div>
                            <p class="text-white tracking-light text-2xl lg:text-3xl font-bold font-mono">
                                <%= totalUsers %>
                            </p>
                        </div>
                        <div
                            class="flex flex-col gap-2 rounded-sm p-4 lg:p-6 border border-white/10 bg-white/5 backdrop-blur shadow-lg">
                            <div class="flex items-center justify-between mb-2">
                                <p class="text-white/60 text-xs font-medium uppercase tracking-wider font-mono-header">
                                    Total Artworks</p>
                                <span class="material-symbols-outlined text-amber-yellow text-sm">palette</span>
                            </div>
                            <p class="text-white tracking-light text-2xl lg:text-3xl font-bold font-mono">
                                <%= totalArtworks %>
                            </p>
                        </div>
                        <div
                            class="flex flex-col gap-2 rounded-sm p-4 lg:p-6 border border-white/10 bg-white/5 backdrop-blur shadow-lg">
                            <div class="flex items-center justify-between mb-2">
                                <p class="text-white/60 text-xs font-medium uppercase tracking-wider font-mono-header">
                                    Total Orders</p>
                                <span class="material-symbols-outlined text-amber-yellow text-sm">shopping_cart</span>
                            </div>
                            <p class="text-white tracking-light text-2xl lg:text-3xl font-bold font-mono">
                                <%= totalOrders %>
                            </p>
                        </div>
                        <div
                            class="flex flex-col gap-2 rounded-sm p-4 lg:p-6 border border-white/10 bg-white/5 backdrop-blur shadow-lg">
                            <div class="flex items-center justify-between mb-2">
                                <p class="text-white/60 text-xs font-medium uppercase tracking-wider font-mono-header">
                                    Total Revenue</p>
                                <span class="material-symbols-outlined text-jade-green text-sm">payments</span>
                            </div>
                            <p class="text-white tracking-light text-2xl lg:text-3xl font-bold font-mono">
                                $<%= revenue %>
                            </p>
                        </div>
                        <div
                            class="flex flex-col gap-2 rounded-sm p-4 lg:p-6 border border-white/10 bg-white/5 backdrop-blur shadow-lg">
                            <div class="flex items-center justify-between mb-2">
                                <p class="text-white/60 text-xs font-medium uppercase tracking-wider font-mono-header">
                                    Total Events</p>
                                <span class="material-symbols-outlined text-amber-yellow text-sm">event</span>
                            </div>
                            <p class="text-white tracking-light text-2xl lg:text-3xl font-bold font-mono">
                                <%= totalEvents %>
                            </p>
                        </div>
                        <div
                            class="flex flex-col gap-2 rounded-sm p-4 lg:p-6 border border-white/10 bg-white/5 backdrop-blur shadow-lg">
                            <div class="flex items-center justify-between mb-2">
                                <p class="text-white/60 text-xs font-medium uppercase tracking-wider font-mono-header">
                                    Pending</p>
                                <span class="material-symbols-outlined text-red-400 text-sm">gpp_maybe</span>
                            </div>
                            <p class="text-red-400 tracking-light text-2xl lg:text-3xl font-bold font-mono">
                                <%= pendingCreators.length %>
                            </p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
                        <a href="/admin/orders"
                            class="w-full flex items-center justify-between p-4 bg-white/5 border border-white/20 rounded-sm hover:border-amber-yellow hover:text-amber-yellow transition-all text-white font-mono-header font-bold text-lg cursor-pointer">
                            <div class="flex items-center gap-3">
                                <span class="material-symbols-outlined text-amber-yellow text-2xl">local_shipping</span>
                                Manage Orders & Logistics
                            </div>
                            <span class="material-symbols-outlined">chevron_right</span>
                        </a>
                        <a href="/admin/users"
                            class="w-full flex items-center justify-between p-4 bg-white/5 border border-white/20 rounded-sm hover:border-amber-yellow hover:text-amber-yellow transition-all text-white font-mono-header font-bold text-lg cursor-pointer">
                            <div class="flex items-center gap-3">
                                <span
                                    class="material-symbols-outlined text-amber-yellow text-2xl">manage_accounts</span>
                                Manage Platform Users
                            </div>
                            <span class="material-symbols-outlined">chevron_right</span>
                        </a>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">

                        <!-- Pending Creators Panel -->
                        <div class="flex flex-col">
                            <div class="flex items-center justify-between px-2 pb-4 border-b border-white/10 mb-4">
                                <h2 class="text-white text-xl font-bold tracking-tight font-mono-header">Creator
                                    Verifications</h2>
                            </div>
                            <div
                                class="bg-white/5 rounded-sm border border-white/10 shadow-lg flex flex-col overflow-hidden">
                                <% if (pendingCreators && pendingCreators.length> 0) { %>
                                    <div class="divide-y divide-white/5">
                                        <% pendingCreators.forEach(creator=> { %>
                                            <div class="flex flex-col gap-3 p-5 hover:bg-white/5 transition-colors">
                                                <div class="flex justify-between items-start">
                                                    <div>
                                                        <p class="text-white font-bold font-mono text-lg">
                                                            <%= creator.name %>
                                                        </p>
                                                        <p class="text-white/50 text-xs">
                                                            <%= creator.email %>
                                                        </p>
                                                    </div>
                                                    <span
                                                        class="text-[10px] bg-amber-yellow/20 text-amber-yellow px-2 py-1 rounded uppercase font-bold">Pending</span>
                                                </div>

                                                <% if(creator.bio || creator.region) { %>
                                                    <div
                                                        class="text-sm text-white/70 italic border-l-2 border-white/20 pl-3">
                                                        <% if(creator.region) { %><span
                                                                class="block text-xs font-bold not-italic font-mono-header text-white/50 mb-1">
                                                                <%= creator.region %>
                                                            </span>
                                                            <% } %>
                                                                <%= creator.bio || 'No bio provided.' %>
                                                    </div>
                                                    <% } %>

                                                        <div class="flex gap-3 mt-2">
                                                            <form action="/admin/creator/<%= creator.id %>/verify"
                                                                method="POST" class="flex-1">
                                                                <input type="hidden" name="_csrf"
                                                                    value="<%= csrfToken %>">
                                                                <input type="hidden" name="status" value="VERIFIED">
                                                                <button type="submit"
                                                                    class="w-full bg-jade-green/20 hover:bg-jade-green/40 text-jade-green border border-jade-green/30 text-xs font-bold py-2 rounded transition-colors uppercase tracking-wider">Approve</button>
                                                            </form>
                                                            <form action="/admin/creator/<%= creator.id %>/verify"
                                                                method="POST" class="flex-1">
                                                                <input type="hidden" name="_csrf"
                                                                    value="<%= csrfToken %>">
                                                                <input type="hidden" name="status" value="REJECTED">
                                                                <button type="submit"
                                                                    class="w-full bg-red-500/10 hover:bg-red-500/20 text-red-500 border border-red-500/20 text-xs font-bold py-2 rounded transition-colors uppercase tracking-wider">Reject</button>
                                                            </form>
                                                        </div>
                                            </div>
                                            <% }) %>
                                    </div>
                                    <% } else { %>
                                        <div class="p-8 text-center flex flex-col items-center">
                                            <span
                                                class="material-symbols-outlined text-4xl text-white/20 mb-3">check_circle</span>
                                            <p class="text-white/40 italic text-sm">No pending creator verifications.
                                            </p>
                                        </div>
                                        <% } %>
                            </div>
                        </div>

                        <!-- Artworks Moderation Panel -->
                        <div class="flex flex-col">
                            <div class="flex items-center justify-between px-2 pb-4 border-b border-white/10 mb-4">
                                <h2 class="text-white text-xl font-bold tracking-tight font-mono-header">Recent Listed
                                    Artworks</h2>
                            </div>
                            <div
                                class="bg-white/5 rounded-sm border border-white/10 shadow-lg flex flex-col overflow-hidden">
                                <% if (recentArtworks && recentArtworks.length> 0) { %>
                                    <div class="divide-y divide-white/5">
                                        <% recentArtworks.forEach(art=> { %>
                                            <div class="flex items-center gap-4 p-4 hover:bg-white/5 transition-colors">
                                                <div
                                                    class="h-16 w-16 rounded bg-black overflow-hidden shrink-0 border border-white/10">
                                                    <img src="<%= art.images && art.images[0] ? art.images[0] : '/images/placeholder.jpg' %>"
                                                        class="w-full h-full object-cover">
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <a href="/artwork/<%= art.id %>"
                                                        class="text-white hover:text-amber-yellow font-bold font-mono truncate block text-sm transition-colors">
                                                        <%= art.title %>
                                                    </a>
                                                    <p class="text-white/50 text-xs truncate mb-1">By <%=
                                                            art.creator.name %>
                                                    </p>
                                                    <span
                                                        class="inline-block text-[10px] <%= art.status === 'PUBLISHED' ? 'text-jade-green' : 'text-white/40' %> border <%= art.status === 'PUBLISHED' ? 'border-jade-green/30' : 'border-white/20' %> px-1.5 py-0.5 rounded uppercase">
                                                        <%= art.status %>
                                                    </span>
                                                </div>
                                                <div class="shrink-0 flex items-center">
                                                    <form action="/admin/artwork/<%= art.id %>/delete" method="POST"
                                                        onsubmit="return confirm('WARNING: This will permanently delete the artwork and its images. Proceed?');">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <button type="submit"
                                                            class="bg-red-500/10 hover:bg-red-500/30 text-red-500 p-2 rounded-md transition-colors border border-red-500/20 flex items-center justify-center">
                                                            <span
                                                                class="material-symbols-outlined text-sm">delete_forever</span>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                            <% }) %>
                                    </div>
                                    <% } else { %>
                                        <div class="p-8 text-center flex flex-col items-center">
                                            <span
                                                class="material-symbols-outlined text-4xl text-white/20 mb-3">image_not_supported</span>
                                            <p class="text-white/40 italic text-sm">No recent artworks listed.</p>
                                        </div>
                                        <% } %>
                            </div>
                        </div>

                    </div>
                </div>
            </main>
                <%- include('../partials/footer') %>
</div>
</body>

</html>