<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <%- include('../partials/head') %>
</head>

<body class="bg-background-light dark:bg-background-dark min-h-screen">
    <div class="layout-container flex h-full grow flex-col">
        <%- include('../partials/header') %>
            <main class="flex flex-1 py-8 px-4 md:px-10 max-w-[1440px] w-full mx-auto">
                <div class="w-full">
                    <div class="flex flex-wrap justify-between gap-3 mb-8">
                        <div class="flex flex-col gap-1">
                            <p class="text-white text-3xl font-black leading-tight font-mono-header">
                                Manage Users
                            </p>
                            <p class="text-white/60 text-sm font-mono uppercase tracking-widest">
                                Platform user overview
                            </p>
                        </div>
                        <a href="/admin" class="flex items-center text-amber-yellow text-sm hover:underline"><span
                                class="material-symbols-outlined mr-1 text-sm">arrow_back</span> Back to Dashboard</a>
                    </div>

                    <div class="bg-white/5 rounded-sm border border-white/10 shadow-lg overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-white/10 border-b border-white/20">
                                    <th class="p-4 text-white font-mono-header text-sm tracking-wider uppercase">Name
                                    </th>
                                    <th class="p-4 text-white font-mono-header text-sm tracking-wider uppercase">Email
                                    </th>
                                    <th class="p-4 text-white font-mono-header text-sm tracking-wider uppercase">Role
                                    </th>
                                    <th class="p-4 text-white font-mono-header text-sm tracking-wider uppercase">Status
                                    </th>
                                    <th class="p-4 text-white font-mono-header text-sm tracking-wider uppercase">Joined
                                    </th>
                                    <th class="p-4 text-center text-white font-mono-header text-sm tracking-wider uppercase">Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-white/5 font-mono text-sm">
                                <% if (users && users.length> 0) { %>
                                    <% users.forEach(usr=> { %>
                                        <tr class="hover:bg-white/5 transition-colors">
                                            <td class="p-4 text-white/90 font-bold">
                                                <%= usr.name %>
                                            </td>
                                            <td class="p-4 text-white/70">
                                                <%= usr.email %>
                                            </td>
                                            <td class="p-4">
                                                <span
                                                    class="px-2 py-1 rounded text-[10px] font-bold uppercase border 
                                                    <%= usr.role === 'ADMIN' ? 'text-red-400 border-red-400' : 
                                                    (usr.role === 'CREATOR' ? 'text-amber-yellow border-amber-yellow' : 'text-blue-400 border-blue-400') %>">
                                                    <%= usr.role %>
                                                </span>
                                            </td>
                                            <td class="p-4">
                                                <span
                                                    class="px-2 py-1 rounded text-[10px] font-bold uppercase border 
                                                    <%= usr.verificationStatus === 'VERIFIED' ? 'text-jade-green border-jade-green' : 
                                                    (usr.verificationStatus === 'PENDING' ? 'text-yellow-400 border-yellow-400' : 'text-white/50 border-white/50') %>">
                                                    <%= usr.verificationStatus %>
                                                </span>
                                            </td>
                                            <td class="p-4 text-white/50">
                                                <%= new Date(usr.createdAt).toLocaleDateString() %>
                                            </td>
                                            <td class="p-4 flex justify-center">
                                                <% if(usr.role !== 'ADMIN') { %>
                                                <form action="/admin/users/<%= usr.id %>/delete" method="POST"
                                                    onsubmit="return confirm('WARNING: This will permanently delete the user and their artworks. Proceed?');">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <button type="submit"
                                                        class="bg-red-500/10 hover:bg-red-500/30 text-red-500 p-2 rounded-md transition-colors border border-red-500/20 flex items-center justify-center">
                                                        <span class="material-symbols-outlined text-sm">delete_forever</span>
                                                    </button>
                                                </form>
                                                <% } %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="5" class="p-8 text-center text-white/50">No users
                                                        found.</td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>
                <%- include('../partials/footer') %>
</div>
</body>

</html>