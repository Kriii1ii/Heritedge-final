<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <%- include('partials/head') %>
</head>

<body class="bg-background-light dark:bg-background-dark text-white">
    <div class="relative flex h-auto min-h-screen w-full flex-col overflow-x-hidden">
        <%- include('partials/header') %>
            <main class="flex flex-col flex-1">
                <!-- Hero Section (Magazine Style) -->
                <div class="relative w-full min-h-[85vh] md:min-h-[100vh] bg-cover bg-center overflow-hidden border-b border-black/10 dark:border-white/10" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuB8BcCJrgd4ZU3VM0gjVeNMzG5YXf4BEzCzOrVlh6cQOcOzcafsYKwDgiEW-6TXVZbMCVv93qPSEjWMhZI4mTFQGmf3YmayvZHxfDnc60s-t7auR6mF6Wg8FvWadeG_TktFFfXoaW2htYMFc_SYHRX6AB_Kjq3mDZe6LiIA-Rabd3J60lc_YlmojNjsLG3HCU6UD10mTX-ZIgihJmoAdctF4LgKPl-UIEfHlRCT4mH8kkQD0DQ5UJHRJzV2WUrZpL-pjYTFF7fbmp8");'>
                    
                    <div class="absolute inset-0 bg-black/60 z-0 pointer-events-none"></div>

                    <!-- The Background Typography -> Left -->
                    <div class="absolute top-[10%] md:top-[12%] left-[2%] lg:left-[5%] z-10 pointer-events-none origin-bottom-left">
                        <h1 class="flex flex-col text-primary-auth font-serif uppercase tracking-tighter drop-shadow-2xl" style="line-height: 0.75;">
                            <span class="text-[6rem] sm:text-[8rem] md:text-[12rem] lg:text-[16rem] xl:text-[18rem]">THE</span>
                            <span class="text-[6rem] sm:text-[8rem] md:text-[12rem] lg:text-[16rem] xl:text-[18rem] pl-4 md:pl-12">ART</span>
                        </h1>
                    </div>

                    <!-- The Background Typography -> Right overlapping -->
                    <div class="absolute bottom-[10%] right-[2%] lg:right-[5%] z-20 pointer-events-none flex flex-col items-end">
                        <span class="text-[3rem] sm:text-[5rem] md:text-[8rem] lg:text-[10rem] xl:text-[12rem] font-serif uppercase tracking-tighter text-white/40 drop-shadow-lg" style="line-height: 0.8;">
                            IS ALWAYS
                        </span>
                        <div class="relative flex flex-col items-end mt-[-1rem] md:mt-[-3rem]">
                            <span class="text-white text-[2.5rem] sm:text-[4rem] md:text-[6rem] lg:text-[8rem] font-serif italic z-30 transform -rotate-3 mr-4 md:mr-10 drop-shadow-2xl" style="line-height: 0.5;">
                                A Story
                            </span>
                            <span class="text-primary-auth text-[5rem] sm:text-[7rem] md:text-[10rem] lg:text-[14rem] xl:text-[16rem] font-serif uppercase tracking-tighter drop-shadow-2xl" style="line-height: 0.8;">
                                TELLS
                            </span>
                        </div>
                    </div>

                    <!-- Top Right Text Block -->
                    <div class="hidden lg:flex flex-col absolute top-[15%] right-[5%] max-w-[280px] z-20 text-right mt-16">
                        <div class="mb-4 flex justify-end">
                            <span class="material-symbols-outlined text-4xl text-white/70">landscape</span>
                        </div>
                        <p class="font-serif text-sm leading-relaxed text-white drop-shadow-md">
                            Each work is an encounter with time — where beauty does not fade, but transforms. We invite you to experience art not as an object on display, but as a living dialogue between the artist and the viewer.
                        </p>
                    </div>

                    <!-- Bottom Left Ticket Block -->
                    <div class="hidden sm:block absolute bottom-[8%] left-[5%] z-30 w-56 bg-black rounded-xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)] group cursor-pointer hover:-translate-y-2 transition-transform duration-300 border border-white/10" onclick="window.location.href='/events'">
                        <!-- Ticket jagged top -->
                        <div class="h-3 w-full flex justify-between px-1 pt-1 opacity-50">
                            <div class="w-2 h-2 rounded-full bg-white/30 -mt-2"></div>
                            <div class="w-2 h-2 rounded-full bg-white/30 -mt-2"></div>
                            <div class="w-2 h-2 rounded-full bg-white/30 -mt-2"></div>
                            <div class="w-2 h-2 rounded-full bg-white/30 -mt-2"></div>
                            <div class="w-2 h-2 rounded-full bg-white/30 -mt-2"></div>
                            <div class="w-2 h-2 rounded-full bg-white/30 -mt-2"></div>
                        </div>
                        
                        <div class="px-6 py-4 flex flex-col gap-5 w-full items-center bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-white/10 to-transparent relative">
                            <div class="w-full text-center text-white text-[0.65rem] tracking-[0.25em] font-medium uppercase group-hover:text-primary-auth transition-colors drop-shadow-md">
                                Buy Ticket
                            </div>
                            
                            <!-- Ticket perforation line -->
                            <div class="w-full border-t-[1.5px] border-dashed border-white/30 relative">
                                <!-- Edge perforation illusion -->
                            </div>

                            <div class="w-full pt-1 relative z-10">
                                <div class="w-full aspect-square border-[6px] border-[#222] p-1.5 bg-[#111]">
                                    <div class="w-full h-full bg-cover bg-center grayscale shadow-inner brightness-75 group-hover:-translate-y-1 transition-transform" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDy-KeotEQn3Frd-pR0hgkCVPMpmAs5GWvCTmujmyirYN9ICN4ZIRhir6aw4PRzYTDbKAkEkGaEPN6Xs6sH0Qq_l6WeY1Gt05Qy1XitTYmFUBKMbPPWusfdJ1Ho8GeYWHZDPB8o7ilwE90faR4-_apKoJ0aR00OYusEh004o7vK14MowAh1BSSTozH0P3PLKlbGGNnuINmRr_yktTXhx7Tof4mLGFre6Lild4Qtwq78TYjQy9HXoXlpVBNohyUevhtMw2fEYKmcqZs')"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Ticket jagged bottom -->
                        <div class="h-3 w-full flex justify-between px-1 pb-1 opacity-50">
                            <div class="w-2 h-2 rounded-full bg-white/30 -mb-2"></div>
                            <div class="w-2 h-2 rounded-full bg-white/30 -mb-2"></div>
                            <div class="w-2 h-2 rounded-full bg-white/30 -mb-2"></div>
                            <div class="w-2 h-2 rounded-full bg-white/30 -mb-2"></div>
                            <div class="w-2 h-2 rounded-full bg-white/30 -mb-2"></div>
                            <div class="w-2 h-2 rounded-full bg-white/30 -mb-2"></div>
                        </div>
                    </div>
                </div>
                <!-- Community Stories Section -->
                <div class="px-4 md:px-20 py-10 bg-background-light dark:bg-background-dark">
                    <div class="max-w-[1200px] mx-auto">
                        <%- include('partials/community-stories') %>
                    </div>
                </div>
                <!-- Featured Artworks Section -->
                <div class="px-4 md:px-20 py-12 bg-deep-maroon/10 border-t border-rich-red/20">
                    <div class="max-w-[1200px] mx-auto">
                        <div class="flex items-center justify-between px-4 pb-8">
                            <h2 class="text-white text-3xl font-bold font-mono-header">
                                Featured Artworks</h2>
                            <button onclick="window.location.href='/marketplace'"
                                class="bg-rich-red text-white px-5 py-2 rounded-md text-sm font-mono-header hover:bg-rich-red/80 transition-all">
                                Browse Collection
                            </button>
                        </div>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 px-4">
                            <!-- Artwork 1 -->
                            <div class="group">
                                <div
                                    class="relative overflow-hidden rounded-sm border border-white/10 aspect-square mb-3">
                                    <div class="w-full h-full bg-center bg-cover transition-transform duration-500 group-hover:scale-110"
                                        data-alt="Handwoven Nepali Pashmina shawl with traditional patterns"
                                        style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuDy-KeotEQn3Frd-pR0hgkCVPMpmAs5GWvCTmujmyirYN9ICN4ZIRhir6aw4PRzYTDbKAkEkGaEPN6Xs6sH0Qq_l6WeY1Gt05Qy1XitTYmFUBKMbPPWusfdJ1Ho8GeYWHZDPB8o7ilwE90faR4-_apKoJ0aR00OYusEh004o7vK14MowAh1BSSTozH0P3PLKlbGGNnuINmRr_yktTXhx7Tof4mLGFre6Lild4Qtwq78TYjQy9HXoXlpVBNohyUevhtMw2fEYKmcqZs");'>
                                    </div>
                                    <div
                                        class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
                                        <button onclick="window.location.href='/marketplace'"
                                            class="w-full py-2 bg-primary text-background-dark font-bold rounded-md text-xs font-mono-header">Quick
                                            View</button>
                                    </div>
                                </div>
                                <h3 class="text-white font-medium font-mono-header text-sm">Pashmina Tapestry</h3>
                                <p class="text-primary font-bold text-lg">$245.00</p>
                            </div>
                            <!-- Artwork 2 -->
                            <div class="group">
                                <div
                                    class="relative overflow-hidden rounded-sm border border-white/10 aspect-square mb-3">
                                    <div class="w-full h-full bg-center bg-cover transition-transform duration-500 group-hover:scale-110"
                                        data-alt="Bronze casted statue of a Hindu deity from Nepal"
                                        style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBVQ_b84XWcpTgF76lohhBEuJD_befykobre7mOwRvFS8ZM1WdauKCb5spGB0pB53gM-3NMRsQfwrvVwnWqIt6_IGoEH92AYtaV4Y_KXRcwWf4EQASlYE1LO8Bdr_QmeM51SaJ2tJIs8c0e366uzaAcSokHdFwYXLCF3XtyMF7v5rz3oElsbYM64YaP5cwezZSZ3mXYFBhRP1RJQGt-Z5BOoR_Kpev3dOOg4547EeBT0uXfWWaAitgzbyGZGlUpEEugR_sOhHjZAa8");'>
                                    </div>
                                    <div
                                        class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
                                        <button onclick="window.location.href='/marketplace'"
                                            class="w-full py-2 bg-primary text-background-dark font-bold rounded-md text-xs font-mono-header">Quick
                                            View</button>
                                    </div>
                                </div>
                                <h3 class="text-white font-medium font-mono-header text-sm">Bronze Deity Bust</h3>
                                <p class="text-primary font-bold text-lg">$580.00</p>
                            </div>
                            <!-- Artwork 3 -->
                            <div class="group">
                                <div
                                    class="relative overflow-hidden rounded-sm border border-white/10 aspect-square mb-3">
                                    <div class="w-full h-full bg-center bg-cover transition-transform duration-500 group-hover:scale-110"
                                        data-alt="Colorful hand-painted ceramic bowl from Nepal"
                                        style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBZdb2fLge1CBUevJGnuq_9p_r1tdxVfl63ggl4EGKo2boRDbn6wJ_I26ByS-mj83BdWErXM9-P1pDO_nzpc03BOP5hDPnN8dwVbZ3aR8oF2MzCMhLXLYzBrmrIuUq1ehlUgZaDhSI4IR7EAsFSp6KAO4mniyT1-SkYvC0BTmAqXyFk0MXc8XmPSqlFqokvaye3RDo5e-TAkTavBwWg1H2x_1jOW3z2O2q5AqkVsvLdjHtB7nJNqKZMr6X90XSh1A19nIqz71M0RtM");'>
                                    </div>
                                    <div
                                        class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
                                        <button onclick="window.location.href='/marketplace'"
                                            class="w-full py-2 bg-primary text-background-dark font-bold rounded-md text-xs font-mono-header">Quick
                                            View</button>
                                    </div>
                                </div>
                                <h3 class="text-white font-medium font-mono-header text-sm">Mithila Ceramic Bowl</h3>
                                <p class="text-primary font-bold text-lg">$65.00</p>
                            </div>
                            <!-- Artwork 4 -->
                            <div class="group">
                                <div
                                    class="relative overflow-hidden rounded-sm border border-white/10 aspect-square mb-3">
                                    <div class="w-full h-full bg-center bg-cover transition-transform duration-500 group-hover:scale-110"
                                        data-alt="Intricately carved wooden window frame from Kathmandu valley"
                                        style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBjG-_Pd2DCwcrTWnjyJFdehILlgv5VREefs8gfNl4br0a2qiHKx-VN0_TJRcS3vdlc4ONUQS2We3Yrn77ljpn1X9GGctAXMewtMdGCzrt2MnXigLB_qGmF8CR_MQRSPYNgT9rfMpA6DLQhx9FBw6UzXci0yDIqXCWktNSRSVxyP8NUAX-qDFd3wwlzv2qT59RTBBWU4xameVx0QZtxyTVs3Mir2afUxmfX1KRDw1-2Wf3NX0Kln_SiT6KbU_z-gnin7vABVIobXYg");'>
                                    </div>
                                    <div
                                        class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
                                        <button onclick="window.location.href='/marketplace'"
                                            class="w-full py-2 bg-primary text-background-dark font-bold rounded-md text-xs font-mono-header">Quick
                                            View</button>
                                    </div>
                                </div>
                                <h3 class="text-white font-medium font-mono-header text-sm">Mini Carved Window</h3>
                                <p class="text-primary font-bold text-lg">$120.00</p>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
            <!-- Footer -->
            <footer class="bg-deep-maroon border-t border-rich-red px-6 md:px-20 py-12">
                <div class="max-w-[1200px] mx-auto grid grid-cols-1 md:grid-cols-4 gap-12">
                    <div class="col-span-1 md:col-span-1">
                        <div class="flex items-center gap-3 text-white mb-6">
                            <div class="size-16 overflow-hidden rounded-md">
                                <img src="/images/logo.png" alt="HeritEdge Logo"
                                    class="w-full h-full object-contain drop-shadow-md"
                                    onerror="this.onerror=null; this.parentElement.innerHTML='<span class=\'text-amber-yellow font-bold text-xl font-mono border-2 border-amber-yellow p-1\'>HE</span>';" />
                            </div>
                        </div>
                        <p class="text-white/60 text-sm leading-relaxed">Connecting Nepal's heritage to the modern world
                            through the hands of its most resilient artists.</p>
                    </div>
                    <div class="flex flex-col gap-4">
                        <h4 class="text-primary font-mono-header font-bold text-sm uppercase">Quick Links</h4>
                        <a class="text-white/70 hover:text-white text-sm" href="#">Marketplace</a>
                        <a class="text-white/70 hover:text-white text-sm" href="#">Artists Profiles</a>
                        <a class="text-white/70 hover:text-white text-sm" href="#">Cultural Blog</a>
                        <a class="text-white/70 hover:text-white text-sm" href="#">Impact Report</a>
                    </div>
                    <div class="flex flex-col gap-4">
                        <h4 class="text-primary font-mono-header font-bold text-sm uppercase">Support</h4>
                        <a class="text-white/70 hover:text-white text-sm" href="#">Help Center</a>
                        <a class="text-white/70 hover:text-white text-sm" href="/faq">FAQ</a>
                        <a class="text-white/70 hover:text-white text-sm" href="#">Shipping &amp; Returns</a>
                        <a class="text-white/70 hover:text-white text-sm" href="#">Artist Application</a>
                        <a class="text-white/70 hover:text-white text-sm" href="#">Terms of Service</a>
                    </div>
                    <div class="flex flex-col gap-4">
                        <h4 class="text-primary font-mono-header font-bold text-sm uppercase">Newsletter</h4>
                        <p class="text-white/60 text-xs">Join our community to receive updates on new arrivals and
                            artist stories.</p>
                        <div class="flex gap-2">
                            <input
                                class="bg-black/20 border border-white/10 rounded-md px-3 py-2 text-sm w-full focus:ring-1 focus:ring-primary outline-none"
                                placeholder="Email" type="email" />
                            <button class="bg-primary text-background-dark p-2 rounded-md">
                                <span class="material-symbols-outlined text-xl leading-none">send</span>
                            </button>
                        </div>
                    </div>
                </div>
                <div
                    class="max-w-[1200px] mx-auto mt-12 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4">
                    <p class="text-white/40 text-xs font-mono-header">© 2024 HeritEdge Nepal. All rights reserved.</p>
                    <div class="flex gap-6">
                        <a class="text-white/40 hover:text-primary transition-colors" href="#"><span
                                class="material-symbols-outlined">share</span></a>
                        <a class="text-white/40 hover:text-primary transition-colors" href="#"><span
                                class="material-symbols-outlined">public</span></a>
                        <a class="text-white/40 hover:text-primary transition-colors" href="#"><span
                                class="material-symbols-outlined">mail</span></a>
                    </div>
                </div>
            </footer>
    </div>
</body>

</html>