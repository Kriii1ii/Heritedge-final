<!DOCTYPE html>
<html class="dark" lang="en">

<head>
    <%- include('partials/head') %>
</head>

<body class="bg-background-light dark:bg-background-dark text-white">
    <div class="relative flex h-auto min-h-screen w-full flex-col overflow-x-hidden">
        <%- include('partials/header') %>
            <main class="flex flex-col flex-1">
                <!-- Hero Section (Centered Typographical Frame Style) -->
                <div class="relative w-full min-h-[90vh] md:min-h-[100vh] bg-cover bg-center overflow-hidden flex items-center justify-center border-b border-[#f2b90d]/10" style="background-image: url('/images/front_page_bg_6.jpg');">

                    <!-- Background Soft Blur & Dim Overlay -->
                    <div class="absolute inset-0 bg-black/60 backdrop-blur-[5px] z-0 pointer-events-none transition-all duration-500"></div>

                    <!-- Corner Decorative Frames -->
                    <div class="absolute -top-[5%] -left-[5%] md:left-[2%] w-32 md:w-48 aspect-[3/4] border-[6px] md:border-[10px] border-[#b81430] z-0 overflow-hidden shadow-2xl rotate-6 opacity-60">
                        <img src="/images/front_page_bg_3.png" class="w-full h-full object-cover scale-150 transform translate-x-4 grayscale">
                    </div>
                    <div class="absolute -bottom-[5%] -right-[5%] md:right-[2%] w-40 md:w-56 aspect-[4/3] border-[6px] md:border-[10px] border-[#f2b90d] z-0 overflow-hidden shadow-2xl -rotate-6 opacity-60">
                        <img src="/images/ticket_pottery.png" class="w-full h-full object-cover scale-125 transform -translate-y-4 grayscale">
                    </div>

                    <!-- Left Typography Block (Flanking the center symmetrically) -->
                    <div class="absolute right-[50%] top-1/2 -translate-y-[50%] flex flex-col font-serif tracking-tighter text-right z-10 pointer-events-none drop-shadow-[0_15px_30px_rgba(0,0,0,1)] [text-shadow:0_5px_15px_black] pr-[30vw] md:pr-[180px] lg:pr-[200px] xl:pr-[240px]">
                        <span class="text-[2.5rem] sm:text-[3.5rem] md:text-[5rem] lg:text-[7rem] xl:text-[8rem] text-[#f2b90d] leading-[0.8] uppercase font-bold whitespace-nowrap">EVERY</span>
                        <span class="text-[2.5rem] sm:text-[3.5rem] md:text-[5rem] lg:text-[7rem] xl:text-[8rem] text-[#f2b90d] leading-[0.8] uppercase font-bold whitespace-nowrap mt-4 lg:mt-6">ART</span>
                    </div>

                    <!-- Right Typography Block (Flanking the center symmetrically) -->
                    <div class="absolute left-[50%] top-1/2 -translate-y-[50%] flex flex-col font-serif tracking-tighter text-left z-10 pointer-events-none drop-shadow-[0_15px_30px_rgba(0,0,0,1)] [text-shadow:0_5px_15px_black] pl-[30vw] md:pl-[180px] lg:pl-[200px] xl:pl-[240px]">
                        <span class="text-[2.5rem] sm:text-[3.5rem] md:text-[5rem] lg:text-[7rem] xl:text-[8rem] text-[#f2b90d] leading-[0.8] uppercase font-bold whitespace-nowrap">TELLS A</span>
                        <span class="text-[2.5rem] sm:text-[3.5rem] md:text-[5rem] lg:text-[7rem] xl:text-[8rem] text-[#f2b90d] leading-[0.8] uppercase font-bold whitespace-nowrap mt-4 lg:mt-6">STORY.</span>
                    </div>

                    <!-- Center Framed Portrait -->
                    <div class="relative z-20 w-[55vw] max-w-[280px] lg:max-w-[340px] xl:max-w-[400px] aspect-[4/5] rounded-[50%] border-[8px] md:border-[16px] border-[#230f08]/90 shadow-[0_30px_60px_rgba(0,0,0,1)] overflow-hidden pointer-events-auto">
                        <img src="/images/girl_braids.jpg" class="w-full h-full object-cover brightness-95 scale-105 transition-transform duration-700 hover:scale-110">
                        <div class="absolute inset-0 bg-black/10 pointer-events-none"></div>
                    </div>



                    <!-- Bottom Left Anchor Ticket Block -->
                    <div class="hidden sm:flex absolute bottom-[5%] lg:bottom-[8%] left-[2%] lg:left-[3%] z-30 w-20 md:w-28 bg-[#230f08] border-l-[4px] border-r-[4px] border-dotted border-[#f2b90d]/30 shadow-[0_10px_40px_rgba(0,0,0,0.9)] group cursor-pointer hover:-translate-y-2 transition-transform duration-300 flex-col items-center" onclick="window.location.href='/events'">
                        <!-- Top Admittance Section -->
                        <div class="px-2 py-4 w-full flex flex-col gap-3 items-center border-b-2 border-dashed border-[#f2b90d]/40 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#f2b90d]/10 to-transparent">
                            <div class="w-[85%] aspect-square border border-[#f2b90d]/30 p-1 bg-black/80">
                                <div class="w-full h-full bg-cover bg-center grayscale shadow-inner brightness-75 group-hover:grayscale-0 group-hover:brightness-100 transition-all duration-500" style="background-image: url('/images/ticket_pottery.png')"></div>
                            </div>
                        </div>
                        
                        <!-- Bottom Buy Trigger -->
                        <div class="w-full py-3 md:py-4 text-center bg-[#b81430]/20 group-hover:bg-[#b81430] transition-colors duration-300">
                            <span class="text-[#f2b90d] text-[0.5rem] tracking-[0.15em] md:text-[0.55rem] md:tracking-[0.2em] font-bold uppercase group-hover:text-white transition-colors">
                                Buy Ticket
                            </span>
                        </div>
                    </div>
                </div>
                <!-- Community Stories Section -->
                <div class="px-4 md:px-20 py-10 bg-background-light dark:bg-background-dark">
                    <div class="max-w-[1200px] mx-auto">
                        <%- include('partials/community-stories') %>
                    </div>
                </div>
                <!-- Featured Artworks Section -->
                <div class="px-4 md:px-20 py-12 bg-deep-maroon/10 border-t border-rich-red/20">
                    <div class="max-w-[1200px] mx-auto">
                        <div class="flex items-center justify-between px-4 pb-8">
                            <h2 class="text-white text-3xl font-bold font-mono-header">
                                Featured Artworks</h2>
                            <button onclick="window.location.href='/marketplace'"
                                class="bg-rich-red text-white px-5 py-2 rounded-md text-sm font-mono-header hover:bg-rich-red/80 transition-all">
                                Browse Collection
                            </button>
                        </div>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 px-4">
                            <!-- Artwork 1 -->
                            <div class="group">
                                <div
                                    class="relative overflow-hidden rounded-sm border border-white/10 aspect-square mb-3">
                                    <div class="w-full h-full bg-center bg-cover transition-transform duration-500 group-hover:scale-110"
                                        data-alt="Handwoven Nepali Pashmina shawl with traditional patterns"
                                        style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuDy-KeotEQn3Frd-pR0hgkCVPMpmAs5GWvCTmujmyirYN9ICN4ZIRhir6aw4PRzYTDbKAkEkGaEPN6Xs6sH0Qq_l6WeY1Gt05Qy1XitTYmFUBKMbPPWusfdJ1Ho8GeYWHZDPB8o7ilwE90faR4-_apKoJ0aR00OYusEh004o7vK14MowAh1BSSTozH0P3PLKlbGGNnuINmRr_yktTXhx7Tof4mLGFre6Lild4Qtwq78TYjQy9HXoXlpVBNohyUevhtMw2fEYKmcqZs");'>
                                    </div>
                                    <div
                                        class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
                                        <button onclick="window.location.href='/marketplace'"
                                            class="w-full py-2 bg-primary text-background-dark font-bold rounded-md text-xs font-mono-header">Quick
                                            View</button>
                                    </div>
                                </div>
                                <h3 class="text-white font-medium font-mono-header text-sm">Pashmina Tapestry</h3>
                                <p class="text-primary font-bold text-lg">$245.00</p>
                            </div>
                            <!-- Artwork 2 -->
                            <div class="group">
                                <div
                                    class="relative overflow-hidden rounded-sm border border-white/10 aspect-square mb-3">
                                    <div class="w-full h-full bg-center bg-cover transition-transform duration-500 group-hover:scale-110"
                                        data-alt="Bronze casted statue of a Hindu deity from Nepal"
                                        style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBVQ_b84XWcpTgF76lohhBEuJD_befykobre7mOwRvFS8ZM1WdauKCb5spGB0pB53gM-3NMRsQfwrvVwnWqIt6_IGoEH92AYtaV4Y_KXRcwWf4EQASlYE1LO8Bdr_QmeM51SaJ2tJIs8c0e366uzaAcSokHdFwYXLCF3XtyMF7v5rz3oElsbYM64YaP5cwezZSZ3mXYFBhRP1RJQGt-Z5BOoR_Kpev3dOOg4547EeBT0uXfWWaAitgzbyGZGlUpEEugR_sOhHjZAa8");'>
                                    </div>
                                    <div
                                        class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
                                        <button onclick="window.location.href='/marketplace'"
                                            class="w-full py-2 bg-primary text-background-dark font-bold rounded-md text-xs font-mono-header">Quick
                                            View</button>
                                    </div>
                                </div>
                                <h3 class="text-white font-medium font-mono-header text-sm">Bronze Deity Bust</h3>
                                <p class="text-primary font-bold text-lg">$580.00</p>
                            </div>
                            <!-- Artwork 3 -->
                            <div class="group">
                                <div
                                    class="relative overflow-hidden rounded-sm border border-white/10 aspect-square mb-3">
                                    <div class="w-full h-full bg-center bg-cover transition-transform duration-500 group-hover:scale-110"
                                        data-alt="Colorful hand-painted ceramic bowl from Nepal"
                                        style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBZdb2fLge1CBUevJGnuq_9p_r1tdxVfl63ggl4EGKo2boRDbn6wJ_I26ByS-mj83BdWErXM9-P1pDO_nzpc03BOP5hDPnN8dwVbZ3aR8oF2MzCMhLXLYzBrmrIuUq1ehlUgZaDhSI4IR7EAsFSp6KAO4mniyT1-SkYvC0BTmAqXyFk0MXc8XmPSqlFqokvaye3RDo5e-TAkTavBwWg1H2x_1jOW3z2O2q5AqkVsvLdjHtB7nJNqKZMr6X90XSh1A19nIqz71M0RtM");'>
                                    </div>
                                    <div
                                        class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
                                        <button onclick="window.location.href='/marketplace'"
                                            class="w-full py-2 bg-primary text-background-dark font-bold rounded-md text-xs font-mono-header">Quick
                                            View</button>
                                    </div>
                                </div>
                                <h3 class="text-white font-medium font-mono-header text-sm">Mithila Ceramic Bowl</h3>
                                <p class="text-primary font-bold text-lg">$65.00</p>
                            </div>
                            <!-- Artwork 4 -->
                            <div class="group">
                                <div
                                    class="relative overflow-hidden rounded-sm border border-white/10 aspect-square mb-3">
                                    <div class="w-full h-full bg-center bg-cover transition-transform duration-500 group-hover:scale-110"
                                        data-alt="Intricately carved wooden window frame from Kathmandu valley"
                                        style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBjG-_Pd2DCwcrTWnjyJFdehILlgv5VREefs8gfNl4br0a2qiHKx-VN0_TJRcS3vdlc4ONUQS2We3Yrn77ljpn1X9GGctAXMewtMdGCzrt2MnXigLB_qGmF8CR_MQRSPYNgT9rfMpA6DLQhx9FBw6UzXci0yDIqXCWktNSRSVxyP8NUAX-qDFd3wwlzv2qT59RTBBWU4xameVx0QZtxyTVs3Mir2afUxmfX1KRDw1-2Wf3NX0Kln_SiT6KbU_z-gnin7vABVIobXYg");'>
                                    </div>
                                    <div
                                        class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
                                        <button onclick="window.location.href='/marketplace'"
                                            class="w-full py-2 bg-primary text-background-dark font-bold rounded-md text-xs font-mono-header">Quick
                                            View</button>
                                    </div>
                                </div>
                                <h3 class="text-white font-medium font-mono-header text-sm">Mini Carved Window</h3>
                                <p class="text-primary font-bold text-lg">$120.00</p>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
            <!-- Footer -->
            <%- include('partials/footer') %>
    </div>
</body>

</html>