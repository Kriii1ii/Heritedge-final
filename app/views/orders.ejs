<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <%- include('partials/head') %>
</head>

<body class="bg-background-light dark:bg-background-dark min-h-screen">
    <div class="layout-container flex h-full grow flex-col">
        <%- include('partials/header') %>
            <main class="flex flex-1 justify-center py-12 px-4 md:px-10">
                <div class="layout-content-container flex flex-col max-w-[1200px] flex-1">
                    <div class="flex items-center justify-between pb-6 border-b border-white/10 mb-8">
                        <h2
                            class="text-white text-4xl font-black leading-tight font-mono-header bg-gradient-to-r from-jade-green to-emerald-400 bg-clip-text text-transparent">
                            Order History</h2>
                    </div>

                    <% if (orders && orders.length> 0) { %>
                        <div class="flex flex-col gap-6">
                            <% orders.forEach(order=> { %>
                                <div
                                    class="flex flex-col md:flex-row bg-white/5 border border-white/10 rounded-sm overflow-hidden shadow-lg p-6 gap-6 relative">
                                    <!-- Order Header Absolute -->
                                    <span class="absolute top-6 right-6 font-mono text-xs text-white/40">ID: <%=
                                            order.id.slice(0, 8) %></span>

                                    <!-- Image -->
                                    <div
                                        class="w-full md:w-32 h-32 rounded-sm overflow-hidden shrink-0 border border-white/20 bg-black">
                                        <img src="<%= order.artwork && order.artwork.images[0] ? order.artwork.images[0] : '/images/placeholder.jpg' %>"
                                            class="w-full h-full object-cover">
                                    </div>

                                    <!-- Details -->
                                    <div class="flex flex-col flex-1">
                                        <div class="flex flex-wrap items-center gap-3 mb-2">
                                            <h3 class="text-white text-xl font-bold font-mono">
                                                <%= order.artwork ? order.artwork.title : 'Unavailable' %>
                                            </h3>
                                            <span
                                                class="px-2 py-0.5 rounded bg-jade-green/20 text-jade-green border border-jade-green/30 text-[10px] font-bold uppercase tracking-wider block">
                                                <%= order.orderStatus %>
                                            </span>
                                        </div>

                                        <p class="text-white/60 text-sm mb-4"><span class="text-white/40">Artist:</span>
                                            <%= order.artwork && order.artwork.creator ? order.artwork.creator.name
                                                : 'Unknown' %>
                                        </p>

                                        <div class="flex items-center justify-between mt-auto">
                                            <p class="text-amber-yellow text-2xl font-black font-mono">रू <%=
                                                    order.amount %>
                                            </p>
                                            <p class="text-white/40 text-xs">Placed on <%= new
                                                    Date(order.createdAt).toLocaleDateString() %>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <% }); %>
                        </div>
                        <% } else { %>
                            <div
                                class="flex flex-col items-center justify-center p-12 bg-white/5 border border-white/10 rounded-sm text-center">
                                <span
                                    class="material-symbols-outlined text-4xl text-white/20 mb-4 block">receipt_long</span>
                                <p class="text-white/60 text-lg mb-6 max-w-md">You haven't purchased any artworks yet.
                                </p>
                                <a href="/marketplace"
                                    class="bg-amber-yellow text-background-dark hover:bg-white font-bold font-mono uppercase tracking-[0.1em] text-sm py-3 px-8 rounded transition-colors shadow">Browse
                                    Marketplace</a>
                            </div>
                            <% } %>
                </div>
            </main>
                <%- include('partials/footer') %>
</div>
</body>

</html>